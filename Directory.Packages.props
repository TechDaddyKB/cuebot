<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <AvaloniaVersion>12.1.4</AvaloniaVersion>
  </PropertyGroup>
  <ItemGroup>
    <!-- Assistant: the official Anthropic SDK (MIT) for the Anthropic API-key provider. -->
    <PackageVersion Include="Anthropic" Version="13.3.0" />
    <!-- UI -->
    <PackageVersion Include="Avalonia" Version="$(AvaloniaVersion)" />
    <PackageVersion Include="Avalonia.Desktop" Version="$(AvaloniaVersion)" />
    <PackageVersion Include="Avalonia.Themes.Fluent" Version="$(AvaloniaVersion)" />
    <PackageVersion Include="Avalonia.Fonts.Inter" Version="$(AvaloniaVersion)" />
    <PackageVersion Include="Avalonia.Skia" Version="$(AvaloniaVersion)" />
    <PackageVersion Include="Avalonia.Headless.XUnit" Version="$(AvaloniaVersion)" />
    <PackageVersion Include="Avalonia.HarfBuzz" Version="$(AvaloniaVersion)" />
    <PackageVersion Include="Avalonia.Wayland" Version="$(AvaloniaVersion)" />
    <PackageVersion Include="Avalonia.AvaloniaEdit" Version="12.0.0" />
    <PackageVersion Include="AvaloniaEdit.TextMate" Version="12.0.0" />
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <!-- SkiaSharp (MIT) / Skia (BSD-3-Clause): the version Avalonia.Skia already ships, so the app carries one copy. Also
         renders Stream Deck key images for direct USB mode (src/Cuebot.StreamDeck/Hid); NativeAssets.Linux brings
         libSkiaSharp for Linux to projects that do not reference Avalonia (Windows/macOS natives come with SkiaSharp). -->
    <PackageVersion Include="SkiaSharp" Version="3.119.4" />
    <PackageVersion Include="SkiaSharp.NativeAssets.Linux" Version="3.119.4" />
    <!-- Infrastructure -->
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.14" />
    <!-- Scripting / speech -->
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Scripting" Version="5.9.0" />
    <!-- Newtonsoft.Json (MIT): Streamer.bot ships it, so pasted C# code that uses it compiles in Cuebot too. -->
    <PackageVersion Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageVersion Include="System.Security.Cryptography.ProtectedData" Version="10.0.14" />
    <PackageVersion Include="System.Speech" Version="10.0.14" />
    <!-- Audio: SoundFlow (MIT) wraps miniaudio (MIT or public domain/Unlicense) and ships its native libraries for
         win-x64/x86/arm64 and linux-x64/arm/arm64; NVorbis (MIT) decodes Ogg Vorbis in managed code. -->
    <PackageVersion Include="SoundFlow" Version="1.4.1" />
    <PackageVersion Include="NVorbis" Version="0.10.5" />
    <!-- Webhooks: BouncyCastle (MIT) verifies Throne's Ed25519 signatures (the .NET 10 BCL has no Ed25519 API). -->
    <PackageVersion Include="BouncyCastle.Cryptography" Version="2.6.2" />
    <!-- Game controllers: SDL3 (zlib) native libraries for win-x64/x86/arm64 and linux-x64/x86/arm64/arm, built and
         published by ppy (osu!) under MIT; only the native assets are used (see src/Cuebot.Controllers/PROTOCOL.md). -->
    <PackageVersion Include="ppy.SDL3-CS" Version="2026.1002.1" />
    <!-- Voice control: Whisper.net (MIT) wraps whisper.cpp (MIT); the CPU runtime ships win-x64/x86/arm64 and
         linux-x64/arm/arm64 natives (AVX2 build, with the NoAvx build as automatic fallback). Models are downloaded
         on first use, never bundled. Microsoft.Extensions.AI.Abstractions (MIT) comes in transitively. -->
    <PackageVersion Include="Whisper.net" Version="1.9.1" />
    <PackageVersion Include="Whisper.net.Runtime" Version="1.9.1" />
    <PackageVersion Include="Whisper.net.Runtime.NoAvx" Version="1.9.1" />
    <!-- Tests -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.v3" Version="3.2.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>
</Project>
# Cuebot live-test settings. Copy to ~/.cuebot/live.env (outside the repository) and fill in what you
# want tested; anything left empty is skipped. Never commit the real file. See docs/LIVE_TESTING.md.
# build/run-live-tests.ps1 / .sh load this file and run every opt-in suite.

# ---------------------------------------------------------------------------
# Twitch API: chat, commands and EventSub events
# ---------------------------------------------------------------------------
# Client ID of a Twitch app registered at dev.twitch.tv/console as a *Public* client (no secret needed).
CUEBOT_LIVE_TWITCH_CLIENT_ID=

# ---------------------------------------------------------------------------
# Rumble: Live Stream API (channel info, followers, stream online/offline, chat)
# ---------------------------------------------------------------------------
# Your private Live Stream API URL including its key: rumble.com -> Account (avatar) -> Live Stream API ->
# create a key and copy the URL (https://rumble.com/-livestream-api/get-data?key=...). Treat it like a password.
CUEBOT_LIVE_RUMBLE_API_URL=

# ---------------------------------------------------------------------------
# YouTube Data API: sign-in, broadcast monitoring, live chat
# ---------------------------------------------------------------------------
# OAuth client of type "TVs and Limited Input devices" from your own Google Cloud project (YouTube Data API v3
# enabled; see src/Cuebot.YouTube/YOUTUBE.md). The first run asks you to approve a device code once.
CUEBOT_LIVE_YOUTUBE_CLIENT_ID=
CUEBOT_LIVE_YOUTUBE_CLIENT_SECRET=
# Set to 1 to also run the chat round trip (posts a "dev testing" message; needs a live broadcast).
CUEBOT_LIVE_YOUTUBE_CHAT=0

# ---------------------------------------------------------------------------
# Kick API: sign-in, channel info, chat send + real-time chat (your own Kick app)
# ---------------------------------------------------------------------------
# Create an app at kick.com -> Settings -> Developer with redirect URL http://localhost:47582/callback (or the
# port below) and copy its Client ID and Client Secret. The first run opens the browser once to sign in.
CUEBOT_LIVE_KICK_CLIENT_ID=
CUEBOT_LIVE_KICK_CLIENT_SECRET=
# CUEBOT_LIVE_KICK_REDIRECT_PORT=47582
# Only if kick.com blocks the automatic lookup: "id" and "chatroom"."id" from kick.com/api/v2/channels/YOURNAME
# CUEBOT_LIVE_KICK_CHANNEL_ID=
# CUEBOT_LIVE_KICK_CHATROOM_ID=

# ---------------------------------------------------------------------------
# OBS Studio websocket (OBS: Tools -> WebSocket Server Settings)
# ---------------------------------------------------------------------------
CUEBOT_OBS_HOST=127.0.0.1
CUEBOT_OBS_PORT=4455
CUEBOT_OBS_PASSWORD=

# ---------------------------------------------------------------------------
# Going live (public!). Nothing streams unless CUEBOT_LIVE_STREAM=1 and a scene is named.
# ---------------------------------------------------------------------------
CUEBOT_LIVE_STREAM=0
# OBS scene shown while live, e.g. a "dev testing" card. The stream title is whatever the platform has set.
CUEBOT_LIVE_OBS_SCENE=Cuebot Dev Testing
# Seconds each test stream stays live (minimum 20).
CUEBOT_LIVE_STREAM_SECONDS=60

# Stream targets: leave a key empty to skip that platform. Keys are only ever handed to OBS.
CUEBOT_LIVE_TWITCH_STREAM_KEY=
# CUEBOT_LIVE_TWITCH_RTMP_URL=rtmp://live.twitch.tv/app
# YouTube: use a reusable stream key (Studio -> Go live -> Stream -> "Stream key"), not OBS "Connect Account".
CUEBOT_LIVE_YOUTUBE_STREAM_KEY=
# CUEBOT_LIVE_YOUTUBE_RTMP_URL=rtmps://a.rtmps.youtube.com:443/live2
# Kick: both values from dashboard.kick.com -> Stream URL & Key.
CUEBOT_LIVE_KICK_RTMP_URL=
CUEBOT_LIVE_KICK_STREAM_KEY=
# Rumble: both values from rumble.com -> Go Live (camera icon) -> the stream setup page ("Stream URL" and
# "Stream key"). Set up the stream there first (title "dev testing", visibility as you like).
CUEBOT_LIVE_RUMBLE_RTMP_URL=
CUEBOT_LIVE_RUMBLE_STREAM_KEY=

# ---------------------------------------------------------------------------
# Scripting: real CPython for the "Execute Python code" tests
# ---------------------------------------------------------------------------
# Full path to a python executable (3.10+). Leave empty to skip those tests.
CUEBOT_TEST_PYTHON=

# ---------------------------------------------------------------------------
# Housekeeping
# ---------------------------------------------------------------------------
# Where the live tests keep their Twitch sign-in between runs (approve the device once).
# Delete this folder and disconnect the app on twitch.tv/settings/connections to revoke it.
# CUEBOT_LIVE_DATA=

# ---------------------------------------------------------------------------
# Optional services. Leave any empty to skip it.
# ---------------------------------------------------------------------------
# Streamlabs: streamlabs.com -> Settings -> API Settings -> API Tokens -> "Your Socket API Token".
CUEBOT_LIVE_STREAMLABS_SOCKET_TOKEN=
# StreamElements: streamelements.com -> profile -> Account -> Channels -> "Show secrets" -> JWT Token.
CUEBOT_LIVE_STREAMELEMENTS_JWT=
# VTube Studio: running, with Settings -> "Start API" on. The first run asks you to allow the plugin in VTS.
CUEBOT_LIVE_VTS=0
# CUEBOT_LIVE_VTS_PORT=8001
# Voicemod: running, with a Control API key from the Voicemod developer portal.
CUEBOT_LIVE_VOICEMOD_API_KEY=
# Pulsoid: pulsoid.net -> Account -> Tokens -> create a token with data:heart_rate:read.
CUEBOT_LIVE_PULSOID_TOKEN=
# HypeRate: an API key from hyperate.io (developer access) and your device/session ID shown in the HypeRate app.
CUEBOT_LIVE_HYPERATE_API_KEY=
CUEBOT_LIVE_HYPERATE_DEVICE_ID=

{
  "timer": { "type": "text", "label": "Timer name (empty: the first timer)", "value": "", "group": "What it shows" },
  "title": { "type": "text", "label": "Title (empty: none)", "value": "Subathon", "group": "What it shows" },
  "pausedText": { "type": "text", "label": "When paused", "value": "Paused", "group": "What it shows" },
  "stoppedText": { "type": "text", "label": "Before it starts", "value": "Starting soon", "group": "What it shows" },
  "endedText": { "type": "text", "label": "When time is up", "value": "Time's up!", "group": "What it shows" },
  "showAdded": { "type": "checkbox", "label": "Show added time (+5:00)", "value": true, "group": "What it shows" },
  "showDays": { "type": "checkbox", "label": "Show days when over 24 hours (1d 02:03:04)", "value": false, "group": "What it shows" },

  "fontFamily": { "type": "googleFont", "label": "Font", "value": "Inter", "group": "Look" },
  "titleSize": { "type": "slider", "label": "Title size", "value": 32, "min": 10, "max": 120, "step": 1, "group": "Look" },
  "timeSize": { "type": "slider", "label": "Time size", "value": 96, "min": 16, "max": 300, "step": 1, "group": "Look" },
  "textColor": { "type": "colorpicker", "label": "Title colour", "value": "#ffffff", "group": "Look" },
  "timeColor": { "type": "colorpicker", "label": "Time colour", "value": "#ffcc33", "group": "Look" },
  "addedColor": { "type": "colorpicker", "label": "Added time colour", "value": "#5cff8a", "group": "Look" },
  "align": { "type": "dropdown", "label": "Align", "value": "center", "group": "Look",
    "options": { "left": "Left", "center": "Centre", "right": "Right" } },
  "shadow": { "type": "checkbox", "label": "Text shadow", "value": true, "group": "Look" }
}

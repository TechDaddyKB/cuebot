<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Required by the LibraryImport source generator for the winmm PlaySound binding. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Cuebot.Core\Cuebot.Core.csproj" />
    <!-- The voice engine installs the same pinned Python the scripting engine uses (PinnedPython, PythonInstaller). -->
    <ProjectReference Include="..\Cuebot.Scripting\Cuebot.Scripting.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Cuebot.Speech.Tests" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="System.Speech" />
    <PackageReference Include="SoundFlow" />
    <PackageReference Include="NVorbis" />
    <PackageReference Include="SharpZipLib" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Voices\cuebot_voice_host.py" LogicalName="Cuebot.Speech.cuebot_voice_host.py" />
  </ItemGroup>
</Project>

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Cuebot.App.ViewModels"
             xmlns:vmc="using:Cuebot.App.ViewModels.Chat"
             xmlns:chat="using:Cuebot.App.Views.Chat"
             xmlns:c="using:Cuebot.App.Controls"
             x:Class="Cuebot.App.Views.ChatView"
             x:DataType="vm:ChatViewModel">
  <UserControl.Resources>
    <!-- The activity feed: its own column on wide pages, a tab of the side pane on narrow ones. -->
    <DataTemplate x:Key="ActivityPane" x:DataType="vm:ChatViewModel">
      <DockPanel>
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
          <Button DockPanel.Dock="Right" Content="Clear" Command="{Binding ClearFeedCommand}" Padding="8,3" ToolTip.Tip="Empties this list of recent events. It does not delete anything on your channel." />
          <TextBlock Text="Activity" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center" />
        </DockPanel>
        <ListBox DockPanel.Dock="Top" Classes="chips" ItemContainerTheme="{StaticResource ChipItem}"
                 ItemsSource="{Binding FeedFilters}" SelectedItem="{Binding FeedFilter}" Margin="0,0,0,4"
                 ToolTip.Tip="Show only one kind of event in this list." />
        <Panel>
          <ListBox ItemsSource="{Binding VisibleFeed}" Background="Transparent">
            <ListBox.ItemTemplate>
              <DataTemplate DataType="vm:FeedLineViewModel">
                <Grid ColumnDefinitions="Auto,*">
                  <Border Width="4" CornerRadius="2" Background="{Binding PlatformBrush}" Margin="0,0,10,0" />
                  <StackPanel Grid.Column="1">
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" IsVisible="{Binding HasDetail}" />
                    <TextBlock Classes="muted" FontSize="12">
                      <Run Text="{Binding Platform}" /><Run Text=" · " /><Run Text="{Binding Kind}" /><Run Text=" · " /><Run Text="{Binding Time}" />
                    </TextBlock>
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <TextBlock Classes="muted" TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center" Margin="12"
                     IsVisible="{Binding !HasVisibleFeed}" Text="Follows, subs, tips, raids and redemptions show up here." />
        </Panel>
      </DockPanel>
    </DataTemplate>
  </UserControl.Resources>

  <Grid x:Name="Panes" ColumnDefinitions="*,12,300,12,300" Margin="16,12,16,16">
    <!-- ===== Chat ===== -->
    <Border Classes="card" Margin="0" Padding="12">
      <DockPanel>
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
          <ToggleButton x:Name="OptionsToggle" DockPanel.Dock="Right" IsChecked="{Binding ShowOptions}" Padding="8,5"
                        ToolTip.Tip="Chat options: emotes, pronouns, highlights, quick actions" AutomationProperties.Name="Chat options">
            <StackPanel Orientation="Horizontal" Spacing="5">
              <c:Icon Kind="settings" Width="14" Height="14" />
              <TextBlock Text="Options" />
            </StackPanel>
          </ToggleButton>
          <TextBlock Text="Chat" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center" />
        </DockPanel>
        <ListBox x:Name="PlatformChips" DockPanel.Dock="Top" Classes="chips" ItemContainerTheme="{StaticResource ChipItem}"
                 ItemsSource="{Binding PlatformChips}" SelectedItem="{Binding Filter}" Margin="0,0,0,4"
                 ToolTip.Tip="Show the chat of one platform only, or everything together." />

        <StackPanel DockPanel.Dock="Bottom" Spacing="4" Margin="0,8,0,0">
          <!-- Quick actions (global ones work without a selection) -->
          <ItemsControl x:Name="QuickActionBar" ItemsSource="{Binding QuickActions}" IsVisible="{Binding HasQuickActions}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="vm:QuickActionButtonViewModel">
                <Button Content="{Binding Label}" Command="{Binding RunCommand}" IsEnabled="{Binding CanRun}"
                        ToolTip.Tip="{Binding ToolTip}" Margin="0,0,6,4" Padding="10,3" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <!-- Emote autocomplete (opens while typing ":name") -->
          <Border x:Name="SuggestionPanel" Classes="card" Padding="4" Margin="0" IsVisible="{Binding IsSuggesting}" MaxHeight="220">
            <ListBox x:Name="SuggestionList" ItemsSource="{Binding Suggestions}" SelectedItem="{Binding SelectedSuggestion}"
                     Background="Transparent" Tapped="OnSuggestionTapped">
              <ListBox.ItemTemplate>
                <DataTemplate DataType="vm:EmoteSuggestionViewModel">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <Panel Width="28" Height="28">
                      <Image Source="{Binding Image}" IsVisible="{Binding HasImage}" Stretch="Uniform" />
                    </Panel>
                    <TextBlock Text="{Binding Code}" VerticalAlignment="Center" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Provider}" VerticalAlignment="Center" Classes="muted" />
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Border>

          <Grid ColumnDefinitions="Auto,8,*,8,Auto">
            <ComboBox ItemsSource="{Binding SendTargets}" SelectedItem="{Binding SendTarget}" MinWidth="110" ToolTip.Tip="Where your message goes: one platform or all connected ones." />
            <TextBox x:Name="DraftBox" Grid.Column="2" Text="{Binding Draft}" PlaceholderText="Message (type : for emotes, /help for commands)"
                     ToolTip.Tip="Write a message to post in your chat as yourself. Press Enter to send." />
            <Button Grid.Column="4" Content="Send" Classes="accent" Command="{Binding SendCommand}" ToolTip.Tip="Posts your message to the chosen chat." />
          </Grid>
          <TextBlock x:Name="StatusText" Text="{Binding Status}" Classes="muted" TextWrapping="Wrap"
                     IsVisible="{Binding Status, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        </StackPanel>

        <ListBox x:Name="ChatList" ItemsSource="{Binding Messages}" SelectedItem="{Binding SelectedLine}" Background="Transparent"
                 ContextRequested="OnChatContextRequested">
          <ListBox.ItemTemplate>
            <DataTemplate DataType="vm:ChatLineViewModel">
              <Border Background="{Binding HighlightBrush}" CornerRadius="4" Padding="4,1" ToolTip.Tip="{Binding HighlightReason}">
                <Grid ColumnDefinitions="Auto,Auto,*">
                  <Border Background="{Binding PlatformBrush}" CornerRadius="3" Padding="5,0" Margin="0,2,8,0" VerticalAlignment="Top"
                          ToolTip.Tip="{Binding Platform}">
                    <TextBlock Text="{Binding Platform}" FontSize="10" FontWeight="Bold" Foreground="#111" />
                  </Border>
                  <TextBlock Grid.Column="1" Text="{Binding Time}" Classes="muted" Margin="0,2,8,0" VerticalAlignment="Top" />
                  <chat:ChatMessageText Grid.Column="2" Line="{Binding}" />
                </Grid>
              </Border>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Border>

    <!-- ===== Activity (own column when wide) ===== -->
    <Border x:Name="ActivityPane" Grid.Column="2" Classes="card" Margin="0" Padding="12">
      <ContentControl Content="{Binding}" ContentTemplate="{StaticResource ActivityPane}" />
    </Border>

    <!-- ===== Chatter details, or the chat options ===== -->
    <Border Grid.Column="4" Classes="card" Margin="0" Padding="12" IsVisible="{Binding !ShowOptions}">
      <TabControl x:Name="SideTabs" SelectedIndex="1">
        <TabItem x:Name="ActivityTab" Header="Activity" IsVisible="False">
          <ContentControl Content="{Binding}" ContentTemplate="{StaticResource ActivityPane}" />
        </TabItem>
        <TabItem Header="Chatter">
          <Panel>
            <TextBlock Classes="muted" TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center" Margin="12"
                       IsVisible="{Binding !HasSelectedLine}"
                       Text="Select a message to see who wrote it, moderate them and run quick actions." />
            <ScrollViewer x:Name="ChatterDetails" IsVisible="{Binding HasSelectedLine}">
              <StackPanel Spacing="12" Margin="0,4,6,0">
                <!-- Profile -->
                <ContentControl Content="{Binding SelectedLine}">
                  <ContentControl.ContentTemplate>
                    <DataTemplate DataType="vm:ChatLineViewModel">
                      <StackPanel Spacing="8">
                        <Grid ColumnDefinitions="Auto,*">
                          <Border Width="40" Height="40" CornerRadius="20" Background="{Binding PlatformBrush}" Margin="0,0,10,0">
                            <TextBlock Text="{Binding Platform, Converter={x:Static c:PlatformBrush.Initial}}" FontWeight="Bold"
                                       Foreground="#111" HorizontalAlignment="Center" VerticalAlignment="Center" />
                          </Border>
                          <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding User}" FontWeight="Bold" FontSize="16" TextTrimming="CharacterEllipsis" />
                            <TextBlock Classes="muted" FontSize="12" TextTrimming="CharacterEllipsis">
                              <Run Text="{Binding Platform}" /><Run Text=" · " /><Run Text="{Binding Login}" />
                            </TextBlock>
                          </StackPanel>
                        </Grid>
                        <WrapPanel ItemSpacing="6" LineSpacing="4">
                          <TextBlock Text="{Binding Badges}" Classes="muted" FontSize="12"
                                     IsVisible="{Binding Badges, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                          <TextBlock Text="{Binding Pronouns}" Classes="muted" FontSize="12" IsVisible="{Binding HasPronouns}" />
                        </WrapPanel>
                      </StackPanel>
                    </DataTemplate>
                  </ContentControl.ContentTemplate>
                </ContentControl>

                <!-- Moderation -->
                <StackPanel Spacing="6">
                  <TextBlock Classes="label" Text="MODERATION" />
                  <WrapPanel ItemSpacing="6" LineSpacing="6">
                    <Button Content="Reply" Command="{Binding ReplyToSelectedCommand}" ToolTip.Tip="Start a reply in the send box" />
                    <Button Content="Delete message" Command="{Binding DeleteSelectedCommand}" IsVisible="{Binding CanDeleteSelected}" ToolTip.Tip="Removes this one message from the chat for everyone." />
                    <Button Content="Timeout 1 min" Command="{Binding TimeoutSelectedCommand}" CommandParameter="1" IsVisible="{Binding CanTimeoutSelected}" ToolTip.Tip="Stops this person from writing in chat for 1 minute." />
                    <Button Content="Timeout 10 min" Command="{Binding TimeoutSelectedCommand}" CommandParameter="10" IsVisible="{Binding CanTimeoutSelected}" ToolTip.Tip="Stops this person from writing in chat for 10 minutes." />
                    <Button Command="{Binding BanSelectedCommand}" IsVisible="{Binding CanBanSelected}"
                            ToolTip.Tip="Bans this person from your channel. Click once, then click again to confirm."
                            Classes.danger="{Binding ConfirmingBan}">
                      <Panel>
                        <TextBlock Text="Ban…" IsVisible="{Binding !ConfirmingBan}" />
                        <TextBlock Text="Confirm ban" IsVisible="{Binding ConfirmingBan}" />
                      </Panel>
                    </Button>
                  </WrapPanel>
                  <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap"
                             IsVisible="{Binding ModerationHint, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" Text="{Binding ModerationHint}" />
                </StackPanel>

                <!-- Recent messages -->
                <StackPanel Spacing="4">
                  <TextBlock Classes="label" Text="RECENT MESSAGES" />
                  <ItemsControl x:Name="UserLines" ItemsSource="{Binding UserLines}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate DataType="vm:ChatLineViewModel">
                        <Grid ColumnDefinitions="Auto,*" Margin="0,2">
                          <TextBlock Text="{Binding Time}" Classes="muted" FontSize="12" Margin="0,0,8,0" VerticalAlignment="Top" />
                          <TextBlock Grid.Column="1" Text="{Binding Text}" TextWrapping="Wrap" FontSize="12.5" />
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </StackPanel>
            </ScrollViewer>
          </Panel>
        </TabItem>
      </TabControl>
    </Border>

    <!-- Options -->
    <Border x:Name="OptionsPanel" Grid.Column="4" Classes="card" Margin="0" Padding="12" IsVisible="{Binding ShowOptions}">
      <DockPanel>
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
          <Button DockPanel.Dock="Right" Content="Close" Command="{Binding ToggleOptionsCommand}" />
          <TextBlock Text="Chat options" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center" />
        </DockPanel>
        <ScrollViewer DataContext="{Binding Options}" x:DataType="vmc:ChatOptionsViewModel">
          <StackPanel Spacing="6" Margin="0,0,8,0">
            <TextBlock Text="Display" FontWeight="SemiBold" />
            <CheckBox x:Name="ShowEmotesBox" Content="Show emotes as images" IsChecked="{Binding ShowEmotes}" ToolTip.Tip="Ticked: emotes appear as little pictures. Unticked: you see just their names as text." />
            <CheckBox Content="Show pronouns (Twitch, alejo.io)" IsChecked="{Binding ShowPronouns}" ToolTip.Tip="Shows he/she/they next to a chatter when they have set it on alejo.io (a pronoun website)." />

            <TextBlock Text="Highlights" FontWeight="SemiBold" Margin="0,8,0,0" />
            <CheckBox Content="Mentions of these names" IsChecked="{Binding HighlightMentions}" ToolTip.Tip="Colours a message when someone writes one of your names, so you do not miss it." />
            <TextBox Text="{Binding MentionNames}" PlaceholderText="Your names, comma separated" ToolTip.Tip="The names people call you, separated by commas, like: kris, krisbot" />
            <TextBlock Text="Keywords" Classes="muted" />
            <TextBox Text="{Binding Keywords}" PlaceholderText="Words or phrases, comma separated" ToolTip.Tip="Messages containing any of these words get a colour too. Separate them with commas." />
            <CheckBox Content="First-time chatters (when the platform flags them)" IsChecked="{Binding HighlightFirstTime}" ToolTip.Tip="Colours the first message a person ever writes in your chat, so you can say hello." />

            <DockPanel Margin="0,8,0,0">
              <Button DockPanel.Dock="Right" Content="Add" Command="{Binding AddQuickActionCommand}" ToolTip.Tip="Adds a new quick action button." />
              <TextBlock Text="Quick actions" FontWeight="SemiBold" VerticalAlignment="Center" />
            </DockPanel>
            <TextBlock Classes="muted" TextWrapping="Wrap"
                       Text="Buttons under the chat that run one of your actions for the message you selected. The action can use the message and the person's details as variables. They are also in each message's right-click menu." />
            <ItemsControl ItemsSource="{Binding QuickActions}">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="vmc:QuickActionEditViewModel">
                  <Grid ColumnDefinitions="*,6,*,6,Auto,6,Auto" Margin="0,0,0,4">
                    <TextBox Text="{Binding Label}" PlaceholderText="Label" ToolTip.Tip="The words on the button." />
                    <ComboBox Grid.Column="2" ItemsSource="{Binding ActionNames}" SelectedItem="{Binding ActionName}"
                              PlaceholderText="Action" HorizontalAlignment="Stretch" ToolTip.Tip="The action that runs when you press the button." />
                    <ComboBox Grid.Column="4" ItemsSource="{Binding Scopes}" SelectedItem="{Binding Scope}" MinWidth="96"
                              ToolTip.Tip="When the button can be used: needs a selected message, needs only a selected person, or always." />
                    <Button Grid.Column="6" Content="Remove" Command="{Binding RemoveCommand}" ToolTip.Tip="Deletes this quick action button." />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <DockPanel Margin="0,8,0,0">
              <Button DockPanel.Dock="Right" Content="Refresh emotes" Command="{Binding RefreshEmotesCommand}" IsEnabled="{Binding HasEmoteService}" ToolTip.Tip="Downloads the emote lists again, for example after you added new emotes." />
              <TextBlock Text="Emotes" FontWeight="SemiBold" VerticalAlignment="Center" />
            </DockPanel>
            <WrapPanel>
              <CheckBox Content="7TV" IsChecked="{Binding SevenTv}" Margin="0,0,12,0" ToolTip.Tip="Also show emotes from 7TV, a website with extra emotes." />
              <CheckBox Content="BTTV" IsChecked="{Binding Bttv}" Margin="0,0,12,0" ToolTip.Tip="Also show emotes from BetterTTV, a website with extra emotes." />
              <CheckBox Content="FFZ" IsChecked="{Binding Ffz}" ToolTip.Tip="Also show emotes from FrankerFaceZ, a website with extra emotes." />
            </WrapPanel>
            <TextBlock Classes="muted" TextWrapping="Wrap"
                       Text="A channel id lets Cuebot load the emotes made for your channel. Leave these empty when your platform already tells Cuebot your channel." />
            <Grid ColumnDefinitions="Auto,8,*" RowDefinitions="Auto,4,Auto,4,Auto">
              <TextBlock Text="Twitch user id" VerticalAlignment="Center" />
              <TextBox Grid.Column="2" Text="{Binding TwitchChannelId}" ToolTip.Tip="The number that identifies your Twitch channel. Leave it empty if Cuebot already knows it." />
              <TextBlock Grid.Row="2" Text="YouTube channel id" VerticalAlignment="Center" />
              <TextBox Grid.Row="2" Grid.Column="2" Text="{Binding YouTubeChannelId}" ToolTip.Tip="The code that identifies your YouTube channel. Leave it empty if Cuebot already knows it." />
              <TextBlock Grid.Row="4" Text="Kick user id" VerticalAlignment="Center" />
              <TextBox Grid.Row="4" Grid.Column="2" Text="{Binding KickChannelId}" ToolTip.Tip="The number that identifies your Kick channel. Leave it empty if Cuebot already knows it." />
            </Grid>
            <TextBlock x:Name="EmoteStatusText" Text="{Binding EmoteStatus}" Classes="muted" TextWrapping="Wrap" />
          </StackPanel>
        </ScrollViewer>
      </DockPanel>
    </Border>
  </Grid>
</UserControl>

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Cuebot.App.ViewModels"
             xmlns:sv="using:Cuebot.App.Views.Speech"
             x:Class="Cuebot.App.Views.SpeechView"
             x:DataType="vm:SpeechViewModel">
  <!-- Styles shared by every Speech tab (they cascade into the tab views). -->
  <UserControl.Styles>
    <!-- The section list picks the sub-page (Speech › Engines…); the tab strip itself stays hidden. -->
    <Style Selector="TabControl#Tabs /template/ ItemsPresenter#PART_ItemsPresenter">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="TextBlock.label">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="0,0,0,3" />
    </Style>
    <Style Selector="TextBlock.hint">
      <Setter Property="Foreground" Value="{DynamicResource CuebotMuted}" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.mono">
      <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, DejaVu Sans Mono, monospace" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="Border.inset">
      <Setter Property="Background" Value="{DynamicResource CuebotPanel}" />
      <Setter Property="BorderBrush" Value="{DynamicResource CuebotCardBorder}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="10" />
    </Style>
    <Style Selector="Border.pill">
      <Setter Property="Background" Value="{DynamicResource CuebotSelected}" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="10,3" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="ListBox.list">
      <Setter Property="Background" Value="{DynamicResource CuebotPanel}" />
      <Setter Property="BorderBrush" Value="{DynamicResource CuebotCardBorder}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
    </Style>
    <Style Selector="ComboBox">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>
    <Style Selector="NumericUpDown">
      <Setter Property="FormatString" Value="0" />
    </Style>
  </UserControl.Styles>

  <DockPanel Margin="24,8,24,0">
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="12" Margin="0,0,0,4">
      <TextBlock x:Name="SubPageTitle" Text="{Binding SubPageTitle}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
      <Border Classes="pill">
        <TextBlock x:Name="Status" Text="{Binding StatusText}" FontSize="12" />
      </Border>
    </StackPanel>
    <TabControl x:Name="Tabs" SelectedIndex="{Binding SelectedTab}">
      <TabItem Header="Overview">
        <sv:SpeechOverviewView DataContext="{Binding Overview}" />
      </TabItem>
      <TabItem Header="Engines">
        <sv:SpeechEnginesView DataContext="{Binding Engines}" />
      </TabItem>
      <TabItem Header="Voice aliases">
        <sv:SpeechAliasesView DataContext="{Binding Aliases}" />
      </TabItem>
      <TabItem Header="Users">
        <sv:SpeechUsersView DataContext="{Binding Users}" />
      </TabItem>
      <TabItem Header="Chat &amp; commands">
        <sv:SpeechChatView DataContext="{Binding Chat}" />
      </TabItem>
      <TabItem Header="Filters">
        <sv:SpeechFiltersView DataContext="{Binding Filters}" />
      </TabItem>
      <TabItem Header="Events">
        <sv:SpeechEventsView DataContext="{Binding Events}" />
      </TabItem>
      <TabItem Header="VoiceGate &amp; queue">
        <sv:SpeechGateView DataContext="{Binding Gate}" />
      </TabItem>
    </TabControl>
  </DockPanel>
</UserControl>

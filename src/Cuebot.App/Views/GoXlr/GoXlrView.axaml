<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Cuebot.App.ViewModels.GoXlr"
             x:Class="Cuebot.App.Views.GoXlr.GoXlrView"
             x:DataType="vm:GoXlrViewModel">
  <ScrollViewer Padding="24">
    <StackPanel MaxWidth="860" HorizontalAlignment="Left" Spacing="8">
      <TextBlock Classes="h1" Text="GoXLR" />
      <TextBlock Classes="muted" TextWrapping="Wrap"
                 Text="The GoXLR and GoXLR Mini become triggers, sub-actions and script functions through the open-source GoXLR Utility (Linux, Windows and macOS), which Cuebot reaches on its local WebSocket API (port 14564). TC-Helicon's own GoXLR App has no public API; use the GoXLR Utility in its place. Settings are stored in goxlr.json." />

      <Border Classes="card">
        <StackPanel Spacing="8">
          <TextBlock Classes="h2" Text="Connection" />
          <Grid ColumnDefinitions="Auto,240,Auto,140" RowDefinitions="Auto,Auto" RowSpacing="8">
            <TextBlock Text="Host" VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBox Grid.Column="1" Name="GoXlrHost" Text="{Binding Host}" PlaceholderText="localhost" />
            <TextBlock Grid.Column="2" Text="Port" VerticalAlignment="Center" Margin="12,0,8,0" />
            <NumericUpDown Grid.Column="3" Value="{Binding Port}" Minimum="1" Maximum="65535" FormatString="0" />
            <TextBlock Grid.Row="1" Text="Device serial" VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Serial}" PlaceholderText="first GoXLR" />
          </Grid>
          <TextBlock Classes="muted" TextWrapping="Wrap"
                     Text="Another PC: turn on &quot;Allow network access&quot; in the GoXLR Utility's settings and enter that PC's address." />
          <CheckBox Content="Connect automatically on startup" IsChecked="{Binding AutoConnect}" />
          <CheckBox Content="Keep trying while the GoXLR Utility is not running, and reconnect when it closes" IsChecked="{Binding AutoReconnect}" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="Connect" Classes="accent" Command="{Binding ConnectCommand}" />
            <Button Content="Disconnect" Command="{Binding DisconnectCommand}" />
            <Button Content="Test" Command="{Binding TestCommand}" IsEnabled="{Binding IsConnected}" />
          </StackPanel>
          <TextBlock Name="GoXlrStatus" TextWrapping="Wrap">
            <Run Text="{Binding State}" FontWeight="SemiBold" /><Run Text="  " /><Run Text="{Binding StatusMessage}" Foreground="{StaticResource CuebotMuted}" />
          </TextBlock>
          <TextBlock TextWrapping="Wrap">
            <Run Text="Detected: " FontWeight="SemiBold" /><Run Text="{Binding Detected}" />
          </TextBlock>
          <TextBlock Classes="muted" TextWrapping="Wrap" Text="{Binding Info}" />
          <TextBlock Classes="error" TextWrapping="Wrap" Text="{Binding Error}" />
        </StackPanel>
      </Border>

      <Border Classes="card">
        <StackPanel Spacing="8">
          <TextBlock Classes="h2" Text="Device" />
          <TextBlock Classes="muted" Text="Connect to show the GoXLR's faders, profiles and effects." IsVisible="{Binding HasNoDevice}" />
          <TextBlock Classes="muted" Text="{Binding DeviceSummary}" TextWrapping="Wrap" IsVisible="{Binding HasDevice}" />
          <ItemsControl Name="GoXlrFaders" ItemsSource="{Binding Faders}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:GoXlrFaderRowViewModel">
                <Grid ColumnDefinitions="80,140,*,44,Auto" Margin="0,2">
                  <TextBlock Text="{Binding Label}" VerticalAlignment="Center" FontWeight="SemiBold" />
                  <TextBlock Grid.Column="1" Text="{Binding ChannelName}" VerticalAlignment="Center" />
                  <Slider Grid.Column="2" Minimum="0" Maximum="100" Value="{Binding Volume}" />
                  <TextBlock Grid.Column="3" Text="{Binding Volume, StringFormat={}{0:0}}" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,8,0" />
                  <Button Grid.Column="4" Content="{Binding MuteLabel}" Command="{Binding ToggleMuteCommand}" MinWidth="72" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <Grid ColumnDefinitions="Auto,240,Auto" RowDefinitions="Auto,Auto" RowSpacing="8" IsVisible="{Binding HasDevice}" Margin="0,8,0,0">
            <TextBlock Text="Profile" VerticalAlignment="Center" Margin="0,0,8,0" />
            <ComboBox Grid.Column="1" ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}" HorizontalAlignment="Stretch" />
            <Button Grid.Column="2" Content="Load" Command="{Binding LoadProfileCommand}" Margin="8,0,0,0" />
            <TextBlock Grid.Row="1" Text="Mic profile" VerticalAlignment="Center" Margin="0,0,8,0" />
            <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding MicProfiles}" SelectedItem="{Binding SelectedMicProfile}" HorizontalAlignment="Stretch" />
            <Button Grid.Row="1" Grid.Column="2" Content="Load" Command="{Binding LoadMicProfileCommand}" Margin="8,0,0,0" />
          </Grid>

          <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding HasDevice}" Margin="0,8,0,0">
            <Button Content="{Binding CoughLabel}" Command="{Binding ToggleCoughCommand}" />
            <ItemsControl Name="GoXlrEffects" ItemsSource="{Binding Effects}" IsVisible="{Binding HasEffects}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Orientation="Horizontal" Spacing="8" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:GoXlrEffectRowViewModel">
                  <Button Content="{Binding Label}" Command="{Binding ToggleCommand}" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>

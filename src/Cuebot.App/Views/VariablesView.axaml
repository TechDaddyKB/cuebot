<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Cuebot.App.ViewModels"
             x:Class="Cuebot.App.Views.VariablesView"
             x:DataType="vm:VariablesViewModel"
             x:Name="Root">
  <UserControl.DataTemplates>
    <DataTemplate DataType="vm:VariableRow">
      <Grid ColumnDefinitions="200,*,80,150,Auto">
        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                   ToolTip.Tip="{Binding Name}" />
        <TextBlock Grid.Column="1" Text="{Binding Value}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                   ToolTip.Tip="{Binding Value}" Margin="0,0,8,0" />
        <TextBlock Grid.Column="2" Text="{Binding Type}" Classes="muted" VerticalAlignment="Center" />
        <TextBlock Grid.Column="3" Text="{Binding LastWrite}" Classes="muted" VerticalAlignment="Center" />
        <Button Grid.Column="4" Content="Delete" Padding="8,2"
                Click="OnDeleteRow" ToolTip.Tip="Deletes this variable." />
      </Grid>
    </DataTemplate>
  </UserControl.DataTemplates>

  <Grid>
    <DockPanel Margin="24,24,24,16">
      <StackPanel DockPanel.Dock="Top">
        <TextBlock Classes="h1" Text="Variables" />
        <TextBlock Classes="muted" TextWrapping="Wrap" Margin="0,0,0,12"
                   Text="Variables are named notes Cuebot remembers for you. Write ~name~ in any sub-action (a step inside an action) to use a global variable. User variables belong to one viewer and are read and changed by the user variable sub-actions. Persisted variables are kept when Cuebot restarts; temporary ones are forgotten when Cuebot closes." />

        <!-- Editor -->
        <Border Classes="card">
          <StackPanel Spacing="8">
            <Grid ColumnDefinitions="200,12,*,12,Auto,12,Auto,12,Auto,8,Auto">
              <TextBox Text="{Binding EditName}" PlaceholderText="Name" ToolTip.Tip="The name of the variable. Use this name in your actions, like ~score~." />
              <TextBox Grid.Column="2" Text="{Binding EditValue}" PlaceholderText="Value" ToolTip.Tip="What the variable holds, like a number or some text." />
              <CheckBox Grid.Column="4" Content="Persisted" IsChecked="{Binding EditPersisted}" ToolTip.Tip="Tick to keep this variable when Cuebot restarts. Untick to forget it when Cuebot closes." />
              <CheckBox Grid.Column="6" Content="Auto type" IsChecked="{Binding AutoType}"
                        ToolTip.Tip="Ticked: 5 is stored as a number and true as a yes/no value. Unticked: everything is kept as plain text." />
              <Button Grid.Column="8" Content="Set" Classes="accent" Command="{Binding SetCommand}" ToolTip.Tip="Saves the variable with this name and value. If the name already exists, its value is replaced." />
              <Button Grid.Column="10" Content="New" Command="{Binding NewCommand}" ToolTip.Tip="Empties the boxes so you can type a new variable. Nothing is deleted." />
            </Grid>
            <Grid ColumnDefinitions="120,12,*,12,*" IsVisible="{Binding IsUsersTab}">
              <AutoCompleteBox Text="{Binding EditPlatform}" ItemsSource="{Binding Platforms}" MinimumPrefixLength="0"
                               FilterMode="ContainsOrdinal" PlaceholderText="Platform" ToolTip.Tip="The platform the viewer chats on, like Twitch or YouTube." />
              <TextBox Grid.Column="2" Text="{Binding EditUserId}" PlaceholderText="User id" ToolTip.Tip="The platform's number for this viewer (not their name)." />
              <TextBox Grid.Column="4" Text="{Binding EditUserName}" PlaceholderText="User name (optional)" ToolTip.Tip="Optional. The viewer's name, only to make the list easier to read." />
            </Grid>
            <TextBlock Classes="muted" Text="{Binding Status}" IsVisible="{Binding Status, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          </StackPanel>
        </Border>
      </StackPanel>

      <TabControl x:Name="Tabs" SelectedIndex="{Binding SelectedTabIndex}">
        <TabControl.Styles>
          <Style Selector="ListBox">
            <Setter Property="Background" Value="Transparent" />
          </Style>
        </TabControl.Styles>
        <TabItem Header="Persisted">
          <DockPanel Margin="0,8,0,0">
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
              <Button DockPanel.Dock="Right" Content="Delete all…" Command="{Binding DeleteAllCommand}" ToolTip.Tip="Deletes every persisted variable. You are asked to confirm first." />
              <TextBlock Classes="muted" VerticalAlignment="Center" Text="{Binding Persisted.Count, StringFormat='{}{0} persisted variable(s)'}" />
            </DockPanel>
            <Grid DockPanel.Dock="Top" ColumnDefinitions="200,*,80,150,Auto" Margin="12,0,12,4">
              <TextBlock Classes="muted" Text="NAME" />
              <TextBlock Grid.Column="1" Classes="muted" Text="VALUE" />
              <TextBlock Grid.Column="2" Classes="muted" Text="TYPE" />
              <TextBlock Grid.Column="3" Classes="muted" Text="LAST WRITE" />
            </Grid>
            <ListBox ItemsSource="{Binding Persisted}" SelectedItem="{Binding SelectedPersisted}" />
          </DockPanel>
        </TabItem>
        <TabItem Header="Temporary">
          <DockPanel Margin="0,8,0,0">
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
              <Button DockPanel.Dock="Right" Content="Delete all…" Command="{Binding DeleteAllCommand}" ToolTip.Tip="Deletes every temporary variable. You are asked to confirm first." />
              <TextBlock Classes="muted" VerticalAlignment="Center" Text="{Binding Temporary.Count, StringFormat='{}{0} temporary variable(s)'}" />
            </DockPanel>
            <Grid DockPanel.Dock="Top" ColumnDefinitions="200,*,80,150,Auto" Margin="12,0,12,4">
              <TextBlock Classes="muted" Text="NAME" />
              <TextBlock Grid.Column="1" Classes="muted" Text="VALUE" />
              <TextBlock Grid.Column="2" Classes="muted" Text="TYPE" />
              <TextBlock Grid.Column="3" Classes="muted" Text="LAST WRITE" />
            </Grid>
            <ListBox ItemsSource="{Binding Temporary}" SelectedItem="{Binding SelectedTemporary}" />
          </DockPanel>
        </TabItem>
        <TabItem Header="Users">
          <DockPanel Margin="0,8,0,0">
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
                <Button Content="Delete for all users" Command="{Binding DeleteForAllUsersCommand}"
                        ToolTip.Tip="Deletes the variable you selected from every viewer on the chosen platform, not only the selected one." />
                <Button Content="Delete all…" Command="{Binding DeleteAllCommand}" ToolTip.Tip="Deletes every user variable. You are asked to confirm first." />
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="8">
                <ComboBox ItemsSource="{Binding Platforms}" SelectedItem="{Binding PlatformFilter}" MinWidth="140" ToolTip.Tip="Only show user variables from this platform." />
                <TextBlock Classes="muted" VerticalAlignment="Center" Text="{Binding UserVariables.Count, StringFormat='{}{0} user variable(s)'}" />
              </StackPanel>
            </DockPanel>
            <Grid DockPanel.Dock="Top" ColumnDefinitions="90,180,*" Margin="12,0,12,4">
              <TextBlock Classes="muted" Text="PLATFORM" />
              <TextBlock Grid.Column="1" Classes="muted" Text="USER" />
              <TextBlock Grid.Column="2" Classes="muted" Text="NAME · VALUE · TYPE · LAST WRITE" />
            </Grid>
            <ListBox ItemsSource="{Binding UserVariables}" SelectedItem="{Binding SelectedUserVariable}">
              <ListBox.ItemTemplate>
                <DataTemplate DataType="vm:VariableRow">
                  <Grid ColumnDefinitions="90,180,*">
                    <TextBlock Text="{Binding Platform}" Classes="muted" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding User}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <ContentControl Grid.Column="2" Content="{Binding}" />
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </DockPanel>
        </TabItem>
      </TabControl>
    </DockPanel>

    <!-- Delete all confirmation -->
    <Border IsVisible="{Binding IsConfirmingDeleteAll}" Background="{DynamicResource CuebotOverlay}">
      <Border Classes="card" Width="460" HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel Spacing="12">
          <TextBlock Classes="h2" Text="{Binding DeleteAllText}" TextWrapping="Wrap" />
          <TextBlock TextWrapping="Wrap" Text="This cannot be undone (backups on the Settings page include persisted variables)." />
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button Content="Cancel" Command="{Binding CancelDeleteAllCommand}" ToolTip.Tip="Keeps your variables. Nothing is deleted." />
            <Button Content="Delete all" Classes="accent" Command="{Binding ConfirmDeleteAllCommand}" ToolTip.Tip="Permanently deletes them now." />
          </StackPanel>
        </StackPanel>
      </Border>
    </Border>
  </Grid>
</UserControl>

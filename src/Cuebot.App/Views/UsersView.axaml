<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Cuebot.App.ViewModels"
             x:Class="Cuebot.App.Views.UsersView"
             x:DataType="vm:UsersViewModel"
             x:Name="Root">
  <DockPanel Margin="24,24,24,16">
    <TextBlock DockPanel.Dock="Top" Classes="h1" Text="Users &amp; Groups" />
    <TabControl x:Name="Sections">
      <TabItem Header="Users">
        <DockPanel Margin="0,8,0,0">
          <!-- Settings -->
          <Border DockPanel.Dock="Right" Classes="card" Width="320" Margin="12,0,0,0" VerticalAlignment="Top">
            <StackPanel Spacing="10">
              <TextBlock Classes="h2" Text="First words" />
              <TextBlock Classes="muted" TextWrapping="Wrap"
                         Text="The 'First words' trigger runs for a viewer's first chat message since Cuebot started, since the stream went live, or since you reset the list. Handy for a welcome message." />
              <CheckBox Content="Reset when a stream goes live" IsChecked="{Binding ResetFirstWordsOnStreamOnline}" ToolTip.Tip="Everyone counts as new again each time you go live, so each viewer can be welcomed once per stream." />
              <Button Content="Reset first words now" Command="{Binding ResetFirstWordsCommand}"
                      ToolTip.Tip="Forgets who has already chatted, so their next message runs the First words trigger again. It applies to the platform picked in the box on the left of the list (All = every platform)." />
              <TextBlock Classes="h2" Text="Present viewers" Margin="0,8,0,0" />
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="Present if they chatted in the last" VerticalAlignment="Center" TextWrapping="Wrap" Width="130" />
                <NumericUpDown Value="{Binding PresentMinutes}" Minimum="0" Increment="1" FormatString="0" Width="110" ToolTip.Tip="A viewer counts as here as long as they chatted within this many minutes." />
                <TextBlock Text="min" Classes="muted" VerticalAlignment="Center" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="Fire 'Present viewers' every" VerticalAlignment="Center" TextWrapping="Wrap" Width="130" />
                <NumericUpDown Value="{Binding PresentIntervalMinutes}" Minimum="0" Increment="1" FormatString="0" Width="110" ToolTip.Tip="How often, in minutes, the Present viewers trigger runs with the list of people who chatted recently. 0 turns it off." />
                <TextBlock Text="min" Classes="muted" VerticalAlignment="Center" />
              </StackPanel>
              <TextBlock Classes="muted" TextWrapping="Wrap" Text="0 turns the Present viewers trigger off." />
            </StackPanel>
          </Border>

          <Grid DockPanel.Dock="Top" ColumnDefinitions="160,8,*,8,Auto,8,160,8,Auto" Margin="0,0,0,8">
            <ComboBox ItemsSource="{Binding Platforms}" SelectedItem="{Binding PlatformFilter}" HorizontalAlignment="Stretch"
                      ToolTip.Tip="Only show viewers from this platform (for example Twitch or YouTube)." />
            <TextBox Grid.Column="2" Text="{Binding Search}" PlaceholderText="Search name or id" ToolTip.Tip="Type part of a viewer's name or id to narrow the list." />
            <TextBlock Grid.Column="4" Text="Add to" VerticalAlignment="Center" />
            <ComboBox Grid.Column="6" ItemsSource="{Binding Groups}" SelectedItem="{Binding SelectedGroup}" HorizontalAlignment="Stretch"
                      PlaceholderText="Group" ToolTip.Tip="The group that Add user puts the selected viewer into. Create groups on the Groups tab.">
              <ComboBox.ItemTemplate>
                <DataTemplate DataType="vm:GroupRowViewModel">
                  <TextBlock Text="{Binding Name}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <Button Grid.Column="8" Content="Add user" Command="{Binding AddSelectedUserToGroupCommand}"
                    ToolTip.Tip="Puts the viewer you selected in the list into the group chosen on the left." />
          </Grid>
          <Border DockPanel.Dock="Top" Classes="card" Margin="0,0,0,8" IsVisible="{Binding IsConfirmingForget}">
            <StackPanel Spacing="8">
              <TextBlock Text="{Binding ForgetPrompt}" TextWrapping="Wrap" />
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Forget viewer" Classes="accent" Command="{Binding ConfirmForgetCommand}" ToolTip.Tip="Deletes everything Cuebot saved about this viewer. This cannot be undone." />
                <Button Content="Cancel" Command="{Binding CancelForgetCommand}" ToolTip.Tip="Keeps the viewer. Nothing is deleted." />
              </StackPanel>
            </StackPanel>
          </Border>
          <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
            <Button DockPanel.Dock="Right" Content="Forget viewer…" Command="{Binding ForgetSelectedUserCommand}" Margin="8,0,0,0"
                    ToolTip.Tip="Deletes everything Cuebot saved about the selected viewer, for example when they ask you to delete their data. You are asked to confirm first." />
            <TextBlock DockPanel.Dock="Right" Text="{Binding UsersStatus}" Classes="muted" VerticalAlignment="Center" />
            <TextBlock Text="{Binding UsersSummary}" Classes="muted" />
          </DockPanel>
          <Grid DockPanel.Dock="Top" ColumnDefinitions="*,90,140,140,90,*" Margin="12,4,12,4">
            <TextBlock Classes="muted" Text="USER" />
            <TextBlock Grid.Column="1" Classes="muted" Text="PLATFORM" />
            <TextBlock Grid.Column="2" Classes="muted" Text="FIRST SEEN" />
            <TextBlock Grid.Column="3" Classes="muted" Text="LAST SEEN" />
            <TextBlock Grid.Column="4" Classes="muted" Text="MESSAGES" />
            <TextBlock Grid.Column="5" Classes="muted" Text="ROLES" />
          </Grid>
          <Grid>
            <ListBox ItemsSource="{Binding Users}" SelectedItem="{Binding SelectedUser}">
              <ListBox.ItemTemplate>
                <DataTemplate DataType="vm:UserRowViewModel">
                  <Grid ColumnDefinitions="*,90,140,140,90,*" ToolTip.Tip="{Binding Tip}">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="1" Text="{Binding Platform}" Classes="muted" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2" Text="{Binding FirstSeen}" Classes="muted" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="3" Text="{Binding LastSeen}" Classes="muted" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="4" Text="{Binding Messages}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="5" Text="{Binding Roles}" Classes="muted" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock Classes="muted" IsVisible="{Binding !Users.Count}" HorizontalAlignment="Center" VerticalAlignment="Center"
                       Text="Users appear here when they chat on a connected platform." />
          </Grid>
        </DockPanel>
      </TabItem>

      <TabItem Header="Groups">
        <Grid ColumnDefinitions="340,16,*" Margin="0,8,0,0">
          <DockPanel>
            <Grid DockPanel.Dock="Top" ColumnDefinitions="*,8,Auto" Margin="0,0,0,8">
              <TextBox Text="{Binding NewGroupName}" PlaceholderText="New group name" ToolTip.Tip="A name for a new group of viewers, like Friends or Mods. Commands can then allow only that group." />
              <Button Grid.Column="2" Content="Create" Classes="accent" Command="{Binding AddGroupCommand}" ToolTip.Tip="Creates the group with the name you typed." />
            </Grid>
            <TextBlock DockPanel.Dock="Top" Classes="muted" Text="{Binding GroupsSummary}" TextWrapping="Wrap" Margin="0,0,0,6" />
            <ListBox ItemsSource="{Binding Groups}" SelectedItem="{Binding SelectedGroup}">
              <ListBox.ItemTemplate>
                <DataTemplate DataType="vm:GroupRowViewModel">
                  <StackPanel>
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding CountText}" Classes="muted" />
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </DockPanel>

          <TextBlock Grid.Column="2" Classes="muted" IsVisible="{Binding !HasSelectedGroup}" FontSize="14"
                     HorizontalAlignment="Center" VerticalAlignment="Center" Text="Create or select a group" />
          <DockPanel Grid.Column="2" IsVisible="{Binding HasSelectedGroup}">
            <Border DockPanel.Dock="Top" Classes="card">
              <StackPanel Spacing="10">
                <Grid ColumnDefinitions="Auto,8,*,8,Auto,8,Auto">
                  <TextBlock Text="Name" VerticalAlignment="Center" />
                  <ContentControl Grid.Column="2" Content="{Binding SelectedGroup}">
                    <ContentControl.ContentTemplate>
                      <DataTemplate DataType="vm:GroupRowViewModel">
                        <StackPanel>
                          <TextBox x:Name="GroupName" Text="{Binding NameText}" ToolTip.Tip="The name of the group. You can change it here." />
                          <TextBlock Classes="error" Text="{Binding NameError}"
                                     IsVisible="{Binding NameError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                        </StackPanel>
                      </DataTemplate>
                    </ContentControl.ContentTemplate>
                  </ContentControl>
                  <Button Grid.Column="4" Content="Clear members" Command="{Binding ClearGroupCommand}" ToolTip.Tip="Takes everyone out of this group but keeps the group itself." />
                  <Button Grid.Column="6" Content="Delete group" Command="{Binding DeleteGroupCommand}" ToolTip.Tip="Deletes this group and its list of members." />
                </Grid>
                <TextBlock Classes="muted" TextWrapping="Wrap"
                           Text="If you rename a group, commands that allow or block it by name are not updated. Check them on the Commands page." />
                <TextBlock Classes="h2" Text="Add a member" Margin="0,6,0,0" />
                <Grid ColumnDefinitions="120,8,*,8,160,8,Auto">
                  <AutoCompleteBox Text="{Binding MemberPlatform}" ItemsSource="{Binding Platforms}" MinimumPrefixLength="0"
                                   FilterMode="ContainsOrdinal" PlaceholderText="Platform" ToolTip.Tip="Where this person chats, like Twitch or YouTube." />
                  <TextBox Grid.Column="2" Text="{Binding MemberName}" PlaceholderText="User name" ToolTip.Tip="The person's name on that platform." />
                  <TextBox Grid.Column="4" Text="{Binding MemberId}" PlaceholderText="User id (optional)" ToolTip.Tip="Optional. The platform's number for this person. It stays the same even if they change their name. Leave empty if you do not know it." />
                  <Button Grid.Column="6" Content="Add" Classes="accent" Command="{Binding AddMemberCommand}" ToolTip.Tip="Adds this person to the group." />
                </Grid>
                <TextBlock Classes="muted" Text="{Binding GroupsStatus}" />
              </StackPanel>
            </Border>
            <Grid DockPanel.Dock="Top" ColumnDefinitions="100,*,*,Auto" Margin="12,0,12,4">
              <TextBlock Classes="muted" Text="PLATFORM" />
              <TextBlock Grid.Column="1" Classes="muted" Text="USER" />
              <TextBlock Grid.Column="2" Classes="muted" Text="ID" />
            </Grid>
            <ListBox ItemsSource="{Binding Members}">
              <ListBox.ItemTemplate>
                <DataTemplate DataType="vm:GroupMemberRow">
                  <Grid ColumnDefinitions="100,*,*,Auto">
                    <TextBlock Text="{Binding Platform}" Classes="muted" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding UserName}" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2" Text="{Binding UserId}" Classes="muted" VerticalAlignment="Center" />
                    <Button Grid.Column="3" Content="Remove" Padding="8,2"
                            Command="{Binding RemoveCommand}" CommandParameter="{Binding}" ToolTip.Tip="Takes this person out of the group." />
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </DockPanel>
        </Grid>
      </TabItem>
    </TabControl>
  </DockPanel>
</UserControl>

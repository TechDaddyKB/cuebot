<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Cuebot.App.ViewModels"
             x:Class="Cuebot.App.Views.ObsView"
             x:DataType="vm:ObsViewModel"
             x:Name="Root">
  <ScrollViewer Padding="24">
    <StackPanel MaxWidth="760" HorizontalAlignment="Left">
      <TextBlock Classes="h1" Text="OBS Studio" />

      <Border Classes="card">
        <StackPanel Spacing="8">
          <TextBlock Classes="h2" Text="Connection" />
          <TextBlock Classes="muted" TextWrapping="Wrap"
                     Text="In OBS open Tools → WebSocket Server Settings, enable the server and copy the port and password." />
          <Grid ColumnDefinitions="*,12,140" RowDefinitions="Auto,Auto">
            <TextBlock Text="Host" />
            <TextBlock Grid.Column="2" Text="Port" />
            <TextBox Grid.Row="1" Text="{Binding Host}" />
            <NumericUpDown Grid.Row="1" Grid.Column="2" Value="{Binding Port}" Minimum="1" Maximum="65535" FormatString="0" />
          </Grid>
          <TextBlock Text="Password" />
          <TextBox Text="{Binding Password}" PasswordChar="•" />
          <CheckBox Content="Connect automatically and reconnect when OBS restarts" IsChecked="{Binding AutoConnect}" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="Connect" Classes="accent" Command="{Binding ConnectCommand}" />
            <Button Content="Disconnect" Command="{Binding DisconnectCommand}" />
          </StackPanel>
          <TextBlock>
            <Run Text="{Binding State}" FontWeight="SemiBold" /><Run Text="  " /><Run Text="{Binding StatusMessage}" Foreground="{StaticResource CuebotMuted}" />
          </TextBlock>
          <TextBlock Classes="error" Text="{Binding Error}" />
        </StackPanel>
      </Border>

      <Border Classes="card">
        <StackPanel Spacing="8">
          <TextBlock Classes="h2" Text="Scenes" />
          <TextBlock Text="{Binding CurrentScene, StringFormat='Current scene: {0}'}" />
          <ItemsControl ItemsSource="{Binding Scenes}">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="x:String">
                <Button Content="{Binding}" Margin="0,0,6,6"
                        Command="{Binding #Root.((vm:ObsViewModel)DataContext).SwitchSceneCommand}" CommandParameter="{Binding}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:Cuebot.App.Controls"
             xmlns:vm="using:Cuebot.App.ViewModels.StreamDeck"
             x:Class="Cuebot.App.Views.StreamDeck.StreamDeckView"
             x:DataType="vm:StreamDeckViewModel">
  <ScrollViewer Padding="24,8,24,24">
    <StackPanel MaxWidth="860" HorizontalAlignment="Left">
      <c:StatusHeader Title="Stream Deck plugin" Brand="Stream Deck" State="{Binding State}" Detail="{Binding StatusMessage}" />
      <TextBlock Classes="muted" TextWrapping="Wrap" Margin="0,0,0,8"
                 Text="The Cuebot plugin for Stream Deck lets your Stream Deck keys run Cuebot actions, switch them on and off, set global variables and set off the Stream Deck Action trigger. In return, Cuebot's Stream Deck sub-actions (steps inside an action) can change what a key shows, using the key's button ID (its name)." />


      <!-- Direct USB: decks driven without the Stream Deck app -->
      <ContentControl Name="UsbCard" Content="{Binding Usb}" IsVisible="{Binding HasUsb}">
        <ContentControl.ContentTemplate>
          <DataTemplate x:DataType="vm:StreamDeckUsbViewModel">
            <Border Classes="card">
              <StackPanel Spacing="8">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Classes="h2" Text="Direct USB (no Stream Deck app)" />
                  <Button Grid.Column="1" Content="Scan now" Command="{Binding RescanCommand}" ToolTip.Tip="Looks for Stream Decks plugged into this computer again." />
                </Grid>
                <TextBlock Classes="muted" TextWrapping="Wrap"
                           Text="Cuebot can run a Stream Deck plugged into this computer by itself, without the Stream Deck app (Linux). Pressing a key sets off the Stream Deck Action trigger with the key's button ID, and the Stream Deck sub-actions can change its title, image and state. Close other Stream Deck programs (StreamController, OpenDeck) or turn this off so they can use the deck." />
                <TextBlock TextWrapping="Wrap">
                  <Run Text="{Binding State}" FontWeight="SemiBold" /><Run Text="  " /><Run Name="UsbStatus" Text="{Binding StatusMessage}" Foreground="{StaticResource CuebotMuted}" />
                </TextBlock>
                <StackPanel Orientation="Horizontal" Spacing="16" IsVisible="{Binding IsAvailable}">
                  <CheckBox Content="Use Stream Decks on USB" IsChecked="{Binding Enabled}"
                            ToolTip.Tip="Lets Cuebot take over Stream Decks plugged in by USB. Untick it if another program should control the deck instead." />
                  <TextBlock Text="Brightness %" VerticalAlignment="Center" />
                  <NumericUpDown Value="{Binding Brightness}" Minimum="0" Maximum="100" Increment="10" FormatString="0" Width="130"
                                   ToolTip.Tip="How bright the key screens are, from 0 (dark) to 100 (brightest)." />
                </StackPanel>
                <TextBlock Classes="muted" Text="No Stream Deck found on USB." IsVisible="{Binding HasNoDevices}" />
                <ItemsControl Name="UsbDevices" ItemsSource="{Binding Devices}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:StreamDeckUsbDeviceViewModel">
                      <StackPanel Spacing="4" Margin="0,4,0,12">
                        <TextBlock Text="{Binding Summary}" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <StackPanel Spacing="4" IsVisible="{Binding IsConnected}">
                          <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="Name" VerticalAlignment="Center" Width="60" />
                            <TextBox Text="{Binding Name}" PlaceholderText="(the model name)" Width="240"
                                     ToolTip.Tip="A name for this deck so you can tell decks apart. Leave empty to use the model name." />
                            <Button Content="Save keys" Classes="accent" Command="{Binding SaveCommand}"
                                    ToolTip.Tip="Saves the name and every key setting below for this deck." />
                          </StackPanel>
                          <TextBlock Classes="muted" TextWrapping="Wrap"
                                     Text="Leave Button ID empty to use the grey default shown in it. Title and image are what the key shows until an action changes it. For the image, give a picture file on this computer, or a web link to a picture." />
                          <Expander Header="Keys" HorizontalAlignment="Stretch" IsExpanded="True">
                            <StackPanel>
                              <Grid ColumnDefinitions="200,220,160,*" Margin="0,4,0,0">
                                <TextBlock Text="Key" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="1" Text="Button ID" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="2" Text="Title" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="3" Text="Image" FontWeight="SemiBold" />
                              </Grid>
                              <ItemsControl ItemsSource="{Binding Keys}">
                                <ItemsControl.ItemTemplate>
                                  <DataTemplate x:DataType="vm:StreamDeckUsbKeyViewModel">
                                    <Grid ColumnDefinitions="200,220,160,*" Margin="0,1">
                                      <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                                      <TextBox Grid.Column="1" Text="{Binding ButtonId}" PlaceholderText="{Binding DefaultButtonId}" FontFamily="monospace" Margin="0,0,6,0"
                                               ToolTip.Tip="The name of this key. Use it in the Stream Deck Action trigger and sub-actions to pick this key. Empty uses the default shown." />
                                      <TextBox Grid.Column="2" Text="{Binding Title}" IsEnabled="{Binding HasDisplay}" Margin="0,0,6,0"
                                               ToolTip.Tip="The text shown on this key. Only keys with a screen can show text." />
                                      <TextBox Grid.Column="3" Text="{Binding Image}" IsEnabled="{Binding HasDisplay}"
                                               ToolTip.Tip="A picture file on this computer or a web link to a picture, shown on this key. Only keys with a screen can show a picture." />
                                    </Grid>
                                  </DataTemplate>
                                </ItemsControl.ItemTemplate>
                              </ItemsControl>
                            </StackPanel>
                          </Expander>
                        </StackPanel>
                      </StackPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Classes="muted" TextWrapping="Wrap" Text="{Binding Message}" />
              </StackPanel>
            </Border>
          </DataTemplate>
        </ContentControl.ContentTemplate>
      </ContentControl>

      <!-- Setup -->
      <Border Classes="card">
        <StackPanel Spacing="10">
          <TextBlock Classes="h2" Text="Set up" />

          <StackPanel Spacing="4">
            <TextBlock FontWeight="SemiBold" Text="1. Turn on the REST API" />
            <TextBlock Classes="muted" TextWrapping="Wrap"
                       Text="The plugin talks to Cuebot through its REST API (a doorway that other programs use to give Cuebot orders; see the Servers page), using a secret token as the password. By default only this computer can use it, unless you allow other computers on your network on the Servers page." />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Name="ApiState" Text="{Binding ApiState}" VerticalAlignment="Center" TextWrapping="Wrap" />
              <Button Content="Turn on the REST API" Classes="accent" Command="{Binding EnableApiCommand}" IsVisible="{Binding !ApiRunning}"
                        ToolTip.Tip="Switches on Cuebot's REST API and creates a token if there is none. The plugin needs it to talk to Cuebot." />
            </StackPanel>
          </StackPanel>

          <StackPanel Spacing="4">
            <TextBlock FontWeight="SemiBold" Text="2. Install the plugin" />
            <TextBlock Classes="muted" TextWrapping="Wrap" Text="{Binding PluginHint}" />
            <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding HasPluginFile}">
              <TextBlock Text="{Binding PluginFile}" VerticalAlignment="Center" FontFamily="monospace" TextWrapping="Wrap" Margin="0,0,8,0" />
              <Button Grid.Column="1" Content="Show file" Command="{Binding OpenPluginFolderCommand}" ToolTip.Tip="Opens the folder that holds the plugin file, so you can double-click it to install." />
            </Grid>
            <TextBlock Classes="muted" TextWrapping="Wrap" IsVisible="{Binding IsLinux}"
                       Text="The Stream Deck app only runs on Windows and macOS. Plug the deck into this computer and use Direct USB above, or run the app on another computer and point the plugin at this one: allow other computers on your network on the Servers page, set the REST API address to 0.0.0.0 (meaning any computer) and type this computer's IP address as the host." />
          </StackPanel>

          <StackPanel Spacing="4">
            <TextBlock FontWeight="SemiBold" Text="3. Pair: enter these in any Cuebot key's settings (Connection)" />
            <Grid ColumnDefinitions="90,*,Auto" RowDefinitions="Auto,Auto,Auto" Margin="0,2">
              <TextBlock Text="Host" VerticalAlignment="Center" ToolTip.Tip="The address of this computer as the plugin should see it." />
              <TextBlock Grid.Column="1" Text="{Binding Host}" VerticalAlignment="Center" FontFamily="monospace" />
              <Button Grid.Column="2" Content="Copy" Tag="host" Click="OnCopy" ToolTip.Tip="Copies the host so you can paste it into the plugin." />
              <TextBlock Grid.Row="1" Text="Port" VerticalAlignment="Center" ToolTip.Tip="The number of the &quot;door&quot; on this computer that the plugin connects to." />
              <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Port}" VerticalAlignment="Center" FontFamily="monospace" />
              <Button Grid.Row="1" Grid.Column="2" Content="Copy" Tag="port" Click="OnCopy" Margin="0,4,0,0" ToolTip.Tip="Copies the port number so you can paste it into the plugin." />
              <TextBlock Grid.Row="2" Text="API token" VerticalAlignment="Center" ToolTip.Tip="A secret code that proves to Cuebot that the plugin is allowed to give it orders." />
              <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <TextBlock Name="Token" Text="{Binding TokenDisplay}" VerticalAlignment="Center" FontFamily="monospace" />
                <CheckBox Content="Show" IsChecked="{Binding ShowToken}" IsVisible="{Binding HasToken}" ToolTip.Tip="Shows the secret token instead of dots. Do not show it on stream." />
              </StackPanel>
              <Button Grid.Row="2" Grid.Column="2" Content="Copy" Tag="token" Click="OnCopy" Margin="0,4,0,0" ToolTip.Tip="Copies the secret token so you can paste it into the plugin. Keep it private." />
            </Grid>
            <TextBlock Classes="muted" TextWrapping="Wrap"
                       Text="The settings are shared by every Cuebot key. The dot next to Connection turns green once the plugin is connected; the Stream Deck app then appears below." />
          </StackPanel>

          <StackPanel Spacing="4">
            <TextBlock FontWeight="SemiBold" Text="4. Use it" />
            <TextBlock Classes="muted" TextWrapping="Wrap"
                       Text="Add Cuebot keys from the Cuebot category. Each key has a Button ID (shown in its settings and below). Use it in the Stream Deck Action trigger to react to presses, dial turns and touches, and in the Stream Deck sub-actions (Set Title, Set State, Set Background, Set Value, Show Alert, Show Ok, Toggle State) to change how keys look." />
          </StackPanel>

          <TextBlock Classes="muted" TextWrapping="Wrap" Text="{Binding Message}" />
        </StackPanel>
      </Border>

      <!-- Connected apps -->
      <Border Classes="card">
        <StackPanel Spacing="8">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Classes="h2" Text="Connected Stream Deck apps" />
            <Button Grid.Column="1" Content="Refresh" Command="{Binding RefreshCommand}" ToolTip.Tip="Updates the list of connected Stream Deck apps and their keys." />
          </Grid>
          <TextBlock Classes="muted" Text="None yet. Install the plugin and enter the token." IsVisible="{Binding HasNoInstances}" TextWrapping="Wrap" />
          <ItemsControl Name="Instances" ItemsSource="{Binding Instances}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:StreamDeckInstanceViewModel">
                <StackPanel Spacing="4" Margin="0,4,0,12">
                  <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                  <TextBlock Classes="muted" Text="{Binding Details}" TextWrapping="Wrap" />
                  <TextBlock Text="Devices" FontWeight="SemiBold" Margin="0,4,0,0" />
                  <ItemsControl ItemsSource="{Binding Devices}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="x:String">
                        <TextBlock Text="{Binding}" Margin="12,1,0,1" />
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <TextBlock Text="Visible Cuebot keys" FontWeight="SemiBold" Margin="0,4,0,0" />
                  <TextBlock Classes="muted" Text="No Cuebot keys on the current pages." IsVisible="{Binding HasNoButtons}" Margin="12,0,0,0" />
                  <ItemsControl ItemsSource="{Binding Buttons}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:StreamDeckButtonViewModel">
                        <Grid ColumnDefinitions="180,220,*,80" Margin="12,1,0,1">
                          <SelectableTextBlock Text="{Binding ButtonId}" FontFamily="monospace" />
                          <TextBlock Grid.Column="1" Text="{Binding Kind}" />
                          <TextBlock Grid.Column="2" Classes="muted" Text="{Binding Where}" />
                          <TextBlock Grid.Column="3" Classes="muted" Text="{Binding State}" />
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>

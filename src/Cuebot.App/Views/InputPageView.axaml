<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Cuebot.App.ViewModels"
             xmlns:midivm="using:Cuebot.App.ViewModels.Midi"
             xmlns:midiv="using:Cuebot.App.Views.Midi"
             xmlns:ctlvm="using:Cuebot.App.ViewModels.Controllers"
             xmlns:ctlv="using:Cuebot.App.Views.Controllers"
             x:Class="Cuebot.App.Views.InputPageView"
             x:DataType="vm:InputPageViewModel">
  <!-- Sub-page views come from templates so they never see this page's DataContext. Each brings its own scrolling and
       padding. Unselected tabs are detached, so the controllers sub-page only keeps SDL running while shown. -->
  <UserControl.DataTemplates>
    <DataTemplate DataType="midivm:MidiViewModel"><midiv:MidiView /></DataTemplate>
    <DataTemplate DataType="ctlvm:ControllersViewModel"><ctlv:ControllersView /></DataTemplate>
  </UserControl.DataTemplates>
  <DockPanel>
    <TextBlock x:Name="SubPageTitle" DockPanel.Dock="Top" Text="{Binding SubPageTitle}" FontSize="16" FontWeight="SemiBold" Margin="24,8,24,0" />
    <TabControl x:Name="Tabs" Classes="subpages" SelectedIndex="{Binding SelectedTab}" Margin="12,0,12,0">
      <TabItem Header="MIDI" Content="{Binding Midi}" />
      <TabItem Header="Game controllers" Content="{Binding Controllers}" />
    </TabControl>
  </DockPanel>
</UserControl>

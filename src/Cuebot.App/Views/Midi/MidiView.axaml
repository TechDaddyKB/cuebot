<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Cuebot.App.ViewModels.Midi"
             x:Class="Cuebot.App.Views.Midi.MidiView"
             x:DataType="vm:MidiViewModel">
  <ScrollViewer Padding="24">
    <StackPanel MaxWidth="980" HorizontalAlignment="Left">
      <TextBlock Classes="h1" Text="MIDI" />
      <TextBlock Classes="muted" TextWrapping="Wrap" Margin="0,0,0,8"
                 Text="MIDI is how music gear (keyboards, pads, knob boxes) talks to a computer. A MIDI In device sends its key and knob presses to Cuebot and starts the MIDI Message trigger (only for the events you set up below). A MIDI Out device receives what your actions send with the MIDI sub-actions (Note On, Control Change, Generic Event, Sysex Event). The same device can be in both lists. Settings are stored in midi.json." />
      <TextBlock TextWrapping="Wrap">
        <Run Text="{Binding State}" FontWeight="SemiBold" /><Run Text="  " /><Run Text="{Binding StatusMessage}" Foreground="{StaticResource CuebotMuted}" /><Run Text="  ·  " /><Run Text="{Binding Backend}" Foreground="{StaticResource CuebotMuted}" />
      </TextBlock>
      <TextBlock Classes="error" TextWrapping="Wrap" Text="{Binding UnavailableReason}" IsVisible="{Binding !IsAvailable}" />

      <!-- Defaults for new devices -->
      <Border Classes="card">
        <StackPanel Spacing="8">
          <TextBlock Classes="h2" Text="New device settings" />
          <StackPanel Orientation="Horizontal" Spacing="16">
            <CheckBox Content="Auto open on startup" IsChecked="{Binding NewAutoOpen}" ToolTip.Tip="Ticked: newly added devices are opened by themselves when Cuebot starts." />
            <CheckBox Content="Reopen on close" IsChecked="{Binding NewReopen}" ToolTip.Tip="Ticked: if a new device disconnects (for example the cable is pulled), Cuebot keeps trying to open it again." />
            <TextBlock Text="Retry every" VerticalAlignment="Center" />
            <NumericUpDown Value="{Binding NewRetry}" Minimum="1" Maximum="3600" Increment="1" FormatString="0" Width="110" ToolTip.Tip="How many seconds Cuebot waits between tries to open a device again." />
            <TextBlock Text="seconds" VerticalAlignment="Center" />
            <Button Content="Refresh device list" Command="{Binding RefreshPortsCommand}" ToolTip.Tip="Looks again for MIDI devices, for example after you plugged one in." />
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- MIDI In -->
      <Border Classes="card">
        <StackPanel Spacing="8">
          <TextBlock Classes="h2" Text="MIDI In" />
          <Grid ColumnDefinitions="*,*,Auto">
            <TextBox Name="MidiNewInputName" Text="{Binding NewInputName}" PlaceholderText="Name (optional)" ToolTip.Tip="A name of your own for this device. Leave empty to use the device's name." />
            <ComboBox Grid.Column="1" Name="MidiNewInputPort" ItemsSource="{Binding InputPorts}" SelectedItem="{Binding NewInputPort}"
                      HorizontalAlignment="Stretch" Margin="8,0,0,0" PlaceholderText="Device" ToolTip.Tip="Pick the keyboard, pad or controller that sends notes and knob turns to Cuebot." />
            <Button Grid.Column="2" Content="Add MIDI In" Margin="8,0,0,0" Command="{Binding AddInputCommand}" ToolTip.Tip="Adds the chosen device so Cuebot can listen to it." />
          </Grid>
          <TextBlock Classes="muted" Text="No MIDI In devices yet." IsVisible="{Binding HasNoInputs}" />
          <ListBox Name="MidiInputs" ItemsSource="{Binding Inputs}" SelectedItem="{Binding SelectedInput}" Background="Transparent">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:MidiDeviceRowViewModel">
                <Grid ColumnDefinitions="180,*,Auto,Auto,Auto,Auto,Auto,Auto" RowDefinitions="Auto,Auto">
                  <TextBox Text="{Binding Name}" VerticalAlignment="Center" ToolTip.Tip="A name of your own for this device." />
                  <ComboBox Grid.Column="1" ItemsSource="{Binding Ports}" SelectedItem="{Binding Device}" HorizontalAlignment="Stretch" Margin="8,0" ToolTip.Tip="Which MIDI device this row uses." />
                  <CheckBox Grid.Column="2" Content="Auto open" IsChecked="{Binding AutoOpen}" Margin="0,0,8,0" ToolTip.Tip="Ticked: this device is opened by itself when Cuebot starts." />
                  <CheckBox Grid.Column="3" Content="Reopen" IsChecked="{Binding ReopenOnClose}" Margin="0,0,8,0" ToolTip.Tip="Ticked: if the device disconnects (for example the cable is pulled), Cuebot keeps trying to open it again." />
                  <NumericUpDown Grid.Column="4" Value="{Binding RetryInterval}" Minimum="1" Maximum="3600" FormatString="0" Width="100"
                                 ToolTip.Tip="How many seconds Cuebot waits between tries to open this device again." />
                  <Button Grid.Column="5" Content="Open" Command="{Binding OpenCommand}" Margin="8,0,0,0" ToolTip.Tip="Starts using this device now." />
                  <Button Grid.Column="6" Content="Close" Command="{Binding CloseCommand}" Margin="8,0,0,0" ToolTip.Tip="Stops using this device. It stays in the list." />
                  <Button Grid.Column="7" Content="Delete" Command="{Binding DeleteCommand}" Margin="8,0,0,0" ToolTip.Tip="Removes this device from the list." />
                  <TextBlock Grid.Row="1" Grid.ColumnSpan="8" Classes="muted" TextWrapping="Wrap">
                    <Run Text="{Binding State}" FontWeight="SemiBold" /><Run Text="  " /><Run Text="{Binding Message}" />
                  </TextBlock>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </StackPanel>
      </Border>

      <!-- Events of the selected MIDI In device -->
      <Border Classes="card">
        <StackPanel Spacing="8">
          <TextBlock Classes="h2" Text="{Binding EventsTitle}" />
          <TextBlock Classes="muted" TextWrapping="Wrap"
                     Text="An event is one key, pad, knob or button on your device, with a name you choose. The MIDI Message trigger can then start only for that one. Learn waits for you to press the key, pad, knob or button, and fills in Command, Channel and Data for you." />
          <StackPanel Orientation="Horizontal" Spacing="8" IsEnabled="{Binding HasSelectedInput}">
            <Button Content="Learn new event" Classes="accent" Command="{Binding LearnNewEventCommand}" ToolTip.Tip="Press a key, pad, knob or button on your device and Cuebot adds it as a new event." />
            <Button Content="Add event" Command="{Binding AddEventCommand}" ToolTip.Tip="Adds an empty event that you fill in by hand." />
            <Button Content="Stop learning" Command="{Binding CancelLearnCommand}" ToolTip.Tip="Stops waiting for you to press something on the device." />
            <CheckBox Content="Ignore NoteOff while learning" IsChecked="{Binding IgnoreNoteOffWhileLearning}" ToolTip.Tip="Ticked: letting go of a key is not picked up while learning, only pressing it. Usually what you want." />
          </StackPanel>
          <TextBlock Text="{Binding LearnStatus}" FontWeight="SemiBold" />
          <ItemsControl Name="MidiEvents" ItemsSource="{Binding Events}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:MidiEventRowViewModel">
                <Border BorderBrush="{StaticResource CuebotMuted}" BorderThickness="0,0,0,1" Padding="0,6">
                  <WrapPanel>
                    <CheckBox IsChecked="{Binding Enabled}" ToolTip.Tip="Unticked: this event is switched off and starts nothing." />
                    <TextBox Text="{Binding Name}" Width="170" Margin="0,0,8,0" ToolTip.Tip="A name for this control, like Volume knob." />
                    <ComboBox ItemsSource="{x:Static vm:MidiViewModel.Commands}" SelectedItem="{Binding Command}" Width="170" Margin="0,0,8,0" ToolTip.Tip="The kind of message, like a key press (Note On) or a knob turn (Control Change)." />
                    <TextBlock Text="Ch" VerticalAlignment="Center" Margin="0,0,4,0" />
                    <NumericUpDown Value="{Binding Channel}" Minimum="1" Maximum="16" FormatString="0" Width="115" ToolTip.Tip="The MIDI channel (1 to 16) the device uses. Learn fills this in." />
                    <CheckBox Content="Any" IsChecked="{Binding IgnoreChannel}" Margin="4,0,8,0" ToolTip.Tip="Ticked: any channel counts." />
                    <TextBlock Text="Data" VerticalAlignment="Center" Margin="0,0,4,0" />
                    <NumericUpDown Value="{Binding Data}" Minimum="0" Maximum="127" FormatString="0" Width="125" ToolTip.Tip="Which key or knob (0 to 127). Learn fills this in." />
                    <CheckBox Content="Any" IsChecked="{Binding IgnoreData}" Margin="4,0,8,0" ToolTip.Tip="Ticked: any key or knob counts." />
                    <CheckBox Content="Ignore NoteOff" IsChecked="{Binding IgnoreNoteOff}" Margin="0,0,8,0" ToolTip.Tip="Ticked: letting go of the key does not count, only pressing it." />
                    <TextBlock Classes="muted" Text="{Binding RawMessage}" VerticalAlignment="Center" Margin="0,0,8,0" ToolTip.Tip="The exact numbers the device sent for this event." />
                    <Button Content="Learn" Command="{Binding LearnCommand}" Margin="0,0,8,0" ToolTip.Tip="Press a key, pad, knob or button on your device to fill in this event." />
                    <Button Content="Delete" Command="{Binding DeleteCommand}" ToolTip.Tip="Removes this event." />
                  </WrapPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <!-- MIDI Out -->
      <Border Classes="card">
        <StackPanel Spacing="8">
          <TextBlock Classes="h2" Text="MIDI Out" />
          <Grid ColumnDefinitions="*,*,Auto">
            <TextBox Name="MidiNewOutputName" Text="{Binding NewOutputName}" PlaceholderText="Name (optional)" ToolTip.Tip="A name of your own for this device. Leave empty to use the device's name." />
            <ComboBox Grid.Column="1" Name="MidiNewOutputPort" ItemsSource="{Binding OutputPorts}" SelectedItem="{Binding NewOutputPort}"
                      HorizontalAlignment="Stretch" Margin="8,0,0,0" PlaceholderText="Device" ToolTip.Tip="Pick the device that should receive messages from your actions." />
            <Button Grid.Column="2" Content="Add MIDI Out" Margin="8,0,0,0" Command="{Binding AddOutputCommand}" ToolTip.Tip="Adds the chosen device so your actions can send to it." />
          </Grid>
          <TextBlock Classes="muted" Text="No MIDI Out devices yet." IsVisible="{Binding HasNoOutputs}" />
          <ItemsControl Name="MidiOutputs" ItemsSource="{Binding Outputs}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:MidiDeviceRowViewModel">
                <Grid ColumnDefinitions="180,*,Auto,Auto,Auto,Auto,Auto,Auto" RowDefinitions="Auto,Auto" Margin="0,4">
                  <TextBox Text="{Binding Name}" VerticalAlignment="Center" ToolTip.Tip="A name of your own for this device." />
                  <ComboBox Grid.Column="1" ItemsSource="{Binding Ports}" SelectedItem="{Binding Device}" HorizontalAlignment="Stretch" Margin="8,0" ToolTip.Tip="Which MIDI device this row uses." />
                  <CheckBox Grid.Column="2" Content="Auto open" IsChecked="{Binding AutoOpen}" Margin="0,0,8,0" ToolTip.Tip="Ticked: this device is opened by itself when Cuebot starts." />
                  <CheckBox Grid.Column="3" Content="Reopen" IsChecked="{Binding ReopenOnClose}" Margin="0,0,8,0" ToolTip.Tip="Ticked: if the device disconnects (for example the cable is pulled), Cuebot keeps trying to open it again." />
                  <NumericUpDown Grid.Column="4" Value="{Binding RetryInterval}" Minimum="1" Maximum="3600" FormatString="0" Width="100"
                                 ToolTip.Tip="How many seconds Cuebot waits between tries to open this device again." />
                  <Button Grid.Column="5" Content="Open" Command="{Binding OpenCommand}" Margin="8,0,0,0" ToolTip.Tip="Starts using this device now." />
                  <Button Grid.Column="6" Content="Close" Command="{Binding CloseCommand}" Margin="8,0,0,0" ToolTip.Tip="Stops using this device. It stays in the list." />
                  <Button Grid.Column="7" Content="Delete" Command="{Binding DeleteCommand}" Margin="8,0,0,0" ToolTip.Tip="Removes this device from the list." />
                  <TextBlock Grid.Row="1" Grid.ColumnSpan="8" Classes="muted" TextWrapping="Wrap">
                    <Run Text="{Binding State}" FontWeight="SemiBold" /><Run Text="  " /><Run Text="{Binding Message}" />
                  </TextBlock>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <TextBlock Classes="h2" Text="Test send" Margin="0,8,0,0" />
          <WrapPanel>
            <ComboBox Name="MidiTestOutput" ItemsSource="{Binding Outputs}" SelectedItem="{Binding TestOutput}" Width="200" Margin="0,0,8,0" ToolTip.Tip="Which MIDI Out device the test message goes to.">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="vm:MidiDeviceRowViewModel">
                  <TextBlock Text="{Binding Name}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <ComboBox ItemsSource="{x:Static vm:MidiViewModel.SendCommands}" SelectedItem="{Binding TestCommand}" Width="180" Margin="0,0,8,0" ToolTip.Tip="The kind of message to send for the test." />
            <TextBox Text="{Binding TestChannel}" Width="70" Margin="0,0,8,0" ToolTip.Tip="The MIDI channel, 1 to 16. Leave empty to send on every channel." PlaceholderText="Ch" />
            <TextBox Text="{Binding TestData1}" Width="80" Margin="0,0,8,0" ToolTip.Tip="The first number of the message, like which key (0 to 127)." />
            <TextBox Text="{Binding TestData2}" Width="80" Margin="0,0,8,0" ToolTip.Tip="The second number of the message, like how hard (0 to 127)." />
            <Button Content="Send" Classes="accent" Command="{Binding SendTestCommand}" ToolTip.Tip="Sends this test message to the chosen device now." />
          </WrapPanel>
          <Grid ColumnDefinitions="*,Auto">
            <TextBox Text="{Binding TestSysex}" PlaceholderText="SysEx hex bytes, e.g. F0 7E 7F 06 01 F7" ToolTip.Tip="An advanced special message for a device: a row of two-character hexadecimal numbers separated by spaces, usually starting with F0 and ending with F7." />
            <Button Grid.Column="1" Content="Send SysEx" Margin="8,0,0,0" Command="{Binding SendSysexCommand}" ToolTip.Tip="Sends the advanced message above to the chosen device now." />
          </Grid>
        </StackPanel>
      </Border>

      <TextBlock Classes="muted" TextWrapping="Wrap" Text="{Binding Info}" />
      <TextBlock Classes="error" TextWrapping="Wrap" Text="{Binding Error}" />

      <!-- Monitor -->
      <Border Classes="card">
        <StackPanel Spacing="8">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Classes="h2" Text="Incoming messages" />
            <Button Grid.Column="1" Content="Clear" Command="{Binding ClearMonitorCommand}" ToolTip.Tip="Empties this list of messages." />
          </Grid>
          <ItemsControl Name="MidiMonitor" ItemsSource="{Binding Monitor}" MaxHeight="240">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="x:String">
                <TextBlock Text="{Binding}" FontFamily="Consolas,DejaVu Sans Mono,monospace" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>

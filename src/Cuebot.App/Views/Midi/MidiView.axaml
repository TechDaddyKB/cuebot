<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Cuebot.App.ViewModels.Midi"
             x:Class="Cuebot.App.Views.Midi.MidiView"
             x:DataType="vm:MidiViewModel">
  <ScrollViewer Padding="24">
    <StackPanel MaxWidth="980" HorizontalAlignment="Left">
      <TextBlock Classes="h1" Text="MIDI" />
      <TextBlock Classes="muted" TextWrapping="Wrap" Margin="0,0,0,8"
                 Text="MIDI In devices fire the MIDI Message trigger (filtered by the events you set up below); MIDI Out devices are used by the MIDI sub-actions (Note On, Control Change, Generic Event, Sysex Event). The same device can be added to both lists. Settings are stored in midi.json." />
      <TextBlock TextWrapping="Wrap">
        <Run Text="{Binding State}" FontWeight="SemiBold" /><Run Text="  " /><Run Text="{Binding StatusMessage}" Foreground="{StaticResource CuebotMuted}" /><Run Text="  ·  " /><Run Text="{Binding Backend}" Foreground="{StaticResource CuebotMuted}" />
      </TextBlock>
      <TextBlock Classes="error" TextWrapping="Wrap" Text="{Binding UnavailableReason}" IsVisible="{Binding !IsAvailable}" />

      <!-- Defaults for new devices -->
      <Border Classes="card">
        <StackPanel Spacing="8">
          <TextBlock Classes="h2" Text="New device settings" />
          <StackPanel Orientation="Horizontal" Spacing="16">
            <CheckBox Content="Auto open on startup" IsChecked="{Binding NewAutoOpen}" />
            <CheckBox Content="Reopen on close" IsChecked="{Binding NewReopen}" />
            <TextBlock Text="Retry every" VerticalAlignment="Center" />
            <NumericUpDown Value="{Binding NewRetry}" Minimum="1" Maximum="3600" Increment="1" FormatString="0" Width="110" />
            <TextBlock Text="seconds" VerticalAlignment="Center" />
            <Button Content="Refresh device list" Command="{Binding RefreshPortsCommand}" />
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- MIDI In -->
      <Border Classes="card">
        <StackPanel Spacing="8">
          <TextBlock Classes="h2" Text="MIDI In" />
          <Grid ColumnDefinitions="*,*,Auto">
            <TextBox Name="MidiNewInputName" Text="{Binding NewInputName}" PlaceholderText="Name (optional)" />
            <ComboBox Grid.Column="1" Name="MidiNewInputPort" ItemsSource="{Binding InputPorts}" SelectedItem="{Binding NewInputPort}"
                      HorizontalAlignment="Stretch" Margin="8,0,0,0" PlaceholderText="Device" />
            <Button Grid.Column="2" Content="Add MIDI In" Margin="8,0,0,0" Command="{Binding AddInputCommand}" />
          </Grid>
          <TextBlock Classes="muted" Text="No MIDI In devices yet." IsVisible="{Binding HasNoInputs}" />
          <ListBox Name="MidiInputs" ItemsSource="{Binding Inputs}" SelectedItem="{Binding SelectedInput}" Background="Transparent">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:MidiDeviceRowViewModel">
                <Grid ColumnDefinitions="180,*,Auto,Auto,Auto,Auto,Auto,Auto" RowDefinitions="Auto,Auto">
                  <TextBox Text="{Binding Name}" VerticalAlignment="Center" />
                  <ComboBox Grid.Column="1" ItemsSource="{Binding Ports}" SelectedItem="{Binding Device}" HorizontalAlignment="Stretch" Margin="8,0" />
                  <CheckBox Grid.Column="2" Content="Auto open" IsChecked="{Binding AutoOpen}" Margin="0,0,8,0" />
                  <CheckBox Grid.Column="3" Content="Reopen" IsChecked="{Binding ReopenOnClose}" Margin="0,0,8,0" />
                  <NumericUpDown Grid.Column="4" Value="{Binding RetryInterval}" Minimum="1" Maximum="3600" FormatString="0" Width="100"
                                 ToolTip.Tip="Retry interval (seconds)" />
                  <Button Grid.Column="5" Content="Open" Command="{Binding OpenCommand}" Margin="8,0,0,0" />
                  <Button Grid.Column="6" Content="Close" Command="{Binding CloseCommand}" Margin="8,0,0,0" />
                  <Button Grid.Column="7" Content="Delete" Command="{Binding DeleteCommand}" Margin="8,0,0,0" />
                  <TextBlock Grid.Row="1" Grid.ColumnSpan="8" Classes="muted" TextWrapping="Wrap">
                    <Run Text="{Binding State}" FontWeight="SemiBold" /><Run Text="  " /><Run Text="{Binding Message}" />
                  </TextBlock>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </StackPanel>
      </Border>

      <!-- Events of the selected MIDI In device -->
      <Border Classes="card">
        <StackPanel Spacing="8">
          <TextBlock Classes="h2" Text="{Binding EventsTitle}" />
          <TextBlock Classes="muted" TextWrapping="Wrap"
                     Text="An event names a control on the device: the MIDI Message trigger can then fire only for it. Learn waits for you to press a key, pad, knob or button and fills in Command, Channel and Data." />
          <StackPanel Orientation="Horizontal" Spacing="8" IsEnabled="{Binding HasSelectedInput}">
            <Button Content="Learn new event" Classes="accent" Command="{Binding LearnNewEventCommand}" />
            <Button Content="Add event" Command="{Binding AddEventCommand}" />
            <Button Content="Stop learning" Command="{Binding CancelLearnCommand}" />
            <CheckBox Content="Ignore NoteOff while learning" IsChecked="{Binding IgnoreNoteOffWhileLearning}" />
          </StackPanel>
          <TextBlock Text="{Binding LearnStatus}" FontWeight="SemiBold" />
          <ItemsControl Name="MidiEvents" ItemsSource="{Binding Events}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:MidiEventRowViewModel">
                <Border BorderBrush="{StaticResource CuebotMuted}" BorderThickness="0,0,0,1" Padding="0,6">
                  <WrapPanel>
                    <CheckBox IsChecked="{Binding Enabled}" ToolTip.Tip="Enabled" />
                    <TextBox Text="{Binding Name}" Width="170" Margin="0,0,8,0" />
                    <ComboBox ItemsSource="{x:Static vm:MidiViewModel.Commands}" SelectedItem="{Binding Command}" Width="170" Margin="0,0,8,0" />
                    <TextBlock Text="Ch" VerticalAlignment="Center" Margin="0,0,4,0" />
                    <NumericUpDown Value="{Binding Channel}" Minimum="1" Maximum="16" FormatString="0" Width="115" />
                    <CheckBox Content="Any" IsChecked="{Binding IgnoreChannel}" Margin="4,0,8,0" />
                    <TextBlock Text="Data" VerticalAlignment="Center" Margin="0,0,4,0" />
                    <NumericUpDown Value="{Binding Data}" Minimum="0" Maximum="127" FormatString="0" Width="125" />
                    <CheckBox Content="Any" IsChecked="{Binding IgnoreData}" Margin="4,0,8,0" />
                    <CheckBox Content="Ignore NoteOff" IsChecked="{Binding IgnoreNoteOff}" Margin="0,0,8,0" />
                    <TextBlock Classes="muted" Text="{Binding RawMessage}" VerticalAlignment="Center" Margin="0,0,8,0" ToolTip.Tip="Raw message" />
                    <Button Content="Learn" Command="{Binding LearnCommand}" Margin="0,0,8,0" />
                    <Button Content="Delete" Command="{Binding DeleteCommand}" />
                  </WrapPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <!-- MIDI Out -->
      <Border Classes="card">
        <StackPanel Spacing="8">
          <TextBlock Classes="h2" Text="MIDI Out" />
          <Grid ColumnDefinitions="*,*,Auto">
            <TextBox Name="MidiNewOutputName" Text="{Binding NewOutputName}" PlaceholderText="Name (optional)" />
            <ComboBox Grid.Column="1" Name="MidiNewOutputPort" ItemsSource="{Binding OutputPorts}" SelectedItem="{Binding NewOutputPort}"
                      HorizontalAlignment="Stretch" Margin="8,0,0,0" PlaceholderText="Device" />
            <Button Grid.Column="2" Content="Add MIDI Out" Margin="8,0,0,0" Command="{Binding AddOutputCommand}" />
          </Grid>
          <TextBlock Classes="muted" Text="No MIDI Out devices yet." IsVisible="{Binding HasNoOutputs}" />
          <ItemsControl Name="MidiOutputs" ItemsSource="{Binding Outputs}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:MidiDeviceRowViewModel">
                <Grid ColumnDefinitions="180,*,Auto,Auto,Auto,Auto,Auto,Auto" RowDefinitions="Auto,Auto" Margin="0,4">
                  <TextBox Text="{Binding Name}" VerticalAlignment="Center" />
                  <ComboBox Grid.Column="1" ItemsSource="{Binding Ports}" SelectedItem="{Binding Device}" HorizontalAlignment="Stretch" Margin="8,0" />
                  <CheckBox Grid.Column="2" Content="Auto open" IsChecked="{Binding AutoOpen}" Margin="0,0,8,0" />
                  <CheckBox Grid.Column="3" Content="Reopen" IsChecked="{Binding ReopenOnClose}" Margin="0,0,8,0" />
                  <NumericUpDown Grid.Column="4" Value="{Binding RetryInterval}" Minimum="1" Maximum="3600" FormatString="0" Width="100"
                                 ToolTip.Tip="Retry interval (seconds)" />
                  <Button Grid.Column="5" Content="Open" Command="{Binding OpenCommand}" Margin="8,0,0,0" />
                  <Button Grid.Column="6" Content="Close" Command="{Binding CloseCommand}" Margin="8,0,0,0" />
                  <Button Grid.Column="7" Content="Delete" Command="{Binding DeleteCommand}" Margin="8,0,0,0" />
                  <TextBlock Grid.Row="1" Grid.ColumnSpan="8" Classes="muted" TextWrapping="Wrap">
                    <Run Text="{Binding State}" FontWeight="SemiBold" /><Run Text="  " /><Run Text="{Binding Message}" />
                  </TextBlock>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <TextBlock Classes="h2" Text="Test send" Margin="0,8,0,0" />
          <WrapPanel>
            <ComboBox Name="MidiTestOutput" ItemsSource="{Binding Outputs}" SelectedItem="{Binding TestOutput}" Width="200" Margin="0,0,8,0">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="vm:MidiDeviceRowViewModel">
                  <TextBlock Text="{Binding Name}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <ComboBox ItemsSource="{x:Static vm:MidiViewModel.SendCommands}" SelectedItem="{Binding TestCommand}" Width="180" Margin="0,0,8,0" />
            <TextBox Text="{Binding TestChannel}" Width="70" Margin="0,0,8,0" ToolTip.Tip="Channel 1-16, empty = all" PlaceholderText="Ch" />
            <TextBox Text="{Binding TestData1}" Width="80" Margin="0,0,8,0" ToolTip.Tip="Data1 (MIDI byte 2)" />
            <TextBox Text="{Binding TestData2}" Width="80" Margin="0,0,8,0" ToolTip.Tip="Data2 (MIDI byte 3)" />
            <Button Content="Send" Classes="accent" Command="{Binding SendTestCommand}" />
          </WrapPanel>
          <Grid ColumnDefinitions="*,Auto">
            <TextBox Text="{Binding TestSysex}" PlaceholderText="SysEx hex bytes, e.g. F0 7E 7F 06 01 F7" />
            <Button Grid.Column="1" Content="Send SysEx" Margin="8,0,0,0" Command="{Binding SendSysexCommand}" />
          </Grid>
        </StackPanel>
      </Border>

      <TextBlock Classes="muted" TextWrapping="Wrap" Text="{Binding Info}" />
      <TextBlock Classes="error" TextWrapping="Wrap" Text="{Binding Error}" />

      <!-- Monitor -->
      <Border Classes="card">
        <StackPanel Spacing="8">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Classes="h2" Text="Incoming messages" />
            <Button Grid.Column="1" Content="Clear" Command="{Binding ClearMonitorCommand}" />
          </Grid>
          <ItemsControl Name="MidiMonitor" ItemsSource="{Binding Monitor}" MaxHeight="240">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="x:String">
                <TextBlock Text="{Binding}" FontFamily="Consolas,DejaVu Sans Mono,monospace" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>

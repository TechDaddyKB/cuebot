<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Cuebot.App.ViewModels"
             x:Class="Cuebot.App.Views.MediaRequestsView"
             x:DataType="vm:MediaRequestsViewModel">
  <DockPanel Margin="24,24,24,16">
    <StackPanel DockPanel.Dock="Top" Spacing="4">
      <TextBlock Classes="h1" Text="Media Requests" />
      <TextBlock Classes="muted" TextWrapping="Wrap"
                 Text="Viewers on every platform request YouTube videos in chat; the Media request player widget (Overlays &amp; Widgets) plays them on stream. Paid requests are refunded when removed before they play." />
    </StackPanel>
    <TextBlock DockPanel.Dock="Top" Text="{Binding Status}" Classes="muted" Margin="0,8,0,0" TextWrapping="Wrap"
               IsVisible="{Binding Status, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

    <ScrollViewer Margin="0,12,0,0">
      <StackPanel Spacing="12">
        <!-- Now playing -->
        <Border Classes="card">
          <StackPanel Spacing="8">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel Spacing="2">
                <TextBlock Text="Now playing" Classes="muted" />
                <TextBlock Text="{Binding NowPlaying}" FontWeight="SemiBold" TextWrapping="Wrap" />
              </StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <ToggleButton Content="Pause" IsChecked="{Binding Paused, Mode=OneWay}" Command="{Binding TogglePauseCommand}" />
                <Button Content="Skip" Command="{Binding SkipCommand}" IsEnabled="{Binding Playing}" />
              </StackPanel>
            </Grid>
            <Grid ColumnDefinitions="Auto,8,*,8,40">
              <TextBlock Text="Volume" VerticalAlignment="Center" />
              <Slider Grid.Column="2" Minimum="0" Maximum="100" Value="{Binding Volume}" />
              <TextBlock Grid.Column="4" Text="{Binding Volume, StringFormat={}{0:0}}" VerticalAlignment="Center" />
            </Grid>
          </StackPanel>
        </Border>

        <!-- Queue -->
        <Border Classes="card">
          <StackPanel Spacing="8">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="Queue" FontWeight="SemiBold" FontSize="16" VerticalAlignment="Center" />
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <TextBlock Text="{Binding QueueSummary}" Classes="muted" VerticalAlignment="Center" />
                <Button Content="Clear" Command="{Binding ClearQueueCommand}" ToolTip.Tip="Remove every waiting request (refunded)" />
              </StackPanel>
            </Grid>
            <Grid ColumnDefinitions="*,8,Auto">
              <TextBox Text="{Binding NewLink}" PlaceholderText="Add a YouTube link yourself (free)" />
              <Button Grid.Column="2" Content="+ Add" Classes="accent" Command="{Binding AddCommand}" />
            </Grid>
            <ItemsControl ItemsSource="{Binding Queue}">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="vm:MediaQueueRowViewModel">
                  <Grid ColumnDefinitions="*,Auto,4,Auto,4,Auto" Margin="0,0,0,6">
                    <StackPanel>
                      <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Url}" />
                      <TextBlock Text="{Binding Detail}" Classes="muted" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="↑" Command="{Binding UpCommand}" AutomationProperties.Name="Move up" VerticalAlignment="Center" />
                    <Button Grid.Column="3" Content="↓" Command="{Binding DownCommand}" AutomationProperties.Name="Move down" VerticalAlignment="Center" />
                    <Button Grid.Column="5" Content="Remove" Command="{Binding RemoveCommand}" VerticalAlignment="Center" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="Played" Classes="muted" />
            <ItemsControl ItemsSource="{Binding Played}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="x:String">
                  <TextBlock Text="{Binding}" Classes="muted" TextTrimming="CharacterEllipsis" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

        <!-- Settings -->
        <Border Classes="card">
          <StackPanel Spacing="8">
            <TextBlock Text="Settings" FontWeight="SemiBold" FontSize="16" />
            <WrapPanel>
              <CheckBox Content="Taking requests" IsChecked="{Binding Open}" Margin="0,0,16,6" />
              <CheckBox Content="Subscribers only" IsChecked="{Binding SubscribersOnly}" Margin="0,0,16,6" />
              <CheckBox Content="Answer in chat" IsChecked="{Binding ReplyInChat}" Margin="0,0,16,6"
                        ToolTip.Tip="Tell viewers their place in the queue, or why a request was refused" />
            </WrapPanel>
            <WrapPanel>
              <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,16,6">
                <TextBlock Text="Request" VerticalAlignment="Center" />
                <TextBox Text="{Binding Command, UpdateSourceTrigger=LostFocus}" Width="110" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,16,6">
                <TextBlock Text="Take back" VerticalAlignment="Center" />
                <TextBox Text="{Binding WrongCommand, UpdateSourceTrigger=LostFocus}" Width="130" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,16,6">
                <TextBlock Text="Skip (moderators)" VerticalAlignment="Center" />
                <TextBox Text="{Binding ModSkipCommand, UpdateSourceTrigger=LostFocus}" Width="110" />
              </StackPanel>
            </WrapPanel>
            <WrapPanel>
              <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,16,6">
                <TextBlock Text="Cost (points)" VerticalAlignment="Center" />
                <NumericUpDown Value="{Binding Cost}" Minimum="0" Maximum="100000000" FormatString="0" Width="130" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,16,6">
                <TextBlock Text="Requests per viewer" VerticalAlignment="Center" />
                <NumericUpDown Value="{Binding MaxPerViewer}" Minimum="1" Maximum="50" FormatString="0" Width="100" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,16,6">
                <TextBlock Text="Longest play (minutes, 0: whole video)" VerticalAlignment="Center" />
                <NumericUpDown Value="{Binding MaxMinutes}" Minimum="0" Maximum="180" Increment="0.5" FormatString="0.#" Width="100" />
              </StackPanel>
            </WrapPanel>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</UserControl>

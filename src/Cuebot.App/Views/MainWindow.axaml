<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Cuebot.App.ViewModels"
        xmlns:actions="using:Cuebot.App.ViewModels.Actions"
        xmlns:views="using:Cuebot.App.Views"
        xmlns:ytvm="using:Cuebot.App.ViewModels.YouTube"
        xmlns:ytv="using:Cuebot.App.Views.YouTube"
        xmlns:kickvm="using:Cuebot.App.ViewModels.Kick"
        xmlns:kickv="using:Cuebot.App.Views.Kick"
        xmlns:donvm="using:Cuebot.App.ViewModels.Donations"
        xmlns:donv="using:Cuebot.App.Views.Donations"
        xmlns:intvm="using:Cuebot.App.ViewModels.Integrations"
        xmlns:intv="using:Cuebot.App.Views.Integrations"
        xmlns:whvm="using:Cuebot.App.ViewModels.Webhooks"
        xmlns:whv="using:Cuebot.App.Views.Webhooks"
        xmlns:savm="using:Cuebot.App.ViewModels.StreamApps"
        xmlns:sav="using:Cuebot.App.Views.StreamApps"
        xmlns:srvvm="using:Cuebot.App.ViewModels.Servers"
        xmlns:srvv="using:Cuebot.App.Views.Servers"
        xmlns:xvm="using:Cuebot.App.ViewModels.Extras"
        xmlns:xviews="using:Cuebot.App.Views.Extras"
        xmlns:tvm="using:Cuebot.App.ViewModels.Transfer"
        xmlns:tviews="using:Cuebot.App.Views.Transfer"
        xmlns:supvm="using:Cuebot.App.ViewModels.Support"
        xmlns:supv="using:Cuebot.App.Views.Support"
        xmlns:hvm="using:Cuebot.App.ViewModels.History"
        xmlns:hv="using:Cuebot.App.Views.History"
        xmlns:asvm="using:Cuebot.App.ViewModels.Assistant"
        xmlns:asv="using:Cuebot.App.Views.Assistant"
        xmlns:c="using:Cuebot.App.Controls"
        xmlns:vcvm="using:Cuebot.App.ViewModels.VoiceControl"
        xmlns:vcv="using:Cuebot.App.Views.VoiceControl"
        xmlns:sdvm="using:Cuebot.App.ViewModels.StreamDeck"
        xmlns:sdv="using:Cuebot.App.Views.StreamDeck"
        x:Class="Cuebot.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Cuebot"
        Icon="avares://Cuebot/Assets/cuebot.ico"
        Width="1360" Height="860" MinWidth="960" MinHeight="600"
        Background="{DynamicResource CuebotGround}"
        WindowStartupLocation="CenterScreen">
  <!-- The top bar shows the name; the title the drawn decorations (Windows) would put over the icon is hidden. -->
  <Window.WindowDecorationsTheme>
    <ControlTheme TargetType="WindowDrawnDecorations" BasedOn="{StaticResource {x:Type WindowDrawnDecorations}}">
      <Style Selector="^ /template/ Panel#PART_TitleTextPanel > TextBlock">
        <Setter Property="IsVisible" Value="False" />
      </Style>
    </ControlTheme>
  </Window.WindowDecorationsTheme>
  <Window.Styles>
    <!-- Icon rail -->
    <Style Selector="Button.rail">
      <Setter Property="Width" Value="66" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Padding" Value="2,8" />
      <Setter Property="Margin" Value="0,1" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Foreground" Value="{DynamicResource CuebotMuted}" />
    </Style>
    <Style Selector="Button.rail:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource CuebotRaised}" />
    </Style>
    <Style Selector="Button.rail.current">
      <Setter Property="Foreground" Value="{DynamicResource CuebotText}" />
    </Style>
    <Style Selector="Button.rail.current /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource CuebotAccentSoft}" />
    </Style>
    <Style Selector="Button.rail.current c|Icon">
      <Setter Property="Foreground" Value="{DynamicResource CuebotAccent}" />
    </Style>
    <Style Selector="Button.flat">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Padding" Value="6" />
      <Setter Property="Foreground" Value="{DynamicResource CuebotMuted}" />
    </Style>
    <!-- Section list -->
    <Style Selector="ListBox.nav ListBoxItem">
      <Setter Property="Padding" Value="10,7" />
      <Setter Property="Margin" Value="0,1" />
      <Setter Property="MinHeight" Value="0" />
    </Style>
    <!-- Pages draw their own title for now; the page header shows it (until phase 3 removes them). -->
    <Style Selector="ContentControl#PageHost TextBlock.h1">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <!-- Status bar -->
    <Style Selector="Border#StatusBar TextBlock">
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="Foreground" Value="{DynamicResource CuebotMuted}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
  </Window.Styles>
  <Window.DataTemplates>
    <DataTemplate DataType="hvm:HistoryViewModel"><hv:HistoryView /></DataTemplate>
    <DataTemplate DataType="asvm:AssistantViewModel"><asv:AssistantView /></DataTemplate>
    <DataTemplate DataType="vm:DashboardViewModel"><views:DashboardView /></DataTemplate>
    <DataTemplate DataType="vm:ChatViewModel"><views:ChatView /></DataTemplate>
    <DataTemplate DataType="actions:ActionsViewModel"><views:ActionsView /></DataTemplate>
    <DataTemplate DataType="vm:CommandsViewModel"><views:CommandsView /></DataTemplate>
    <DataTemplate DataType="vm:QueuesViewModel"><views:QueuesView /></DataTemplate>
    <DataTemplate DataType="vm:TimersViewModel"><views:TimersView /></DataTemplate>
    <DataTemplate DataType="vm:UsersViewModel"><views:UsersView /></DataTemplate>
    <DataTemplate DataType="vm:VariablesViewModel"><views:VariablesView /></DataTemplate>
    <DataTemplate DataType="vm:WatchersViewModel"><views:WatchersView /></DataTemplate>
    <DataTemplate DataType="vm:TwitchViewModel"><views:TwitchView /></DataTemplate>
    <DataTemplate DataType="vm:RumbleViewModel"><views:RumbleView /></DataTemplate>
    <DataTemplate DataType="ytvm:YouTubeViewModel"><ytv:YouTubeView /></DataTemplate>
    <DataTemplate DataType="kickvm:KickViewModel"><kickv:KickView /></DataTemplate>
    <DataTemplate DataType="donvm:DonationsViewModel"><donv:DonationsView /></DataTemplate>
    <DataTemplate DataType="intvm:IntegrationsViewModel"><intv:IntegrationsView /></DataTemplate>
    <DataTemplate DataType="intvm:IntegrationsPageViewModel"><intv:IntegrationsPageView /></DataTemplate>
    <DataTemplate DataType="vm:InputPageViewModel"><views:InputPageView /></DataTemplate>
    <DataTemplate DataType="vcvm:VoiceControlViewModel"><vcv:VoiceControlView /></DataTemplate>
    <DataTemplate DataType="sdvm:StreamDeckViewModel"><sdv:StreamDeckView /></DataTemplate>
    <DataTemplate DataType="whvm:WebhooksPageViewModel"><whv:WebhooksPageView /></DataTemplate>
    <DataTemplate DataType="xvm:QuotesViewModel"><xviews:QuotesView /></DataTemplate>
    <DataTemplate DataType="xvm:CreditsViewModel"><xviews:CreditsView /></DataTemplate>
    <DataTemplate DataType="xvm:PointsViewModel"><xviews:PointsView /></DataTemplate>
    <DataTemplate DataType="xvm:DecksViewModel"><xviews:DecksView /></DataTemplate>
    <DataTemplate DataType="xvm:HotkeysViewModel"><xviews:HotkeysView /></DataTemplate>
    <DataTemplate DataType="vm:ObsViewModel"><views:ObsView /></DataTemplate>
    <DataTemplate DataType="savm:StreamAppsPageViewModel"><sav:StreamAppsPageView /></DataTemplate>
    <DataTemplate DataType="vm:SpeechViewModel"><views:SpeechView /></DataTemplate>
    <DataTemplate DataType="vm:ScriptingViewModel"><views:ScriptingView /></DataTemplate>
    <DataTemplate DataType="srvvm:ServersViewModel"><srvv:ServersView /></DataTemplate>
    <DataTemplate DataType="tvm:ImportExportViewModel"><tviews:ImportExportView /></DataTemplate>
    <DataTemplate DataType="supvm:SupportViewModel"><supv:SupportView /></DataTemplate>
    <DataTemplate DataType="vm:SettingsViewModel"><views:SettingsView /></DataTemplate>
    <DataTemplate DataType="vm:OverlaysViewModel"><views:OverlaysView /></DataTemplate>
  </Window.DataTemplates>

  <Grid RowDefinitions="52,*,28">
    <!-- ===== Top bar ===== -->
    <Border x:Name="TopBar" Background="{DynamicResource CuebotRail}">
      <Grid>
        <DockPanel Margin="14,0,0,0" x:Name="TopBarContent">
          <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
            <Image Source="avares://Cuebot/Assets/cuebot.png" Width="26" Height="26" />
            <TextBlock Text="Cuebot" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" />
            <TextBlock Text="{Binding Version}" Classes="muted" FontSize="11" VerticalAlignment="Center" />
            <Border Width="1" Height="18" Background="{DynamicResource CuebotLine}" Margin="2,0" />
            <Button x:Name="TddMark" Classes="flat" Command="{Binding OpenAboutCommand}" ToolTip.Tip="About Cuebot"
                    AutomationProperties.Name="About Cuebot, made by Tech Daddy Digital">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <Path Data="{StaticResource Brand.TddHead}" Fill="{DynamicResource CuebotText}" Stretch="Uniform" Height="18" />
                <TextBlock Text="by Tech Daddy Digital" FontSize="11" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
          </StackPanel>
          <!-- Connection chips: only connections in use. -->
          <ItemsControl x:Name="Chips" DockPanel.Dock="Right" ItemsSource="{Binding Dashboard.SidebarConnections}" VerticalAlignment="Center" Margin="0,0,12,0">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="6" /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="vm:ConnectionStatusViewModel">
                <Border Background="{DynamicResource CuebotCard}" BorderBrush="{DynamicResource CuebotLine}" BorderThickness="1" CornerRadius="7"
                        Padding="8,4" ToolTip.Tip="{Binding Message}">
                  <StackPanel Orientation="Horizontal" Spacing="7">
                    <Border Width="16" Height="16" CornerRadius="4" Background="{Binding Name, Converter={x:Static c:PlatformBrush.Instance}}">
                      <TextBlock Text="{Binding Name, Converter={x:Static c:PlatformBrush.Initial}}" FontSize="9" FontWeight="Bold"
                                 Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                      <TextBlock Text="{Binding Name}" FontSize="11.5" FontWeight="SemiBold" />
                      <TextBlock Text="{Binding State}" FontSize="10" Classes="muted" />
                    </StackPanel>
                    <Ellipse Classes="status" Classes.good="{Binding IsConnected}" Classes.bad="{Binding IsError}" />
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <AutoCompleteBox x:Name="Jump" Width="340" HorizontalAlignment="Center" VerticalAlignment="Center"
                           ItemsSource="{Binding JumpTargets}" FilterMode="ContainsOrdinal" MinimumPrefixLength="0"
                           PlaceholderText="Jump to a page…   Ctrl+K" AutomationProperties.Name="Jump to a page" />
        </DockPanel>
        <!-- Brand line under the bar -->
        <Border Height="2" VerticalAlignment="Bottom" Background="{StaticResource CuebotBrand}" />
      </Grid>
    </Border>

    <Grid Grid.Row="1" ColumnDefinitions="72,Auto,*">
      <!-- ===== Icon rail ===== -->
      <Border Background="{DynamicResource CuebotRail}" BorderBrush="{DynamicResource CuebotLine}" BorderThickness="0,0,1,0">
        <DockPanel Margin="0,8">
          <ItemsControl DockPanel.Dock="Bottom" ItemsSource="{Binding RailBottom}">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="vm:NavGroupViewModel">
                <Button Classes="rail" Classes.current="{Binding IsCurrent}" Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).SelectGroupCommand}"
                        CommandParameter="{Binding}" ToolTip.Tip="{Binding Name}" AutomationProperties.Name="{Binding Name}">
                  <StackPanel Spacing="3">
                    <c:Icon Kind="{Binding Icon}" Width="20" Height="20" HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding Label}" FontSize="10" HorizontalAlignment="Center" />
                  </StackPanel>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <Button DockPanel.Dock="Top" Classes="rail" Command="{Binding ToggleSectionListCommand}" IsVisible="{Binding !IsSectionListOpen}"
                  ToolTip.Tip="Show the page list" AutomationProperties.Name="Show the page list">
            <c:Icon Kind="panel-left-open" Width="18" Height="18" />
          </Button>
          <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="Rail" ItemsSource="{Binding RailTop}">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="vm:NavGroupViewModel">
                  <Button Classes="rail" Classes.current="{Binding IsCurrent}" Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).SelectGroupCommand}"
                          CommandParameter="{Binding}" ToolTip.Tip="{Binding Name}" AutomationProperties.Name="{Binding Name}">
                    <StackPanel Spacing="3">
                      <c:Icon Kind="{Binding Icon}" Width="20" Height="20" HorizontalAlignment="Center" />
                      <TextBlock Text="{Binding Label}" FontSize="10" HorizontalAlignment="Center" />
                    </StackPanel>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </DockPanel>
      </Border>

      <!-- ===== Section list ===== -->
      <Border Grid.Column="1" Width="210" IsVisible="{Binding IsSectionListOpen}"
              BorderBrush="{DynamicResource CuebotLine}" BorderThickness="0,0,1,0">
        <DockPanel Margin="10,14,10,10">
          <DockPanel DockPanel.Dock="Top" Margin="6,0,0,10">
            <Button DockPanel.Dock="Right" Classes="flat" Command="{Binding ToggleSectionListCommand}"
                    ToolTip.Tip="Hide the page list" AutomationProperties.Name="Hide the page list">
              <c:Icon Kind="panel-left-close" Width="16" Height="16" />
            </Button>
            <TextBlock Text="{Binding CurrentGroup.Name}" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" />
          </DockPanel>
          <ListBox x:Name="SectionPages" Classes="sections plain" ItemsSource="{Binding CurrentGroup.Pages}" SelectedItem="{Binding CurrentGroup.Selected}"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled" ItemContainerTheme="{StaticResource NavPageItem}">
            <ListBox.ItemTemplate>
              <DataTemplate DataType="vm:PageViewModel">
                <StackPanel>
                  <Border Classes="navRow" Classes.selected="{Binding $parent[ListBoxItem].IsSelected}">
                    <TextBlock Text="{Binding Title}" FontSize="13" />
                  </Border>
                  <!-- Sub-pages of the open page (e.g. Speech › Engines). -->
                  <ListBox x:Name="SubPages" Classes="subnav plain" ItemsSource="{Binding SubPages}" SelectedIndex="{Binding SubPageIndex}"
                           ItemContainerTheme="{StaticResource NavSubItem}">
                    <ListBox.IsVisible>
                      <MultiBinding Converter="{x:Static BoolConverters.And}">
                        <Binding Path="HasSubPages" />
                        <Binding Path="$parent[ListBoxItem].IsSelected" />
                      </MultiBinding>
                    </ListBox.IsVisible>
                  </ListBox>
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>

      <!-- ===== Page ===== -->
      <DockPanel Grid.Column="2">
        <supv:CrashBannerView DockPanel.Dock="Top" DataContext="{Binding Support.CrashBanner}" />
        <StackPanel x:Name="PageHeader" DockPanel.Dock="Top" Margin="24,16,24,2" Spacing="2">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="{Binding CurrentGroup.Name}" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource CuebotAccent}" />
            <TextBlock Text="/" FontSize="20" Classes="muted" VerticalAlignment="Center" />
            <TextBlock x:Name="PageTitle" Text="{Binding SelectedPage.Title}" FontSize="20" FontWeight="SemiBold" />
          </StackPanel>
          <TextBlock Text="{Binding PageDescription}" Classes="hint" FontSize="12.5" />
        </StackPanel>
        <ContentControl x:Name="PageHost" Content="{Binding SelectedPage}" />
      </DockPanel>
    </Grid>

    <!-- ===== Status bar ===== -->
    <Border x:Name="StatusBar" Grid.Row="2" Background="{DynamicResource CuebotRail}" BorderBrush="{DynamicResource CuebotLine}" BorderThickness="0,1,0,0">
      <DockPanel Margin="14,0" DataContext="{Binding Status}">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="16">
          <Button Classes="flat" Padding="2,0" Command="{Binding OpenProblemsCommand}" ToolTip.Tip="Open Support">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Ellipse Classes="status good" IsVisible="{Binding !HasWarnings}" />
              <Ellipse Classes="status warn" IsVisible="{Binding HasWarnings}" />
              <TextBlock Text="{Binding Problems}" />
            </StackPanel>
          </Button>
          <TextBlock Text="{Binding Clock}" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="18">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Ellipse Classes="status" Classes.good="{Binding AllConnected}" />
            <TextBlock Text="{Binding Connections}" />
          </StackPanel>
          <TextBlock Text="{Binding Counts}" />
          <TextBlock Text="{Binding Uptime}" />
        </StackPanel>
      </DockPanel>
    </Border>
  </Grid>
</Window>

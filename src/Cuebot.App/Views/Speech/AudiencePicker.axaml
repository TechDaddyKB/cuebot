<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sp="using:Cuebot.App.ViewModels.Speech"
             x:Class="Cuebot.App.Views.Speech.AudiencePicker"
             x:DataType="sp:AudienceViewModel">
  <!-- Who may do something in chat; the broadcaster always may. -->
  <WrapPanel Orientation="Horizontal">
    <WrapPanel.Styles>
      <Style Selector="CheckBox">
        <Setter Property="Margin" Value="0,0,14,0" />
        <Setter Property="MinHeight" Value="28" />
      </Style>
    </WrapPanel.Styles>
    <CheckBox Content="Everyone" IsChecked="{Binding Everyone}" ToolTip.Tip="Ticked: anyone in chat may. Untick it to pick only certain groups." />
    <CheckBox Content="Moderators" IsChecked="{Binding Moderators}" IsEnabled="{Binding IsRestricted}" ToolTip.Tip="Ticked: your chat moderators may." />
    <CheckBox Content="VIPs" IsChecked="{Binding Vips}" IsEnabled="{Binding IsRestricted}" ToolTip.Tip="Ticked: viewers with the VIP badge may." />
    <CheckBox Content="Subscribers" IsChecked="{Binding Subscribers}" IsEnabled="{Binding IsRestricted}" ToolTip.Tip="Ticked: your subscribers may." />
    <CheckBox Content="Regulars" IsChecked="{Binding Regulars}" IsEnabled="{Binding IsRestricted}" ToolTip.Tip="Ticked: viewers you marked as regulars (on the Users page) may." />
  </WrapPanel>
</UserControl>

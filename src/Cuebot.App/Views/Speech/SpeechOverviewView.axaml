<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sp="using:Cuebot.App.ViewModels.Speech"
             xmlns:c="using:Cuebot.App.Controls"
             x:Class="Cuebot.App.Views.Speech.SpeechOverviewView"
             x:DataType="sp:SpeechOverviewViewModel">
  <ScrollViewer>
    <Grid RowDefinitions="Auto,Auto" Margin="0,8,0,24">
      <!-- ===== Top: the speech queue · voices ===== -->
      <Grid ColumnDefinitions="3*,12,2*">
        <Border Classes="card" Margin="0">
          <DockPanel>
            <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,10">
              <TextBlock Text="Speech queue" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center" />
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                <ToggleButton Content="Pause" IsChecked="{Binding Paused}" ToolTip.Tip="Hold the queue; the current text finishes" />
                <Button Content="Skip" Command="{Binding SkipCommand}" ToolTip.Tip="Stop the current text" />
                <Button Content="Clear" Command="{Binding ClearQueueCommand}" ToolTip.Tip="Drop everything waiting" />
              </StackPanel>
            </Grid>

            <!-- Playing -->
            <Border DockPanel.Dock="Top" Classes="inset" Margin="0,0,0,10">
              <Grid ColumnDefinitions="Auto,*">
                <c:Icon Kind="volume-2" Width="18" Height="18" Margin="0,0,10,0" VerticalAlignment="Center"
                        Foreground="{DynamicResource CuebotAccent}" IsVisible="{Binding IsSpeaking}" />
                <StackPanel Grid.Column="1" Spacing="2">
                  <TextBlock Classes="label" Text="NOW SPEAKING" />
                  <TextBlock Text="{Binding CurrentText}" TextWrapping="Wrap" Classes.hint="{Binding !IsSpeaking}" />
                </StackPanel>
              </Grid>
            </Border>

            <TabControl x:Name="QueueTabs" MinHeight="240">
              <TabItem Header="{Binding QueueHeader}">
                <Panel>
                  <TextBlock Classes="hint" Text="Nothing is waiting." IsVisible="{Binding !HasQueue}" Margin="4,8" />
                  <ItemsControl x:Name="QueueList" ItemsSource="{Binding Queue}" IsVisible="{Binding HasQueue}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate DataType="sp:QueueItemViewModel">
                        <Grid ColumnDefinitions="*,Auto" Margin="0,3">
                          <StackPanel>
                            <TextBlock Text="{Binding Text}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Classes="hint" Text="{Binding Meta}" />
                          </StackPanel>
                          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <Button Content="Remove" ToolTip.Tip="Drop this text"
                                    Command="{Binding $parent[ItemsControl].((sp:SpeechOverviewViewModel)DataContext).RemoveQueuedCommand}"
                                    CommandParameter="{Binding}" />
                            <Button Content="Stop user" IsVisible="{Binding HasUser}"
                                    ToolTip.Tip="Drop everything this user has waiting"
                                    Command="{Binding $parent[ItemsControl].((sp:SpeechOverviewViewModel)DataContext).StopUserCommand}"
                                    CommandParameter="{Binding}" />
                          </StackPanel>
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </Panel>
              </TabItem>
              <TabItem Header="Spoken">
                <Panel>
                  <TextBlock Classes="hint" Text="Nothing has been spoken yet this session." IsVisible="{Binding !HasHistory}" Margin="4,8" />
                  <ItemsControl x:Name="HistoryList" ItemsSource="{Binding History}" IsVisible="{Binding HasHistory}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate DataType="sp:HistoryItemViewModel">
                        <Grid ColumnDefinitions="64,*" Margin="0,3">
                          <TextBlock Classes="mono hint" Text="{Binding Time}" />
                          <StackPanel Grid.Column="1">
                            <TextBlock Text="{Binding Text}" TextWrapping="Wrap" Classes.hint="{Binding Skipped}" />
                            <TextBlock Classes="hint" Text="{Binding Meta}" />
                          </StackPanel>
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </Panel>
              </TabItem>
            </TabControl>
          </DockPanel>
        </Border>

        <!-- Voices: pick one and preview it -->
        <Border Grid.Column="2" Classes="card" Margin="0">
          <DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="Voices" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,4" />
            <TextBlock DockPanel.Dock="Top" Classes="hint" Margin="0,0,0,8"
                       Text="Voice aliases chat and actions speak with. Add and tune them under Voice aliases." />
            <StackPanel DockPanel.Dock="Bottom" Spacing="8" Margin="0,10,0,0">
              <TextBlock Classes="label" Text="PREVIEW" />
              <TextBox x:Name="PreviewText" Text="{Binding TestText}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60" />
              <Button Classes="accent" Command="{Binding SpeakCommand}" HorizontalAlignment="Right">
                <StackPanel Orientation="Horizontal" Spacing="5">
                  <c:Icon Kind="play" Width="13" Height="13" />
                  <TextBlock Text="{Binding TestAlias, StringFormat='Speak with {0}'}" />
                </StackPanel>
              </Button>
              <TextBlock Classes="error" Text="{Binding Error}" TextWrapping="Wrap"
                         IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            </StackPanel>
            <ListBox x:Name="VoiceList" Classes="list" ItemsSource="{Binding AliasChoices}" SelectedItem="{Binding TestAlias}" MinHeight="140">
              <ListBox.ItemTemplate>
                <DataTemplate DataType="sp:Choice">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <c:Icon Kind="mic" Width="14" Height="14" Foreground="{DynamicResource CuebotMuted}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </DockPanel>
        </Border>
      </Grid>

      <!-- ===== Bottom row: behaviour · output ===== -->
      <Grid Grid.Row="1" ColumnDefinitions="*,12,*" Margin="0,12,0,0">
        <Border Classes="card" Margin="0">
          <StackPanel Spacing="10">
            <TextBlock Text="Behaviour" FontWeight="SemiBold" FontSize="15" />
            <ToggleSwitch x:Name="EnabledSwitch" Content="Speech enabled" IsChecked="{Binding Enabled}"
                          OnContent="On — texts are spoken" OffContent="Off — new texts are ignored" />
            <ToggleSwitch Content="Speak events (follows, subs, raids...)" IsChecked="{Binding EventsEnabled}" />
            <TextBlock Classes="hint" Text="Turning speech off stops the current text and clears the queue. Chat, commands and per-platform settings are under Chat &amp; commands." />
          </StackPanel>
        </Border>
        <Border Grid.Column="2" Classes="card" Margin="0">
          <StackPanel Spacing="8">
            <TextBlock Text="Output and routing" FontWeight="SemiBold" FontSize="15" />
            <TextBlock Classes="label" Text="{Binding MasterVolume, StringFormat='Master volume: {0:0}%'}" />
            <Slider Minimum="0" Maximum="100" Value="{Binding MasterVolume}" />
            <TextBlock Classes="label" Text="Output device" />
            <Grid ColumnDefinitions="*,8,Auto">
              <ComboBox ItemsSource="{Binding OutputDevices}" SelectedItem="{Binding OutputDevice}" />
              <Button Grid.Column="2" Content="Refresh" Command="{Binding RefreshDevicesCommand}" />
            </Grid>
            <TextBlock Classes="hint" Text="Aliases can pick their own device; the rest play here." />
          </StackPanel>
        </Border>
      </Grid>
    </Grid>
  </ScrollViewer>
</UserControl>

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Cuebot.App.ViewModels"
             xmlns:hvm="using:Cuebot.App.ViewModels.History"
             x:Class="Cuebot.App.Views.History.HistoryView"
             x:DataType="hvm:HistoryViewModel">
  <UserControl.Styles>
    <Style Selector="TextBlock.state">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.state.good">
      <Setter Property="Foreground" Value="{DynamicResource CuebotGood}" />
    </Style>
    <Style Selector="TextBlock.state.bad">
      <Setter Property="Foreground" Value="{DynamicResource CuebotBad}" />
    </Style>
    <Style Selector="TextBlock.state.active">
      <Setter Property="Foreground" Value="{DynamicResource CuebotAccent}" />
    </Style>
    <Style Selector="TextBlock.changed">
      <Setter Property="Foreground" Value="{DynamicResource CuebotAccent}" />
    </Style>
  </UserControl.Styles>
  <UserControl.DataTemplates>
    <DataTemplate DataType="vm:RunRowViewModel">
      <Grid ColumnDefinitions="86,*,170,110,70,70">
        <TextBlock Text="{Binding StateText}" Classes="state" Classes.good="{Binding IsDone}" Classes.bad="{Binding IsFailed}"
                   Classes.active="{Binding IsActive}" />
        <TextBlock Grid.Column="1" Text="{Binding ActionName}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
        <TextBlock Grid.Column="2" Text="{Binding Source}" Classes="muted" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
        <TextBlock Grid.Column="3" Text="{Binding Queue}" Classes="muted" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
        <TextBlock Grid.Column="4" Text="{Binding Queued}" Classes="muted" VerticalAlignment="Center" ToolTip.Tip="Queued at" />
        <TextBlock Grid.Column="5" Text="{Binding Duration}" Classes="muted" VerticalAlignment="Center" ToolTip.Tip="Run time" />
      </Grid>
    </DataTemplate>
    <DataTemplate DataType="hvm:RunArgRow">
      <Grid ColumnDefinitions="130,*">
        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Name}"
                   Classes.changed="{Binding Changed}" />
        <SelectableTextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap" />
      </Grid>
    </DataTemplate>
    <DataTemplate DataType="vm:NameValueRow">
      <Grid ColumnDefinitions="130,*">
        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Name}" />
        <SelectableTextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap" />
      </Grid>
    </DataTemplate>
    <DataTemplate DataType="hvm:TriggerEventRow">
      <Grid ColumnDefinitions="92,*">
        <TextBlock Text="{Binding Time}" Classes="muted" VerticalAlignment="Center" FontFamily="monospace" FontSize="12" />
        <StackPanel Grid.Column="1">
          <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Type}" />
          <TextBlock Text="{Binding Preview}" Classes="muted" FontSize="12" TextTrimming="CharacterEllipsis" />
        </StackPanel>
      </Grid>
    </DataTemplate>
  </UserControl.DataTemplates>

  <DockPanel Margin="24,24,24,16">
    <TextBlock DockPanel.Dock="Top" Classes="h1" Text="History" />
    <TabControl x:Name="Tabs" SelectedIndex="{Binding SelectedTab}" Padding="0,8,0,0">
      <!-- Action history -->
      <TabItem Header="Action history">
        <Grid ColumnDefinitions="*,12,360">
          <DockPanel>
            <Border DockPanel.Dock="Top" Classes="card" Padding="12,8" Margin="0,0,0,8">
              <DockPanel>
                <Button DockPanel.Dock="Right" Content="Open Queues" Command="{Binding OpenQueuesCommand}"
                        ToolTip.Tip="Pause, resume, clear queues and cancel pending runs on the Queues page" />
                <TextBlock Classes="muted" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,8,0">
                  <Run Text="Pending:" FontWeight="SemiBold" /><Run Text=" " /><Run Text="{Binding PendingSummary}" />
                </TextBlock>
              </DockPanel>
            </Border>
            <Grid DockPanel.Dock="Top" ColumnDefinitions="*,8,170,8,Auto" Margin="0,0,0,6">
              <TextBox x:Name="SearchBox" Text="{Binding Search}" PlaceholderText="Search action, trigger, queue, error or argument" />
              <ComboBox Grid.Column="2" ItemsSource="{Binding StateFilterOptions}" SelectedItem="{Binding StateFilter}"
                        HorizontalAlignment="Stretch" />
              <Button Grid.Column="4" Content="Clear history" Command="{Binding ClearHistoryCommand}" />
            </Grid>
            <TextBlock DockPanel.Dock="Top" Classes="muted" Text="{Binding Summary}" Margin="0,0,0,6" />
            <Grid DockPanel.Dock="Top" ColumnDefinitions="86,*,170,110,70,70" Margin="12,0,12,4">
              <TextBlock Classes="muted" Text="STATE" />
              <TextBlock Grid.Column="1" Classes="muted" Text="ACTION" />
              <TextBlock Grid.Column="2" Classes="muted" Text="TRIGGER" />
              <TextBlock Grid.Column="3" Classes="muted" Text="QUEUE" />
              <TextBlock Grid.Column="4" Classes="muted" Text="QUEUED" />
              <TextBlock Grid.Column="5" Classes="muted" Text="TIME" />
            </Grid>
            <ListBox x:Name="RunList" ItemsSource="{Binding Runs}" SelectedItem="{Binding SelectedRun}" />
          </DockPanel>

          <Border Grid.Column="2" Classes="card" Margin="0">
            <Grid>
              <TextBlock Classes="muted" IsVisible="{Binding !HasSelectedRun}" TextWrapping="Wrap" VerticalAlignment="Center"
                         HorizontalAlignment="Center" TextAlignment="Center" Text="Select a run to inspect its arguments" />
              <DockPanel IsVisible="{Binding HasSelectedRun}">
                <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="0,0,0,8">
                  <TextBlock Classes="h2" Text="{Binding SelectedTitle}" TextWrapping="Wrap" Margin="0" />
                  <TextBlock Classes="muted" Text="{Binding SelectedDetails}" TextWrapping="Wrap" />
                  <TextBlock Classes="error" Text="{Binding SelectedError}" TextWrapping="Wrap" IsVisible="{Binding HasSelectedError}" />
                  <WrapPanel ItemSpacing="8" LineSpacing="6">
                    <Button Content="Run again with these args" Classes="accent" Command="{Binding RunAgainCommand}"
                            ToolTip.Tip="Queue the action again with the arguments it had when this run was queued" />
                    <Button Content="Cancel run" Command="{Binding CancelRunCommand}" IsEnabled="{Binding CanCancelSelected}" />
                    <Button Content="Open action" Command="{Binding OpenActionCommand}" />
                  </WrapPanel>
                  <TextBlock Classes="muted" Text="{Binding Status}" TextWrapping="Wrap"
                             IsVisible="{Binding Status, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                </StackPanel>
                <ScrollViewer>
                  <StackPanel Spacing="6">
                    <TextBlock Text="Arguments when queued" FontWeight="SemiBold" />
                    <ItemsControl ItemsSource="{Binding ArgsWhenQueued}" />
                    <TextBlock Text="Arguments and variables after the run (added or changed in accent)" FontWeight="SemiBold"
                               Margin="0,10,0,0" TextWrapping="Wrap" IsVisible="{Binding HasArgsAfterRun}" />
                    <ItemsControl ItemsSource="{Binding ArgsAfterRun}" IsVisible="{Binding HasArgsAfterRun}" />
                  </StackPanel>
                </ScrollViewer>
              </DockPanel>
            </Grid>
          </Border>
        </Grid>
      </TabItem>

      <!-- Trigger viewer -->
      <TabItem Header="Trigger viewer">
        <Grid ColumnDefinitions="*,12,360">
          <DockPanel>
            <Grid DockPanel.Dock="Top" ColumnDefinitions="*,8,Auto,8,Auto" Margin="0,0,0,6">
              <TextBox Text="{Binding Triggers.Search}" PlaceholderText="Search event type, trigger or argument" />
              <ToggleButton Grid.Column="2" x:Name="PauseToggle" Content="Pause" IsChecked="{Binding Triggers.IsPaused}"
                            ToolTip.Tip="Stop recording new events (events still trigger actions)" />
              <Button Grid.Column="4" Content="Clear" Command="{Binding Triggers.ClearCommand}" />
            </Grid>
            <TextBlock DockPanel.Dock="Top" Classes="muted" Text="{Binding Triggers.Summary}" Margin="0,0,0,6" TextWrapping="Wrap" />
            <ListBox x:Name="EventList" ItemsSource="{Binding Triggers.Events}" SelectedItem="{Binding Triggers.SelectedEvent}" />
          </DockPanel>

          <Border Grid.Column="2" Classes="card" Margin="0">
            <Grid>
              <TextBlock Classes="muted" IsVisible="{Binding !Triggers.HasSelection}" TextWrapping="Wrap" VerticalAlignment="Center"
                         HorizontalAlignment="Center" TextAlignment="Center" Text="Select an event to see its arguments" />
              <DockPanel IsVisible="{Binding Triggers.HasSelection}">
                <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="0,0,0,8">
                  <TextBlock Classes="h2" Text="{Binding Triggers.SelectedTitle}" TextWrapping="Wrap" Margin="0" />
                  <TextBlock Classes="muted" Text="{Binding Triggers.SelectedSummary}" TextWrapping="Wrap" />
                  <StackPanel Spacing="6" IsVisible="{Binding Triggers.HasTriggerOptions}">
                    <ComboBox ItemsSource="{Binding Triggers.TriggerOptions}" SelectedItem="{Binding Triggers.SelectedTrigger}"
                              HorizontalAlignment="Stretch">
                      <ComboBox.ItemTemplate>
                        <DataTemplate DataType="hvm:TriggerTypeOption">
                          <TextBlock Text="{Binding Display}" />
                        </DataTemplate>
                      </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Button Content="Create action from this trigger" Classes="accent" Command="{Binding Triggers.CreateActionCommand}"
                            ToolTip.Tip="New action with this trigger (default settings), opened on the Actions page" />
                  </StackPanel>
                </StackPanel>
                <ScrollViewer>
                  <StackPanel Spacing="6">
                    <TextBlock Text="Arguments" FontWeight="SemiBold" />
                    <ItemsControl ItemsSource="{Binding Triggers.Args}" />
                  </StackPanel>
                </ScrollViewer>
              </DockPanel>
            </Grid>
          </Border>
        </Grid>
      </TabItem>
    </TabControl>
  </DockPanel>
</UserControl>

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Cuebot.App.ViewModels"
             xmlns:shell="using:Cuebot.App.Shell"
             x:Class="Cuebot.App.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">
  <Grid>
    <DockPanel Margin="24,24,24,0">
      <TextBlock DockPanel.Dock="Top" Classes="h1" Text="Settings" />
      <TabControl x:Name="Sections">
        <TabControl.Styles>
          <Style Selector="TabItem">
            <Setter Property="FontSize" Value="17" />
            <Setter Property="MinHeight" Value="40" />
          </Style>
        </TabControl.Styles>
        <TabItem Header="General">
          <ScrollViewer>
            <StackPanel MaxWidth="760" HorizontalAlignment="Left" Margin="0,12,0,24">
              <Border Classes="card">
                <StackPanel Spacing="10">
                  <TextBlock Classes="h2" Text="Window and tray" />
                  <CheckBox Content="Show an icon in the system tray" IsChecked="{Binding ShowTrayIcon}" />
                  <CheckBox Content="Closing the window keeps Cuebot running in the tray" IsChecked="{Binding CloseToTray}"
                            IsEnabled="{Binding ShowTrayIcon}" />
                  <CheckBox Content="Start minimized (same as --minimized)" IsChecked="{Binding StartMinimized}" />
                  <TextBlock Classes="muted" TextWrapping="Wrap" Text="{Binding TrayStatus}" />
                </StackPanel>
              </Border>
              <Border Classes="card">
                <StackPanel Spacing="10">
                  <TextBlock Classes="h2" Text="Appearance" />
                  <StackPanel Orientation="Horizontal" Spacing="12">
                    <TextBlock Text="Theme" VerticalAlignment="Center" />
                    <ComboBox x:Name="ThemePicker" ItemsSource="{Binding Themes}" SelectedItem="{Binding Theme}" MinWidth="160" />
                  </StackPanel>
                  <TextBlock Classes="muted" TextWrapping="Wrap" Text="System follows the desktop's light or dark preference." />
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </TabItem>

        <TabItem Header="Audio &amp; text">
          <ScrollViewer>
            <StackPanel MaxWidth="760" HorizontalAlignment="Left" Margin="0,12,0,24">
              <Border Classes="card">
                <StackPanel Spacing="10">
                  <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Refresh" Command="{Binding RefreshAudioCommand}" />
                    <TextBlock Classes="h2" Text="Audio" VerticalAlignment="Center" Margin="0" />
                  </DockPanel>
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Classes="muted" Text="Backend" VerticalAlignment="Center" Width="120" FontSize="14" />
                    <TextBlock Text="{Binding AudioBackend}" FontWeight="SemiBold" />
                  </StackPanel>
                  <TextBlock Classes="muted" Text="{Binding AudioStatus}"
                             IsVisible="{Binding AudioStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                  <TextBlock Classes="error" Text="{Binding AudioError}"
                             IsVisible="{Binding AudioError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                  <Grid ColumnDefinitions="*,16,*">
                    <StackPanel Spacing="4">
                      <TextBlock Text="Output devices" FontWeight="SemiBold" />
                      <ItemsControl ItemsSource="{Binding OutputDevices}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="x:String">
                            <TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis" Margin="0,2" />
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Spacing="4">
                      <TextBlock Text="Input devices" FontWeight="SemiBold" />
                      <ItemsControl ItemsSource="{Binding InputDevices}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="x:String">
                            <TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis" Margin="0,2" />
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </Grid>
                  <TextBlock Classes="muted" TextWrapping="Wrap"
                             Text="Sound and speech sub-actions pick a device by name; blank uses the default device." />
                </StackPanel>
              </Border>
              <Border Classes="card">
                <StackPanel Spacing="10">
                  <TextBlock Classes="h2" Text="Text formatting" />
                  <StackPanel Orientation="Horizontal" Spacing="12">
                    <TextBlock Text="Culture" VerticalAlignment="Center" />
                    <ComboBox x:Name="CulturePicker" ItemsSource="{x:Static vm:SettingsViewModel.CultureOptions}"
                              SelectedItem="{Binding TextCulture}" Width="420">
                      <ComboBox.ItemTemplate>
                        <DataTemplate DataType="vm:CultureOption">
                          <TextBlock Text="{Binding Display}" />
                        </DataTemplate>
                      </ComboBox.ItemTemplate>
                    </ComboBox>
                  </StackPanel>
                  <SelectableTextBlock Text="{Binding CulturePreview}" FontFamily="monospace" FontSize="12" TextWrapping="Wrap" />
                  <TextBlock Classes="muted" TextWrapping="Wrap"
                             Text="Used by format specifiers such as %amount:c2% and by %date% / %time%. Values without a format are always written culture-neutral (5.5, true)." />
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </TabItem>

        <TabItem Header="Backups">
          <DockPanel Margin="0,12,0,24" MaxWidth="900" HorizontalAlignment="Left">
            <Border DockPanel.Dock="Top" Classes="card">
              <StackPanel Spacing="10">
                <TextBlock Classes="h2" Text="Automatic backups" />
                <CheckBox Content="Back up the data folder every time Cuebot starts" IsChecked="{Binding BackupOnStart}" />
                <CheckBox Content="Back up before an import replaces data" IsChecked="{Binding BackupBeforeImport}" />
                <StackPanel Orientation="Horizontal" Spacing="12">
                  <TextBlock Text="Keep the newest" VerticalAlignment="Center" />
                  <NumericUpDown Value="{Binding BackupKeep}" Minimum="1" Maximum="1000" Increment="1" FormatString="0" Width="140" />
                  <TextBlock Text="backups" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Classes="muted" TextWrapping="Wrap"
                           Text="Backups are zip files of the data folder. Logs and the downloaded Python runtime are not included." />
              </StackPanel>
            </Border>
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
              <Button Content="Back up now" Classes="accent" Command="{Binding BackUpNowCommand}" />
              <Button Content="Open folder" Command="{Binding OpenBackupFolderCommand}" ToolTip.Tip="{Binding BackupFolder}" />
              <Button Content="Restore..." Command="{Binding RestoreCommand}" />
              <TextBlock Text="{Binding BackupStatus}" Classes="muted" VerticalAlignment="Center" Margin="8,0,0,0" />
            </StackPanel>
            <Border DockPanel.Dock="Top" Classes="card" IsVisible="{Binding PendingRestore, Converter={x:Static ObjectConverters.IsNotNull}}">
              <StackPanel Orientation="Horizontal" Spacing="12">
                <TextBlock Text="{Binding PendingRestore}" VerticalAlignment="Center" TextWrapping="Wrap" />
                <Button Content="Cancel restore" Command="{Binding CancelPendingRestoreCommand}" />
              </StackPanel>
            </Border>
            <TextBlock DockPanel.Dock="Top" Classes="muted" Text="{Binding BackupsSummary}" Margin="0,0,0,6" />
            <ListBox ItemsSource="{Binding Backups}" SelectedItem="{Binding SelectedBackup}" MinHeight="120">
              <ListBox.ItemTemplate>
                <DataTemplate DataType="vm:BackupRowViewModel">
                  <Grid ColumnDefinitions="170,120,90,*">
                    <TextBlock Text="{Binding Created}" />
                    <TextBlock Grid.Column="1" Text="{Binding Reason}" Classes="muted" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2" Text="{Binding Size}" Classes="muted" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="3" Text="{Binding Name}" Classes="muted" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </DockPanel>
        </TabItem>

        <TabItem Header="Google Drive">
          <DockPanel Margin="0,12,0,24" MaxWidth="900" HorizontalAlignment="Left">
            <Border DockPanel.Dock="Top" Classes="card">
              <StackPanel Spacing="10">
                <TextBlock Classes="h2" Text="Google Drive backups" />
                <TextBlock Classes="muted" TextWrapping="Wrap"
                           Text="Copies every backup to a &quot;Cuebot Backups&quot; folder in your Google Drive. Cuebot only sees the files it created there." />
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button Content="Sign in with Google" Classes="accent" Command="{Binding DriveSignInCommand}"
                          IsVisible="{Binding !DriveSignedIn}" />
                  <Button Content="Cancel sign-in" Command="{Binding DriveSignInCancelCommand}"
                          IsVisible="{Binding DriveSignInCommand.IsRunning}" />
                  <Button Content="Sign out" Command="{Binding DriveSignOutCommand}" IsVisible="{Binding DriveSignedIn}" />
                  <TextBlock Text="{Binding DriveAccount}" VerticalAlignment="Center" FontWeight="SemiBold" Margin="8,0,0,0" />
                </StackPanel>
                <Expander Header="Advanced: use my own Google Cloud project" HorizontalAlignment="Stretch"
                          IsExpanded="{Binding DriveShowOwnApp, Mode=OneTime}">
                  <StackPanel Spacing="8">
                    <TextBlock Classes="muted" TextWrapping="Wrap"
                               Text="Optional unless this build has no Google app of its own. In Google Cloud, enable the Drive API and create an OAuth client of type &quot;Desktop app&quot;, then paste its ID and secret here and sign in again (see the docs). Leave them empty to use Cuebot's." />
                    <Grid ColumnDefinitions="130,*" RowDefinitions="Auto,Auto" RowSpacing="8">
                      <TextBlock Text="Client ID" VerticalAlignment="Center" />
                      <TextBox x:Name="DriveClientId" Grid.Column="1" Text="{Binding DriveClientId}"
                               PlaceholderText="1234567890-abc.apps.googleusercontent.com" />
                      <TextBlock Grid.Row="1" Text="Client secret" VerticalAlignment="Center" />
                      <TextBox x:Name="DriveClientSecret" Grid.Row="1" Grid.Column="1" Text="{Binding DriveClientSecret}" PasswordChar="•"
                               PlaceholderText="GOCSPX-..." />
                    </Grid>
                  </StackPanel>
                </Expander>
                <CheckBox Content="Upload every new backup to Google Drive" IsChecked="{Binding DriveEnabled}" />
                <StackPanel Orientation="Horizontal" Spacing="12">
                  <TextBlock Text="Keep the newest" VerticalAlignment="Center" />
                  <NumericUpDown Value="{Binding DriveKeep}" Minimum="1" Maximum="1000" Increment="1" FormatString="0" Width="140" />
                  <TextBlock Text="backups on Google Drive" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Classes="muted" TextWrapping="Wrap"
                           Text="Backups contain your settings, including the sign-ins of connected accounts. Your Google Drive sign-in is kept when you restore a backup." />
              </StackPanel>
            </Border>
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
              <Button Content="Upload now" Command="{Binding DriveUploadCommand}"
                      ToolTip.Tip="Uploads the backup selected on the Backups tab, or the newest one" />
              <Button Content="Refresh" Command="{Binding DriveRefreshCommand}" />
              <Button Content="Restore..." Command="{Binding DriveRestoreCommand}" />
              <TextBlock Text="{Binding DriveStatus}" Classes="muted" VerticalAlignment="Center" Margin="8,0,0,0" TextWrapping="Wrap" />
            </StackPanel>
            <TextBlock DockPanel.Dock="Top" Classes="error" Text="{Binding DriveError}" TextWrapping="Wrap" Margin="0,0,0,6"
                       IsVisible="{Binding DriveError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            <TextBlock DockPanel.Dock="Top" Classes="muted" Text="{Binding DriveSummary}" Margin="0,0,0,6" />
            <ListBox x:Name="RemoteBackupList" ItemsSource="{Binding RemoteBackups}" SelectedItem="{Binding SelectedRemoteBackup}" MinHeight="120">
              <ListBox.ItemTemplate>
                <DataTemplate DataType="vm:RemoteBackupRowViewModel">
                  <Grid ColumnDefinitions="170,120,90,*">
                    <TextBlock Text="{Binding Created}" />
                    <TextBlock Grid.Column="1" Text="{Binding Reason}" Classes="muted" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2" Text="{Binding Size}" Classes="muted" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="3" Text="{Binding Name}" Classes="muted" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </DockPanel>
        </TabItem>

        <TabItem Header="About">
          <ScrollViewer>
            <StackPanel MaxWidth="760" HorizontalAlignment="Left" Margin="0,12,0,24">
              <Border Classes="card">
                <Grid ColumnDefinitions="140,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto">
                  <TextBlock Classes="muted" Text="Version" Margin="0,4" />
                  <TextBlock Grid.Column="1" Text="{Binding Version}" Margin="0,4" />
                  <TextBlock Grid.Row="1" Classes="muted" Text="Data folder" Margin="0,4" VerticalAlignment="Center" />
                  <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="8" Margin="0,4">
                    <SelectableTextBlock Text="{Binding DataFolder}" VerticalAlignment="Center" />
                    <Button Content="Open" Command="{Binding OpenDataFolderCommand}" Padding="8,2" />
                  </StackPanel>
                  <TextBlock Grid.Row="2" Classes="muted" Text="Display backend" Margin="0,4" />
                  <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding DisplayBackend}" Margin="0,4" />
                  <TextBlock Grid.Row="3" Classes="muted" Text="Runtime" Margin="0,4" />
                  <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Runtime}" Margin="0,4" />
                  <TextBlock Grid.Row="4" Classes="muted" Text="System" Margin="0,4" />
                  <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding OsDescription}" Margin="0,4" TextWrapping="Wrap" />
                  <TextBlock Grid.Row="5" Classes="muted" Text="License" Margin="0,4" />
                  <TextBlock Grid.Row="5" Grid.Column="1" Margin="0,4" TextWrapping="Wrap"
                             Text="MIT. Cuebot is a clean-room project, not affiliated with Streamer.bot or Speaker.bot." />
                </Grid>
              </Border>
              <Border Classes="card">
                <StackPanel Spacing="6">
                  <TextBlock Classes="h2" Text="Startup switches" />
                  <SelectableTextBlock FontFamily="monospace" FontSize="12" TextWrapping="Wrap"
                                       Text="--headless   --minimized   --data &lt;folder&gt;   --reset-window   --backend=wayland|x11" />
                </StackPanel>
              </Border>
              <Border Classes="card">
                <StackPanel Spacing="6">
                  <TextBlock Classes="h2" Text="Keyboard shortcuts" />
                  <ItemsControl x:Name="ShortcutList" ItemsSource="{x:Static shell:AppShortcuts.All}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="shell:AppShortcut">
                        <Grid ColumnDefinitions="170,*,110" Margin="0,2">
                          <TextBlock Text="{Binding Gesture}" FontFamily="monospace" FontSize="12" VerticalAlignment="Center" />
                          <TextBlock Grid.Column="1" Text="{Binding Description}" TextWrapping="Wrap" />
                          <TextBlock Grid.Column="2" Text="{Binding Where}" Classes="muted" FontSize="12" VerticalAlignment="Center" />
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <TextBlock Classes="muted" TextWrapping="Wrap"
                             Text="The Ctrl+Alt shortcuts are ignored while typing in a text field (AltGr types characters there). Page shortcuts work when the page's lists have focus." />
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </TabItem>
      </TabControl>
    </DockPanel>

    <!-- Restore confirmation -->
    <Border IsVisible="{Binding IsConfirmingRestore}" Background="{DynamicResource CuebotOverlay}">
      <Border Classes="card" Width="520" HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel Spacing="12">
          <TextBlock Classes="h2" Text="Restore this backup?" />
          <TextBlock TextWrapping="Wrap" Classes="muted" Text="{Binding RestoreTargetName}" />
          <TextBlock TextWrapping="Wrap"
                     Text="Your current data is replaced by the backup's. A safety backup of the current data is made first, so this can be undone by restoring that one. The restore is applied while Cuebot restarts." />
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button Content="Cancel" Command="{Binding CancelRestoreCommand}" />
            <Button Content="On next start" Command="{Binding ConfirmRestoreCommand}" CommandParameter="false" />
            <Button Content="Restore and restart" Classes="accent" Command="{Binding ConfirmRestoreCommand}" CommandParameter="true"
                    IsVisible="{Binding CanRestart}" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Border>
  </Grid>
</UserControl>

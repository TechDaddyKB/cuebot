<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sv="using:Cuebot.App.ViewModels.Servers"
             xmlns:sviews="using:Cuebot.App.Views.Servers"
             x:Class="Cuebot.App.Views.Servers.ServersView"
             x:DataType="sv:ServersViewModel"
             x:Name="Root">
  <Grid ColumnDefinitions="320,12,*" Margin="24,12,24,0">
    <!-- Servers and their state, with Apply -->
    <ScrollViewer Padding="0,0,0,24">
      <StackPanel Spacing="10">
        <Border Classes="card" Margin="0">
          <StackPanel Spacing="6">
            <TextBlock Text="Servers" FontWeight="SemiBold" FontSize="15" />
            <ItemsControl x:Name="StatusList" ItemsSource="{Binding Statuses}">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="sv:ServerStatusViewModel">
                  <Grid ColumnDefinitions="Auto,*" Margin="0,4">
                    <Ellipse Classes="status" Classes.good="{Binding IsRunning}" Classes.bad="{Binding IsError}" VerticalAlignment="Top" Margin="0,5,10,0" />
                    <StackPanel Grid.Column="1">
                      <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
                      <TextBlock Text="{Binding Text}" Classes="muted" FontSize="12" TextWrapping="Wrap" />
                    </StackPanel>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>
        <Button Content="Apply and restart servers" Classes="accent" Command="{Binding ApplyCommand}" HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Center" />
        <TextBlock Text="Settings changed: press Apply to restart the servers." Foreground="{DynamicResource CuebotAccent}"
                   TextWrapping="Wrap" IsVisible="{Binding HasPendingChanges}" />
        <TextBlock Classes="muted" Text="{Binding Message}" TextWrapping="Wrap"
                   IsVisible="{Binding Message, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        <TextBlock Classes="muted" TextWrapping="Wrap" FontSize="12"
                   Text="Local APIs for overlays, stream decks and other tools. Streamer.bot and Speaker.bot compatible: tools built for them connect to Cuebot instead. Every server is off until you enable it, and listens only on this computer unless you allow LAN access." />
      </StackPanel>
    </ScrollViewer>

    <!-- Settings -->
    <ScrollViewer Grid.Column="2" Padding="0,0,8,24">
      <StackPanel MaxWidth="980" HorizontalAlignment="Left">
        <!-- Network -->
        <Border Classes="card">
          <StackPanel Spacing="8">
            <TextBlock Classes="h2" Text="Network and security" />
            <CheckBox Content="Allow LAN connections (servers may listen on 0.0.0.0 or a LAN address)" IsChecked="{Binding AllowLan}" />
            <TextBlock Classes="muted" TextWrapping="Wrap"
                       Text="Web pages from other sites cannot use these APIs. Pages on this computer, OBS local files and apps (Stream Deck plugins, scripts) always can. Allow extra web origins here, one per line (e.g. https://my-overlays.example), or * for any." />
            <TextBox Text="{Binding AllowedOrigins}" AcceptsReturn="True" MinHeight="60" PlaceholderText="https://my-overlays.example" />
          </StackPanel>
        </Border>

        <!-- Streamer.bot WebSocket -->
        <Border Classes="card">
          <StackPanel Spacing="8">
            <TextBlock Classes="h2" Text="WebSocket server (Streamer.bot API)" />
            <TextBlock Classes="muted" TextWrapping="Wrap"
                       Text="For @streamerbot/client overlays, decks and tools: requests (DoAction, GetActions, GetGlobals...) and live events." />
            <CheckBox Content="Enabled" IsChecked="{Binding WebSocketEnabled}" />
            <Grid ColumnDefinitions="*,12,140,12,*" RowDefinitions="Auto,Auto">
              <TextBlock Text="Address" />
              <TextBlock Grid.Column="2" Text="Port" />
              <TextBlock Grid.Column="4" Text="Endpoint" />
              <TextBox Grid.Row="1" Text="{Binding WebSocketAddress}" />
              <NumericUpDown Grid.Row="1" Grid.Column="2" Value="{Binding WebSocketPort}" Minimum="1" Maximum="65535" FormatString="0" />
              <TextBox Grid.Row="1" Grid.Column="4" Text="{Binding WebSocketEndpoint}" />
            </Grid>
            <CheckBox Content="Require a password (Streamer.bot authentication)" IsChecked="{Binding WebSocketAuth}" />
            <StackPanel Spacing="8" IsVisible="{Binding WebSocketAuth}">
              <TextBox Text="{Binding WebSocketPassword}" PasswordChar="•" PlaceholderText="Password" />
              <CheckBox Content="Require it for every request (otherwise only for DoAction, SendMessage and other privileged requests)"
                        IsChecked="{Binding WebSocketEnforce}" />
            </StackPanel>
            <TextBlock Text="Connected clients" FontWeight="SemiBold" Margin="0,4,0,0" />
            <TextBlock Classes="muted" Text="None" IsVisible="{Binding !Clients.Count}" />
            <ItemsControl ItemsSource="{Binding Clients}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="x:String">
                  <TextBlock Text="{Binding}" FontSize="13" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

        <!-- Overlays -->
        <Border Classes="card">
          <StackPanel Spacing="8">
            <TextBlock Classes="h2" Text="Overlay server" />
            <TextBlock Classes="muted" TextWrapping="Wrap"
                       Text="Serves your Cuebot overlays to OBS browser sources. Each overlay has its own secret link on the Overlays &amp; Widgets page; with LAN access on, other computers on your network can load overlays too." />
            <CheckBox Content="Enabled" IsChecked="{Binding OverlaysEnabled}" />
            <Grid ColumnDefinitions="*,12,140,12,140" RowDefinitions="Auto,Auto">
              <TextBlock Text="Address" />
              <TextBlock Grid.Column="2" Text="Port" />
              <TextBlock Grid.Column="4" Text="Widget port" />
              <TextBox Grid.Row="1" Text="{Binding OverlaysAddress}" />
              <NumericUpDown Grid.Row="1" Grid.Column="2" Value="{Binding OverlaysPort}" Minimum="1" Maximum="65535" FormatString="0" />
              <NumericUpDown Grid.Row="1" Grid.Column="4" Value="{Binding OverlaysWidgetPort}" Minimum="1" Maximum="65535" FormatString="0"
                             ToolTip.Tip="Widgets load from this second port, so they cannot reach the overlay page or Cuebot" />
            </Grid>
          </StackPanel>
        </Border>

        <!-- HTTP -->
        <Border Classes="card">
          <StackPanel Spacing="8">
            <TextBlock Classes="h2" Text="HTTP server" />
            <TextBlock Classes="muted" TextWrapping="Wrap"
                       Text="POST /api/DoAction, GET /api/GetActions and friends, your overlay folders, and two OBS docks (combined chat and activity feed). The docks need the WebSocket server too." />
            <CheckBox Content="Enabled" IsChecked="{Binding HttpEnabled}" />
            <Grid ColumnDefinitions="*,12,140" RowDefinitions="Auto,Auto">
              <TextBlock Text="Address" />
              <TextBlock Grid.Column="2" Text="Port" />
              <TextBox Grid.Row="1" Text="{Binding HttpAddress}" />
              <NumericUpDown Grid.Row="1" Grid.Column="2" Value="{Binding HttpPort}" Minimum="1" Maximum="65535" FormatString="0" />
            </Grid>
            <TextBlock Text="OBS docks" FontWeight="SemiBold" Margin="0,4,0,0" />
            <ItemsControl ItemsSource="{Binding DockUrls}">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="sv:DockUrlViewModel">
                  <Grid ColumnDefinitions="140,*,8,Auto" Margin="0,2">
                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                    <SelectableTextBlock Grid.Column="1" Text="{Binding Url}" VerticalAlignment="Center" />
                    <Button Grid.Column="3" Content="Copy" Click="OnCopyUrl" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap"
                       Text="In OBS: Docks → Custom Browser Docks, or add a Browser source. Add ?transparent=1 for a transparent background, ?password=... if the WebSocket server needs one." />
            <DockPanel Margin="0,4,0,0">
              <Button DockPanel.Dock="Right" Content="+ Folder" Command="{Binding AddMappingCommand}" />
              <TextBlock Text="Static files (URL path → folder or file)" FontWeight="SemiBold" VerticalAlignment="Center" />
            </DockPanel>
            <ItemsControl ItemsSource="{Binding Mappings}">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="sv:HttpMappingViewModel">
                  <Grid ColumnDefinitions="180,8,*,8,Auto" Margin="0,2">
                    <TextBox Text="{Binding Path}" PlaceholderText="/overlays" />
                    <TextBox Grid.Column="2" Text="{Binding Folder}" PlaceholderText="Folder or file" />
                    <Button Grid.Column="4" Content="Remove" Command="{Binding RemoveCommand}" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

        <!-- UDP -->
        <Border Classes="card">
          <StackPanel Spacing="8">
            <TextBlock Classes="h2" Text="UDP server" />
            <TextBlock Classes="muted" TextWrapping="Wrap"
                       Text="Runs actions from datagrams like {&quot;action&quot;:{&quot;name&quot;:&quot;My action&quot;},&quot;args&quot;:{}} (VoiceAttack, AutoHotkey...)." />
            <CheckBox Content="Enabled" IsChecked="{Binding UdpEnabled}" />
            <Grid ColumnDefinitions="*,12,140" RowDefinitions="Auto,Auto">
              <TextBlock Text="Address" />
              <TextBlock Grid.Column="2" Text="Port" />
              <TextBox Grid.Row="1" Text="{Binding UdpAddress}" />
              <NumericUpDown Grid.Row="1" Grid.Column="2" Value="{Binding UdpPort}" Minimum="1" Maximum="65535" FormatString="0" />
            </Grid>
          </StackPanel>
        </Border>

        <!-- Speaker.bot -->
        <Border Classes="card">
          <StackPanel Spacing="8">
            <TextBlock Classes="h2" Text="Speaker.bot API" />
            <TextBlock Classes="muted" TextWrapping="Wrap"
                       Text="Lets tools written for Speaker.bot (including Streamer.bot's Speaker.bot integration) drive Cuebot's text-to-speech: speak with a voice alias, stop, pause, enable..." />
            <WrapPanel ItemSpacing="16">
              <CheckBox Content="WebSocket API" IsChecked="{Binding SpeakerWebSocketEnabled}" />
              <CheckBox Content="UDP API" IsChecked="{Binding SpeakerUdpEnabled}" />
            </WrapPanel>
            <Grid ColumnDefinitions="*,12,140,12,140" RowDefinitions="Auto,Auto">
              <TextBlock Text="Address" />
              <TextBlock Grid.Column="2" Text="WebSocket port" />
              <TextBlock Grid.Column="4" Text="UDP port" />
              <TextBox Grid.Row="1" Text="{Binding SpeakerAddress}" />
              <NumericUpDown Grid.Row="1" Grid.Column="2" Value="{Binding SpeakerWebSocketPort}" Minimum="1" Maximum="65535" FormatString="0" />
              <NumericUpDown Grid.Row="1" Grid.Column="4" Value="{Binding SpeakerUdpPort}" Minimum="1" Maximum="65535" FormatString="0" />
            </Grid>
          </StackPanel>
        </Border>

        <!-- REST API -->
        <Border Classes="card">
          <StackPanel Spacing="8">
            <TextBlock Classes="h2" Text="REST API" />
            <TextBlock Classes="muted" TextWrapping="Wrap"
                       Text="Manage actions, commands, timers and variables from scripts and other apps: JSON over HTTP at /api/v1, described by /api/v1/openapi.json, with live events at /api/v1/events. Every request needs the token below (Authorization: Bearer ...)." />
            <CheckBox Content="Enabled" IsChecked="{Binding ApiEnabled}" />
            <Grid ColumnDefinitions="*,12,140" RowDefinitions="Auto,Auto">
              <TextBlock Text="Address" />
              <TextBlock Grid.Column="2" Text="Port (shared with MCP)" />
              <TextBox Grid.Row="1" Text="{Binding ApiAddress}" />
              <NumericUpDown Grid.Row="1" Grid.Column="2" Value="{Binding ApiPort}" Minimum="1" Maximum="65535" FormatString="0" />
            </Grid>
            <Grid ColumnDefinitions="140,*,8,Auto">
              <TextBlock Text="API URL" VerticalAlignment="Center" />
              <SelectableTextBlock Grid.Column="1" Text="{Binding ApiUrl}" VerticalAlignment="Center" />
              <Button Grid.Column="3" Content="Copy" Tag="apiUrl" Click="OnCopyText" />
            </Grid>
            <Grid ColumnDefinitions="140,*,8,Auto,8,Auto,8,Auto">
              <TextBlock Text="Token" VerticalAlignment="Center" />
              <SelectableTextBlock Grid.Column="1" Text="{Binding TokenDisplay}" VerticalAlignment="Center" FontFamily="monospace" TextWrapping="Wrap" />
              <ToggleButton Grid.Column="3" Content="Show" IsChecked="{Binding ShowToken}" />
              <Button Grid.Column="5" Content="Copy" Tag="token" Click="OnCopyText" />
              <Button Grid.Column="7" Content="Regenerate" Command="{Binding RegenerateTokenCommand}" />
            </Grid>
            <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap"
                       Text="Treat the token like a password: anyone with it can change and run your actions. Regenerate it if it leaks. Platform logins (Twitch, YouTube...) are never available through the API." />
          </StackPanel>
        </Border>

        <!-- MCP -->
        <Border Classes="card">
          <StackPanel Spacing="8">
            <TextBlock Classes="h2" Text="MCP server (AI assistants)" />
            <TextBlock Classes="muted" TextWrapping="Wrap"
                       Text="Lets the AI of your choice manage Cuebot through the Model Context Protocol: list and build actions, look up triggers and sub-actions, create commands and timers, run and troubleshoot actions. Uses the API port and token." />
            <CheckBox Content="Enabled" IsChecked="{Binding McpEnabled}" />
            <CheckBox Content="Confirm destructive tools (delete, import, send chat): the AI has to ask you and pass back a confirmation token"
                      IsChecked="{Binding McpRequireConfirmation}" />
            <Grid ColumnDefinitions="140,*,8,Auto">
              <TextBlock Text="MCP URL" VerticalAlignment="Center" />
              <SelectableTextBlock Grid.Column="1" Text="{Binding McpUrl}" VerticalAlignment="Center" />
              <Button Grid.Column="3" Content="Copy" Tag="mcpUrl" Click="OnCopyText" />
            </Grid>

            <DockPanel Margin="0,4,0,0">
              <Button DockPanel.Dock="Right" Content="Copy" Tag="claude" Click="OnCopyText" />
              <TextBlock Text="Claude Code (terminal)" FontWeight="SemiBold" VerticalAlignment="Center" />
            </DockPanel>
            <SelectableTextBlock Text="{Binding ClaudeCodeCommand}" FontFamily="monospace" FontSize="12" TextWrapping="Wrap" />

            <DockPanel Margin="0,4,0,0">
              <Button DockPanel.Dock="Right" Content="Copy" Tag="stdio" Click="OnCopyText" />
              <TextBlock Text="Claude Desktop and other apps that start an MCP process (stdio)" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap" />
            </DockPanel>
            <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap"
                       Text="Add this to the app's MCP config (Claude Desktop: Settings → Developer → Edit Config). It starts 'Cuebot --mcp-stdio', which connects to this running Cuebot, so keep Cuebot open with MCP enabled." />
            <SelectableTextBlock Text="{Binding StdioConfigJson}" FontFamily="monospace" FontSize="12" TextWrapping="Wrap" />

            <DockPanel Margin="0,4,0,0">
              <Button DockPanel.Dock="Right" Content="Copy" Tag="http" Click="OnCopyText" />
              <TextBlock Text="Other clients with HTTP support (.mcp.json and similar)" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap" />
            </DockPanel>
            <SelectableTextBlock Text="{Binding HttpConfigJson}" FontFamily="monospace" FontSize="12" TextWrapping="Wrap" />
            <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap"
                       Text="The token is hidden in these snippets unless Show is on; Copy always copies the complete snippet including the token." />
          </StackPanel>
        </Border>

        <!-- Remote instances (other Cuebots, over the REST API listener) -->
        <Panel IsVisible="{Binding Remote, Converter={x:Static ObjectConverters.IsNotNull}}">
          <sviews:RemoteInstancesView DataContext="{Binding Remote}" />
        </Panel>

        <!-- Custom servers -->
        <Border Classes="card">
          <StackPanel Spacing="8">
            <DockPanel>
              <Button DockPanel.Dock="Right" Content="+ Server" Command="{Binding AddCustomServerCommand}" />
              <TextBlock Classes="h2" Text="Custom WebSocket servers" VerticalAlignment="Center" />
            </DockPanel>
            <TextBlock Classes="muted" TextWrapping="Wrap"
                       Text="Your own WebSocket endpoints. Triggers: Custom server connection opened / message / closed. Sub-action: Custom server: send message." />
            <ItemsControl ItemsSource="{Binding CustomServers}">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="sv:CustomServerViewModel">
                  <Border BorderBrush="{DynamicResource CuebotCardBorder}" BorderThickness="0,1,0,0" Padding="0,8">
                    <StackPanel Spacing="6">
                      <Grid ColumnDefinitions="*,8,*,8,110,8,*">
                        <TextBox Text="{Binding Name}" PlaceholderText="Name" />
                        <TextBox Grid.Column="2" Text="{Binding Address}" PlaceholderText="127.0.0.1" />
                        <NumericUpDown Grid.Column="4" Value="{Binding Port}" Minimum="1" Maximum="65535" FormatString="0" />
                        <TextBox Grid.Column="6" Text="{Binding Endpoint}" PlaceholderText="/" />
                      </Grid>
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <CheckBox Content="Start with Cuebot" IsChecked="{Binding AutoStart}" />
                        <Button Content="Start / stop" Command="{Binding ToggleCommand}" />
                        <Button Content="Remove" Command="{Binding RemoveCommand}" />
                        <Ellipse Classes="status" Classes.good="{Binding IsRunning}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" Classes="muted" />
                      </StackPanel>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

        <!-- Custom clients -->
        <Border Classes="card">
          <StackPanel Spacing="8">
            <DockPanel>
              <Button DockPanel.Dock="Right" Content="+ Client" Command="{Binding AddCustomClientCommand}" />
              <TextBlock Classes="h2" Text="WebSocket clients" VerticalAlignment="Center" />
            </DockPanel>
            <TextBlock Classes="muted" TextWrapping="Wrap"
                       Text="Connections from Cuebot to other WebSocket servers. Triggers: Client connected / message / disconnected. Sub-actions: Client: send message, Client: connect / disconnect." />
            <ItemsControl ItemsSource="{Binding CustomClients}">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="sv:CustomClientViewModel">
                  <Border BorderBrush="{DynamicResource CuebotCardBorder}" BorderThickness="0,1,0,0" Padding="0,8">
                    <StackPanel Spacing="6">
                      <Grid ColumnDefinitions="200,8,*">
                        <TextBox Text="{Binding Name}" PlaceholderText="Name" />
                        <TextBox Grid.Column="2" Text="{Binding Url}" PlaceholderText="ws://127.0.0.1:9000/" />
                      </Grid>
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <CheckBox Content="Connect with Cuebot" IsChecked="{Binding AutoConnect}" />
                        <CheckBox Content="Reconnect" IsChecked="{Binding AutoReconnect}" />
                        <Button Content="Connect / disconnect" Command="{Binding ToggleCommand}" />
                        <Button Content="Remove" Command="{Binding RemoveCommand}" />
                        <Ellipse Classes="status" Classes.good="{Binding IsConnected}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" Classes="muted" />
                      </StackPanel>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>

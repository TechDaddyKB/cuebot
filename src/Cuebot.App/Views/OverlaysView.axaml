<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Cuebot.App.ViewModels"
             x:Class="Cuebot.App.Views.OverlaysView"
             x:DataType="vm:OverlaysViewModel">
  <DockPanel Margin="24,24,24,16">
    <StackPanel DockPanel.Dock="Top" Spacing="4">
      <TextBlock Classes="h1" Text="Overlays &amp; Widgets" />
      <TextBlock Classes="muted" TextWrapping="Wrap"
                 Text="Each overlay is a page Cuebot hosts on this computer. Add it to OBS as a browser source with the overlay's link and canvas size. Design… opens the overlay in your browser to arrange widgets, text, images and video; StreamElements custom widgets (.zip) get chat and alerts from every platform Cuebot is connected to." />
    </StackPanel>

    <TextBlock DockPanel.Dock="Top" Classes="error" Text="{Binding ServerHint}" TextWrapping="Wrap" Margin="0,8,0,0"
               IsVisible="{Binding ServerHint, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

    <!-- New overlay -->
    <Border DockPanel.Dock="Top" Classes="card" Margin="0,12,0,8">
      <Grid ColumnDefinitions="*,8,210,8,Auto,8,Auto,8,Auto">
        <TextBox Text="{Binding NewName}" PlaceholderText="New overlay name" />
        <ComboBox Grid.Column="2" ItemsSource="{x:Static vm:OverlaysViewModel.Presets}" SelectedItem="{Binding NewCanvas}" HorizontalAlignment="Stretch" />
        <NumericUpDown Grid.Column="4" Value="{Binding NewWidth}" Minimum="16" Maximum="7680" FormatString="0" Width="110"
                       IsVisible="{Binding IsCustomSize}" ToolTip.Tip="Width in pixels" />
        <NumericUpDown Grid.Column="6" Value="{Binding NewHeight}" Minimum="16" Maximum="7680" FormatString="0" Width="110"
                       IsVisible="{Binding IsCustomSize}" ToolTip.Tip="Height in pixels" />
        <Button Grid.Column="8" Content="+ Overlay" Classes="accent" Command="{Binding CreateCommand}" />
      </Grid>
    </Border>

    <TextBlock DockPanel.Dock="Top" Text="{Binding Status}" Classes="muted" Margin="0,0,0,6" TextWrapping="Wrap"
               IsVisible="{Binding Status, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

    <Grid DockPanel.Dock="Top" ColumnDefinitions="220,110,*,Auto" Margin="12,4,12,4" IsVisible="{Binding HasOverlays}">
      <TextBlock Classes="muted" Text="NAME" />
      <TextBlock Grid.Column="1" Classes="muted" Text="CANVAS" />
      <TextBlock Grid.Column="2" Classes="muted" Text="OBS BROWSER SOURCE LINK" />
    </Grid>
    <Grid>
      <ListBox ItemsSource="{Binding Overlays}" IsVisible="{Binding HasOverlays}">
        <ListBox.ItemTemplate>
          <DataTemplate DataType="vm:OverlayRowViewModel">
            <StackPanel Spacing="6">
            <Grid ColumnDefinitions="220,110,*,Auto">
              <TextBox Text="{Binding Name, UpdateSourceTrigger=LostFocus}" Margin="0,0,8,0" />
              <TextBlock Grid.Column="1" Text="{Binding Canvas}" Classes="muted" VerticalAlignment="Center" />
              <TextBlock Grid.Column="2" Text="{Binding DisplayUrl}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                   FontFamily="monospace" FontSize="12" Margin="0,0,8,0" />
              <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6">
                <Button Content="Copy link" Click="OnCopyLink" />
                <Button Content="New link" Command="{Binding NewLinkCommand}"
                        ToolTip.Tip="Replace the link (for example if someone else saw it); OBS needs the new one" />
                <Button Content="Design…" Classes="accent" Command="{Binding DesignCommand}"
                        ToolTip.Tip="Arrange this overlay's widgets, text, images and video in your browser" />
                <Button Content="Add chat box" Command="{Binding AddChatBoxCommand}"
                        ToolTip.Tip="Cuebot's chat box: chat from every connected platform, with badges, emotes and pronouns" />
                <Button Content="Add widget…" Click="OnAddWidget"
                        ToolTip.Tip="Import a StreamElements custom widget (.zip, for example one bought on Etsy)" />
                <Button Content="Delete" Command="{Binding DeleteCommand}" />
              </StackPanel>
            </Grid>
            <ItemsControl ItemsSource="{Binding Layers}" IsVisible="{Binding HasLayers}" Margin="16,0,0,0">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="vm:LayerRowViewModel">
                  <Grid ColumnDefinitions="204,Auto,6,Auto,14,Auto,6,Auto,14,Auto,6,Auto,14,Auto,6,Auto,*,Auto" Margin="0,2">
                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="1" Classes="muted" Text="X" VerticalAlignment="Center" />
                    <NumericUpDown Grid.Column="3" Value="{Binding X}" Minimum="-7680" Maximum="7680" FormatString="0" Width="110"
                                   ToolTip.Tip="Left edge (pixels)" />
                    <TextBlock Grid.Column="5" Classes="muted" Text="Y" VerticalAlignment="Center" />
                    <NumericUpDown Grid.Column="7" Value="{Binding Y}" Minimum="-7680" Maximum="7680" FormatString="0" Width="110"
                                   ToolTip.Tip="Top edge (pixels)" />
                    <TextBlock Grid.Column="9" Classes="muted" Text="W" VerticalAlignment="Center" />
                    <NumericUpDown Grid.Column="11" Value="{Binding Width}" Minimum="1" Maximum="7680" FormatString="0" Width="110"
                                   ToolTip.Tip="Width (pixels)" />
                    <TextBlock Grid.Column="13" Classes="muted" Text="H" VerticalAlignment="Center" />
                    <NumericUpDown Grid.Column="15" Value="{Binding Height}" Minimum="1" Maximum="7680" FormatString="0" Width="110"
                                   ToolTip.Tip="Height (pixels)" />
                    <StackPanel Grid.Column="17" Orientation="Horizontal" Spacing="6">
                      <Button Content="Edit…" Command="{Binding EditCommand}"
                              ToolTip.Tip="Change the widget's settings and code, and try it with sample events, in your browser" />
                      <Button Content="Remove" Command="{Binding RemoveCommand}" />
                    </StackPanel>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <TextBlock Classes="hint" Text="No overlays yet. Create one above, then add its link to OBS as a browser source."
                 HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding !HasOverlays}" />
    </Grid>
  </DockPanel>
</UserControl>

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Cuebot.App.ViewModels"
             x:Class="Cuebot.App.Views.OverlaysView"
             x:DataType="vm:OverlaysViewModel">
  <DockPanel Margin="24,24,24,16">
    <StackPanel DockPanel.Dock="Top" Spacing="4">
      <TextBlock Classes="h1" Text="Overlays &amp; Widgets" />
      <TextBlock Classes="muted" TextWrapping="Wrap"
                 Text="Each overlay is a page Cuebot hosts on this computer. Add it to OBS as a browser source with the overlay's link and canvas size. Design… opens the overlay in your browser to arrange widgets, text, images and video; StreamElements custom widgets (.zip) get chat and alerts from every platform Cuebot is connected to." />
    </StackPanel>

    <TextBlock DockPanel.Dock="Top" Classes="error" Text="{Binding ServerHint}" TextWrapping="Wrap" Margin="0,8,0,0"
               IsVisible="{Binding ServerHint, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

    <!-- New overlay -->
    <Border DockPanel.Dock="Top" Classes="card" Margin="0,12,0,8">
      <Grid ColumnDefinitions="*,8,210,8,Auto,8,Auto,8,Auto,8,Auto,8,Auto,8,Auto">
        <TextBox Text="{Binding NewName}" PlaceholderText="New overlay name" />
        <ComboBox Grid.Column="2" ItemsSource="{x:Static vm:OverlaysViewModel.Presets}" SelectedItem="{Binding NewCanvas}" HorizontalAlignment="Stretch" />
        <NumericUpDown Grid.Column="4" Value="{Binding NewWidth}" Minimum="16" Maximum="7680" FormatString="0" Width="110"
                       IsVisible="{Binding IsCustomSize}" ToolTip.Tip="Width in pixels" />
        <NumericUpDown Grid.Column="6" Value="{Binding NewHeight}" Minimum="16" Maximum="7680" FormatString="0" Width="110"
                       IsVisible="{Binding IsCustomSize}" ToolTip.Tip="Height in pixels" />
        <Button Grid.Column="8" Content="+ Overlay" Classes="accent" Command="{Binding CreateCommand}" />
        <Button Grid.Column="10" Content="Import from StreamElements…" Command="{Binding ShowStreamElementsOverlaysCommand}"
                IsVisible="{Binding CanImportFromStreamElements}" IsEnabled="{Binding !StreamElementsBusy}"
                ToolTip.Tip="Copy an overlay from your StreamElements account (custom widgets, text, images, labels and the alert box). Your StreamElements overlays are not changed." />
        <Button Grid.Column="12" Content="Import package…" Click="OnImportPackage" IsVisible="{Binding CanShare}"
                ToolTip.Tip="Open a Cuebot overlay package (.cuebot-overlay) someone shared; it becomes a new overlay with its own link" />
        <Button Grid.Column="14" Content="Browse gallery…" Command="{Binding BrowseGalleryCommand}" IsVisible="{Binding CanBrowseGallery}"
                IsEnabled="{Binding !GalleryBusy}"
                ToolTip.Tip="Overlays and widgets shared by other streamers, each reviewed before it is listed" />
      </Grid>
    </Border>

    <!-- Community gallery -->
    <Border DockPanel.Dock="Top" Classes="card" Margin="0,0,0,8" IsVisible="{Binding GalleryOpen}">
      <StackPanel Spacing="8">
        <Grid ColumnDefinitions="*,Auto,8,200,8,Auto,8,Auto">
          <TextBlock Text="Community gallery" FontWeight="SemiBold" VerticalAlignment="Center" />
          <TextBlock Grid.Column="1" Text="Add widgets to" Classes="muted" VerticalAlignment="Center" />
          <ComboBox Grid.Column="3" ItemsSource="{Binding Overlays}" SelectedItem="{Binding GalleryTarget}" HorizontalAlignment="Stretch"
                    ToolTip.Tip="Widget items are added to this overlay; overlay items always become a new overlay">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="vm:OverlayRowViewModel">
                <TextBlock Text="{Binding Name}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <Button Grid.Column="5" Content="Share yours…" Command="{Binding ShareToGalleryCommand}"
                  ToolTip.Tip="Opens the gallery's guide: export with Share, add a preview, and send a pull request" />
          <Button Grid.Column="7" Content="Close" Command="{Binding CloseGalleryCommand}" />
        </Grid>
        <ScrollViewer MaxHeight="420">
          <ItemsControl ItemsSource="{Binding GalleryItems}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:GalleryItemViewModel">
                <Grid ColumnDefinitions="192,12,*,Auto" Margin="0,4">
                  <Border Width="192" Height="108" CornerRadius="6" ClipToBounds="True" Background="#22000000">
                    <Image Source="{Binding Preview}" Stretch="UniformToFill" />
                  </Border>
                  <StackPanel Grid.Column="2" Spacing="2" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                      <TextBlock Text="{Binding Byline}" Classes="muted" />
                    </StackPanel>
                    <TextBlock Text="{Binding Description}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Details}" Classes="muted" FontSize="12" TextWrapping="Wrap" />
                  </StackPanel>
                  <StackPanel Grid.Column="3" Spacing="6" VerticalAlignment="Center" Margin="8,0,0,0">
                    <Button Content="Import" Classes="accent" Command="{Binding ImportCommand}" HorizontalAlignment="Stretch"
                            IsEnabled="{Binding !$parent[ItemsControl].((vm:OverlaysViewModel)DataContext).GalleryBusy}" />
                    <Button Content="View" Command="{Binding ViewCommand}" HorizontalAlignment="Stretch"
                            ToolTip.Tip="The item's page on GitHub" />
                    <Button Content="Report" Command="{Binding ReportCommand}" HorizontalAlignment="Stretch"
                            ToolTip.Tip="Report copyright, a broken item or something harmful" />
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </StackPanel>
    </Border>

    <!-- StreamElements overlays to import -->
    <Border DockPanel.Dock="Top" Classes="card" Margin="0,0,0,8" IsVisible="{Binding StreamElementsOpen}">
      <StackPanel Spacing="6">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Text="Your StreamElements overlays" FontWeight="SemiBold" VerticalAlignment="Center" />
          <Button Grid.Column="1" Content="Close" Command="{Binding CloseStreamElementsOverlaysCommand}" />
        </Grid>
        <ItemsControl ItemsSource="{Binding StreamElementsOverlays}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:StreamElementsOverlayRowViewModel">
              <Grid ColumnDefinitions="*,120,Auto" Margin="0,2">
                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="1" Text="{Binding Canvas}" Classes="muted" VerticalAlignment="Center" />
                <Button Grid.Column="2" Content="Import" Command="{Binding ImportCommand}"
                        IsEnabled="{Binding !$parent[ItemsControl].((vm:OverlaysViewModel)DataContext).StreamElementsBusy}" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Border>

    <!-- Alert queue on every overlay -->
    <Border DockPanel.Dock="Top" Classes="card" Margin="0,0,0,8" IsVisible="{Binding HasAlertQueue}">
      <Grid ColumnDefinitions="Auto,12,*,Auto">
        <TextBlock Text="Alerts" FontWeight="SemiBold" VerticalAlignment="Center" />
        <TextBlock Grid.Column="2" Classes="muted" VerticalAlignment="Center" TextWrapping="Wrap"
                   Text="For every overlay: pause holds new alerts until resumed, skip ends the one playing, mute silences alert sound and alert TTS." />
        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6">
          <ToggleButton Content="Pause alerts" IsChecked="{Binding AlertsPaused}" ToolTip.Tip="The alert playing finishes; new ones wait" />
          <Button Content="Skip alert" Command="{Binding SkipAlertCommand}" ToolTip.Tip="End the alert playing now" />
          <ToggleButton Content="Mute alerts" IsChecked="{Binding AlertsMuted}" ToolTip.Tip="Silence alert sounds, videos and alert TTS" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- Cuebot chat polls and predictions -->
    <Expander DockPanel.Dock="Top" Header="Chat poll and prediction (every platform)" Margin="0,0,0,8" HorizontalAlignment="Stretch"
              IsVisible="{Binding HasPolls}">
      <StackPanel Spacing="8" DataContext="{Binding Polls}" x:DataType="vm:ChatPollPanelViewModel">
        <TextBlock Classes="muted" TextWrapping="Wrap" Text="{Binding Commands}" />
        <Grid ColumnDefinitions="*,16,*">
          <StackPanel Spacing="6">
            <TextBlock Text="Poll" FontWeight="SemiBold" />
            <TextBox Text="{Binding PollTitle}" PlaceholderText="Question" />
            <TextBox Text="{Binding PollChoices}" PlaceholderText="Choices, one per line" AcceptsReturn="True" MinHeight="72" />
            <StackPanel Orientation="Horizontal" Spacing="6">
              <NumericUpDown Value="{Binding PollSeconds}" Minimum="0" Maximum="3600" FormatString="0" Width="120"
                             ToolTip.Tip="Seconds it runs (0: until you end it)" />
              <Button Content="Start poll" Classes="accent" Command="{Binding StartPollCommand}" IsEnabled="{Binding !PollRunning}" />
              <Button Content="End poll" Command="{Binding EndPollCommand}" IsEnabled="{Binding PollRunning}" />
            </StackPanel>
            <TextBlock Text="{Binding PollStatus}" TextWrapping="Wrap"
                       IsVisible="{Binding PollStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          </StackPanel>
          <StackPanel Grid.Column="2" Spacing="6">
            <TextBlock Text="Prediction (Cuebot points)" FontWeight="SemiBold" />
            <TextBox Text="{Binding PredictionTitle}" PlaceholderText="Question" />
            <TextBox Text="{Binding PredictionOutcomes}" PlaceholderText="Outcomes, one per line" AcceptsReturn="True" MinHeight="72" />
            <WrapPanel>
              <NumericUpDown Value="{Binding PredictionSeconds}" Minimum="0" Maximum="3600" FormatString="0" Width="120" Margin="0,0,6,6"
                             ToolTip.Tip="Seconds taking bets (0: until you lock it)" />
              <Button Content="Start" Classes="accent" Command="{Binding StartPredictionCommand}" IsEnabled="{Binding CanStartPrediction}" Margin="0,0,6,6" />
              <Button Content="Lock bets" Command="{Binding LockPredictionCommand}" IsEnabled="{Binding CanLock}" Margin="0,0,6,6" />
              <ComboBox ItemsSource="{Binding Outcomes}" SelectedItem="{Binding Winner}" PlaceholderText="Winner" MinWidth="120"
                        IsEnabled="{Binding PredictionOpen}" Margin="0,0,6,6" />
              <Button Content="Pay out" Command="{Binding ResolvePredictionCommand}" IsEnabled="{Binding PredictionOpen}" Margin="0,0,6,6"
                      ToolTip.Tip="Winners share the whole pot in proportion to their bets" />
              <Button Content="Cancel" Command="{Binding CancelPredictionCommand}" IsEnabled="{Binding PredictionOpen}" Margin="0,0,6,6"
                      ToolTip.Tip="Refund every bet" />
            </WrapPanel>
            <TextBlock Text="{Binding PredictionStatus}" TextWrapping="Wrap"
                       IsVisible="{Binding PredictionStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          </StackPanel>
        </Grid>
        <TextBlock Text="{Binding Message}" Classes="muted" TextWrapping="Wrap"
                   IsVisible="{Binding Message, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
      </StackPanel>
    </Expander>

    <TextBlock DockPanel.Dock="Top" Text="{Binding Status}" Classes="muted" Margin="0,0,0,6" TextWrapping="Wrap"
               IsVisible="{Binding Status, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

    <Grid DockPanel.Dock="Top" ColumnDefinitions="220,110,*,Auto" Margin="12,4,12,4" IsVisible="{Binding HasOverlays}">
      <TextBlock Classes="muted" Text="NAME" />
      <TextBlock Grid.Column="1" Classes="muted" Text="CANVAS" />
      <TextBlock Grid.Column="2" Classes="muted" Text="OBS BROWSER SOURCE LINK" />
    </Grid>
    <Grid>
      <ListBox ItemsSource="{Binding Overlays}" IsVisible="{Binding HasOverlays}">
        <ListBox.ItemTemplate>
          <DataTemplate DataType="vm:OverlayRowViewModel">
            <StackPanel Spacing="6">
            <Grid ColumnDefinitions="220,110,*,Auto">
              <TextBox Text="{Binding Name, UpdateSourceTrigger=LostFocus}" Margin="0,0,8,0" />
              <TextBlock Grid.Column="1" Text="{Binding Canvas}" Classes="muted" VerticalAlignment="Center" />
              <TextBlock Grid.Column="2" Text="{Binding DisplayUrl}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                   FontFamily="monospace" FontSize="12" Margin="0,0,8,0" />
              <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6">
                <Button Content="Copy link" Click="OnCopyLink" />
                <Button Content="New link" Command="{Binding NewLinkCommand}"
                        ToolTip.Tip="Replace the link (for example if someone else saw it); OBS needs the new one" />
                <Button Content="Design…" Classes="accent" Command="{Binding DesignCommand}"
                        ToolTip.Tip="Arrange this overlay's widgets, text, images and video in your browser" />
                <DropDownButton Content="Add Cuebot widget" ToolTip.Tip="Widgets Cuebot ships: chat, alerts, labels, goals, lists and timers">
                  <DropDownButton.Flyout>
                    <MenuFlyout Placement="BottomEdgeAlignedLeft">
                      <MenuItem Header="Chat box" Command="{Binding AddChatBoxCommand}"
                                ToolTip.Tip="Chat from every connected platform, with badges, emotes and pronouns" />
                      <MenuItem Header="Alert box" Command="{Binding AddAlertBoxCommand}"
                                ToolTip.Tip="A design for each alert type, with variations by amount, tier, platform and more" />
                      <Separator />
                      <MenuItem Header="Label" Command="{Binding AddBuiltInCommand}" CommandParameter="label"
                                ToolTip.Tip="Latest follower, sub or tip, a count or amount, the top donor or recent names" />
                      <MenuItem Header="Goal bar" Command="{Binding AddBuiltInCommand}" CommandParameter="goal"
                                ToolTip.Tip="Progress to a follower, sub, tip, bits, Kicks or revenue goal" />
                      <MenuItem Header="Event list" Command="{Binding AddBuiltInCommand}" CommandParameter="eventlist"
                                ToolTip.Tip="The latest follows, subs, tips and more from every platform" />
                      <MenuItem Header="Credits roll" Command="{Binding AddBuiltInCommand}" CommandParameter="credits"
                                ToolTip.Tip="An end-of-stream roll of this stream's subs, followers, tippers and raiders" />
                      <MenuItem Header="Countdown" Command="{Binding AddBuiltInCommand}" CommandParameter="countdown"
                                ToolTip.Tip="Counts down minutes or to a time; reloading does not restart it" />
                      <Separator />
                      <MenuItem Header="Emote rain" Command="{Binding AddBuiltInCommand}" CommandParameter="emoterain"
                                ToolTip.Tip="Chat emotes fly across the overlay; a command and alerts send bursts" />
                      <MenuItem Header="Hype cup" Command="{Binding AddBuiltInCommand}" CommandParameter="hypecup"
                                ToolTip.Tip="Follows, subs, bits, Kicks and tips fill a cup with balls" />
                      <MenuItem Header="Hype boss" Command="{Binding AddBuiltInCommand}" CommandParameter="hypeboss"
                                ToolTip.Tip="Support damages the boss; the final hit makes you the next boss" />
                      <MenuItem Header="Poll and prediction" Command="{Binding AddBuiltInCommand}" CommandParameter="poll"
                                ToolTip.Tip="Twitch and YouTube polls and predictions, and Cuebot chat polls on every platform" />
                      <MenuItem Header="Giveaway" Command="{Binding AddBuiltInCommand}" CommandParameter="giveaway"
                                ToolTip.Tip="The prize, how to enter, entries and a spinning winner reveal" />
                      <MenuItem Header="Media request player" Command="{Binding AddBuiltInCommand}" CommandParameter="media"
                                ToolTip.Tip="Plays the YouTube videos viewers request in chat, with what plays and what is next" />
                      <Separator />
                      <MenuItem Header="Charity campaign" Command="{Binding AddBuiltInCommand}" CommandParameter="charity"
                                ToolTip.Tip="A Twitch charity campaign's progress, or your charity donations against a goal" />
                      <MenuItem Header="Product showcase" Command="{Binding AddBuiltInCommand}" CommandParameter="products"
                                ToolTip.Tip="Rotates your products with where to buy them, and shows merch purchases" />
                      <MenuItem Header="Seasonal effects" Command="{Binding AddBuiltInCommand}" CommandParameter="seasonal"
                                ToolTip.Tip="Snow, leaves, hearts, confetti, blossoms, bubbles or stars over the overlay" />
                    </MenuFlyout>
                  </DropDownButton.Flyout>
                </DropDownButton>
                <Button Content="Add widget…" Click="OnAddWidget"
                        ToolTip.Tip="Import a StreamElements or Streamlabs custom widget (.zip, for example one bought on Etsy), or a Cuebot widget package (.cuebot-overlay)" />
                <DropDownButton Content="Share" IsVisible="{Binding CanShare}" ToolTip.Tip="Save this overlay as one file to share or back up">
                  <DropDownButton.Flyout>
                    <MenuFlyout Placement="BottomEdgeAlignedLeft">
                      <MenuItem Header="Export package…" Click="OnExport" Tag="own"
                                ToolTip.Tip="Layers, settings and files; widgets whose code is not Cuebot's own are left out" />
                      <MenuItem Header="Export with custom widget code (I own the rights to share it)…" Click="OnExport" Tag="custom"
                                IsVisible="{Binding HasCustomCode}"
                                ToolTip.Tip="Only for code you wrote or may share: widgets bought from a creator usually may not be passed on" />
                    </MenuFlyout>
                  </DropDownButton.Flyout>
                </DropDownButton>
                <Button Content="Delete" Command="{Binding DeleteCommand}" />
              </StackPanel>
            </Grid>
            <ItemsControl ItemsSource="{Binding Layers}" IsVisible="{Binding HasLayers}" Margin="16,0,0,0">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="vm:LayerRowViewModel">
                  <Grid ColumnDefinitions="204,Auto,6,Auto,14,Auto,6,Auto,14,Auto,6,Auto,14,Auto,6,Auto,*,Auto" Margin="0,2">
                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="1" Classes="muted" Text="X" VerticalAlignment="Center" />
                    <NumericUpDown Grid.Column="3" Value="{Binding X}" Minimum="-7680" Maximum="7680" FormatString="0" Width="110"
                                   ToolTip.Tip="Left edge (pixels)" />
                    <TextBlock Grid.Column="5" Classes="muted" Text="Y" VerticalAlignment="Center" />
                    <NumericUpDown Grid.Column="7" Value="{Binding Y}" Minimum="-7680" Maximum="7680" FormatString="0" Width="110"
                                   ToolTip.Tip="Top edge (pixels)" />
                    <TextBlock Grid.Column="9" Classes="muted" Text="W" VerticalAlignment="Center" />
                    <NumericUpDown Grid.Column="11" Value="{Binding Width}" Minimum="1" Maximum="7680" FormatString="0" Width="110"
                                   ToolTip.Tip="Width (pixels)" />
                    <TextBlock Grid.Column="13" Classes="muted" Text="H" VerticalAlignment="Center" />
                    <NumericUpDown Grid.Column="15" Value="{Binding Height}" Minimum="1" Maximum="7680" FormatString="0" Width="110"
                                   ToolTip.Tip="Height (pixels)" />
                    <StackPanel Grid.Column="17" Orientation="Horizontal" Spacing="6">
                      <Button Content="Edit…" Command="{Binding EditCommand}"
                              ToolTip.Tip="Change the widget's settings and code, and try it with sample events, in your browser" />
                      <DropDownButton Content="Share" IsVisible="{Binding CanShare}" ToolTip.Tip="Save this widget (for example an alert box with its designs) as one file">
                        <DropDownButton.Flyout>
                          <MenuFlyout Placement="BottomEdgeAlignedLeft">
                            <MenuItem Header="Export package…" Click="OnExport" Tag="own" IsVisible="{Binding !HasCustomCode}" />
                            <MenuItem Header="Export with its code (I own the rights to share it)…" Click="OnExport" Tag="custom"
                                      IsVisible="{Binding HasCustomCode}"
                                      ToolTip.Tip="Only for code you wrote or may share: widgets bought from a creator usually may not be passed on" />
                          </MenuFlyout>
                        </DropDownButton.Flyout>
                      </DropDownButton>
                      <Button Content="Remove" Command="{Binding RemoveCommand}" />
                    </StackPanel>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <TextBlock Classes="hint" Text="No overlays yet. Create one above, then add its link to OBS as a browser source."
                 HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding !HasOverlays}" />
    </Grid>
  </DockPanel>
</UserControl>

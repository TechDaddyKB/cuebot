<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Cuebot.App.ViewModels.Integrations"
             x:Class="Cuebot.App.Views.Integrations.IntegrationsView"
             x:DataType="vm:IntegrationsViewModel">
  <ScrollViewer Padding="24">
    <StackPanel MaxWidth="860" HorizontalAlignment="Left">
      <TextBlock Classes="h1" Text="Integrations" />
      <TextBlock Classes="muted" TextWrapping="Wrap" Margin="0,0,0,8"
                 Text="VTube Studio, Voicemod, heart rate monitors, StreamLoots and Crowd Control become triggers and sub-actions for your actions (and can be used in scripts). Settings are stored in integrations.json. Tokens and keys (secret codes) are hidden here and never written to the log. Nothing connects by itself unless you tick the automatic box." />

      <!-- VTube Studio -->
      <Border Classes="card" DataContext="{Binding VTubeStudio}" x:DataType="vm:VtsCardViewModel">
        <StackPanel Spacing="8">
          <TextBlock Classes="h2" Text="VTube Studio" />
          <TextBlock Classes="muted" TextWrapping="Wrap"
                     Text="In VTube Studio open Settings and switch on &quot;Start API (allow plugins)&quot;. Click Connect here, then click Allow on the Cuebot plugin pop-up in VTube Studio. Cuebot saves the pass it gets (a token), so you only allow it once." />
          <Grid ColumnDefinitions="Auto,*,Auto,140" RowDefinitions="Auto">
            <TextBlock Text="Host" VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBox Grid.Column="1" Text="{Binding Host}" PlaceholderText="localhost" ToolTip.Tip="The computer where VTube Studio runs. Use localhost for this computer." />
            <TextBlock Grid.Column="2" Text="Port" VerticalAlignment="Center" Margin="12,0,8,0" />
            <NumericUpDown Grid.Column="3" Value="{Binding Port}" Minimum="1" Maximum="65535" FormatString="0" ToolTip.Tip="The door number VTube Studio listens on. Leave it alone unless you changed it in VTube Studio." />
          </Grid>
          <TextBlock Classes="muted" Text="{Binding MaskedToken}" TextWrapping="Wrap" />
          <CheckBox Content="Connect automatically on startup" IsChecked="{Binding AutoConnect}" ToolTip.Tip="Ticked: Cuebot connects by itself every time it starts." />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="Connect" Classes="accent" Command="{Binding ConnectCommand}" ToolTip.Tip="Connects now." />
            <Button Content="Disconnect" Command="{Binding DisconnectCommand}" ToolTip.Tip="Disconnects. Your saved settings stay." />
            <Button Content="Forget plugin token" Command="{Binding ResetTokenCommand}" ToolTip.Tip="Removes the saved pass. Next time you connect, VTube Studio asks you to allow Cuebot again." />
          </StackPanel>
          <TextBlock TextWrapping="Wrap">
            <Run Text="{Binding State}" FontWeight="SemiBold" /><Run Text="  " /><Run Text="{Binding StatusMessage}" Foreground="{StaticResource CuebotMuted}" />
          </TextBlock>
          <TextBlock Text="Current model" FontWeight="SemiBold" Margin="0,4,0,0" />
          <TextBlock Name="VtsModel" Text="{Binding CurrentModel}" TextWrapping="Wrap" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <ComboBox ItemsSource="{Binding Models}" SelectedItem="{Binding SelectedModel}" MinWidth="200" PlaceholderText="Model" ToolTip.Tip="Choose which model (character) VTube Studio should show." />
            <Button Content="Load model" Command="{Binding LoadModelCommand}" ToolTip.Tip="Tells VTube Studio to switch to the chosen model." />
            <Button Content="Refresh" Command="{Binding RefreshLiveCommand}" ToolTip.Tip="Asks VTube Studio again for the current model and its hotkeys." />
          </StackPanel>
          <TextBlock Text="Hotkeys" FontWeight="SemiBold" Margin="0,4,0,0" />
          <TextBlock Classes="muted" Text="Connect to list the current model's hotkeys." IsVisible="{Binding HasNoHotkeys}" />
          <ItemsControl Name="VtsHotkeys" ItemsSource="{Binding Hotkeys}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:VtsHotkeyRowViewModel">
                <Grid ColumnDefinitions="*,160,Auto" Margin="0,2">
                  <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="1" Classes="muted" Text="{Binding Type}" VerticalAlignment="Center" />
                  <Button Grid.Column="2" Content="Test" Command="{Binding TestCommand}" ToolTip.Tip="Triggers this VTube Studio hotkey now, so you can see what it does." />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Classes="muted" TextWrapping="Wrap" Text="{Binding Info}" />
          <TextBlock Classes="error" TextWrapping="Wrap" Text="{Binding Error}" />
        </StackPanel>
      </Border>

      <!-- Voicemod -->
      <Border Classes="card" DataContext="{Binding Voicemod}" x:DataType="vm:VoicemodCardViewModel">
        <StackPanel Spacing="8">
          <TextBlock Classes="h2" Text="Voicemod" />
          <TextBlock Classes="muted" TextWrapping="Wrap"
                     Text="Needs the Voicemod desktop app (Windows) and a client key (a secret code), which Voicemod gives out on request through its developer program (control-api.voicemod.net). Paste the key below. Cuebot tries the usual door numbers (ports) Voicemod uses, starting with 59129." />
          <TextBox Name="VoicemodKey" Text="{Binding ClientKey}" PasswordChar="•" PlaceholderText="Client key (API key)" ToolTip.Tip="The secret code Voicemod gave you so Cuebot may control it. It stays hidden." />
          <TextBlock Classes="muted" Text="{Binding MaskedKey}" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="Port (0 = automatic)" VerticalAlignment="Center" />
            <NumericUpDown Value="{Binding Port}" Minimum="0" Maximum="65535" FormatString="0" Width="140" ToolTip.Tip="The door number Voicemod listens on. 0 lets Cuebot find it by itself." />
          </StackPanel>
          <CheckBox Content="Connect automatically on startup" IsChecked="{Binding AutoConnect}" ToolTip.Tip="Ticked: Cuebot connects by itself every time it starts." />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="Connect" Classes="accent" Command="{Binding ConnectCommand}" ToolTip.Tip="Connects now." />
            <Button Content="Disconnect" Command="{Binding DisconnectCommand}" ToolTip.Tip="Disconnects. Your saved settings stay." />
          </StackPanel>
          <TextBlock TextWrapping="Wrap">
            <Run Text="{Binding State}" FontWeight="SemiBold" /><Run Text="  " /><Run Text="{Binding StatusMessage}" Foreground="{StaticResource CuebotMuted}" />
          </TextBlock>
          <TextBlock Name="VoicemodVoice" TextWrapping="Wrap">
            <Run Text="Current voice: " FontWeight="SemiBold" /><Run Text="{Binding CurrentVoice}" />
          </TextBlock>
          <TextBlock Classes="muted" Text="{Binding Switches}" TextWrapping="Wrap" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <ComboBox ItemsSource="{Binding Voices}" SelectedItem="{Binding SelectedVoice}" MinWidth="200" PlaceholderText="Voice" ToolTip.Tip="Choose which Voicemod voice to use." />
            <Button Content="Select voice" Command="{Binding ApplyVoiceCommand}" ToolTip.Tip="Switches Voicemod to the chosen voice." />
            <Button Content="Random voice" Command="{Binding RandomVoiceCommand}" ToolTip.Tip="Switches Voicemod to a random voice." />
            <Button Content="Toggle voice changer" Command="{Binding ToggleVoiceChangerCommand}" ToolTip.Tip="Turns the voice changer on if it is off, and off if it is on." />
          </StackPanel>
          <TextBlock Classes="muted" TextWrapping="Wrap" Text="{Binding Info}" />
          <TextBlock Classes="error" TextWrapping="Wrap" Text="{Binding Error}" />
        </StackPanel>
      </Border>

      <!-- Pulsoid -->
      <Border Classes="card" DataContext="{Binding Pulsoid}" x:DataType="vm:PulsoidCardViewModel">
        <StackPanel Spacing="8">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Classes="h2" Text="Pulsoid" />
            <TextBlock Grid.Column="1" Name="PulsoidBpm" Text="{Binding Bpm}" FontSize="22" FontWeight="SemiBold" />
          </Grid>
          <TextBlock Classes="muted" TextWrapping="Wrap"
                     Text="On pulsoid.net open Account → Tokens (pulsoid.net/ui/keys), create a token that is allowed to read your heart rate (data:heart_rate:read) and paste it here. Cuebot never puts the token in a web address." />
          <TextBox Name="PulsoidToken" Text="{Binding AccessToken}" PasswordChar="•" PlaceholderText="Access token" ToolTip.Tip="A secret code from Pulsoid that lets Cuebot read your heart rate. It stays hidden." />
          <TextBlock Classes="muted" Text="{Binding MaskedToken}" />
          <CheckBox Content="Connect automatically on startup" IsChecked="{Binding AutoConnect}" ToolTip.Tip="Ticked: Cuebot connects by itself every time it starts." />
          <CheckBox Content="Use the legacy v1 realtime endpoint" IsChecked="{Binding UseLegacyV1}" ToolTip.Tip="Only tick this if the normal connection does not work. It uses Pulsoid's older way of sending your heart rate." />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="Connect" Classes="accent" Command="{Binding ConnectCommand}" ToolTip.Tip="Connects now." />
            <Button Content="Disconnect" Command="{Binding DisconnectCommand}" ToolTip.Tip="Disconnects. Your saved settings stay." />
          </StackPanel>
          <TextBlock TextWrapping="Wrap">
            <Run Text="{Binding State}" FontWeight="SemiBold" /><Run Text="  " /><Run Text="{Binding StatusMessage}" Foreground="{StaticResource CuebotMuted}" />
          </TextBlock>
          <TextBlock Classes="error" TextWrapping="Wrap" Text="{Binding Error}" />
        </StackPanel>
      </Border>

      <!-- HypeRate -->
      <Border Classes="card" DataContext="{Binding HypeRate}" x:DataType="vm:HypeRateCardViewModel">
        <StackPanel Spacing="8">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Classes="h2" Text="HypeRate" />
            <TextBlock Grid.Column="1" Name="HypeRateBpm" Text="{Binding Bpm}" FontSize="22" FontWeight="SemiBold" />
          </Grid>
          <TextBlock Classes="muted" TextWrapping="Wrap"
                     Text="Ask for an API key (a secret code) at hyperate.io/api and paste it here, then enter the HypeRate ID shown in the HypeRate app. The ID internal-testing sends made-up heart rates so you can try things out." />
          <TextBox Name="HypeRateKey" Text="{Binding ApiKey}" PasswordChar="•" PlaceholderText="API key" ToolTip.Tip="The secret code HypeRate gave you. It stays hidden." />
          <TextBlock Classes="muted" Text="{Binding MaskedKey}" />
          <TextBox Text="{Binding SessionId}" PlaceholderText="HypeRate ID (e.g. 12AB)" ToolTip.Tip="The short code shown in the HypeRate app on your phone. It tells Cuebot whose heart rate to follow." />
          <CheckBox Content="Connect automatically on startup" IsChecked="{Binding AutoConnect}" ToolTip.Tip="Ticked: Cuebot connects by itself every time it starts." />
          <CheckBox Content="Also receive &quot;Twitch clip created&quot; events" IsChecked="{Binding SubscribeClips}" ToolTip.Tip="Ticked: Cuebot is also told when a Twitch clip is made through HypeRate, so an action can react to it." />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="Connect" Classes="accent" Command="{Binding ConnectCommand}" ToolTip.Tip="Connects now." />
            <Button Content="Disconnect" Command="{Binding DisconnectCommand}" ToolTip.Tip="Disconnects. Your saved settings stay." />
          </StackPanel>
          <TextBlock TextWrapping="Wrap">
            <Run Text="{Binding State}" FontWeight="SemiBold" /><Run Text="  " /><Run Text="{Binding StatusMessage}" Foreground="{StaticResource CuebotMuted}" />
          </TextBlock>
          <TextBlock Classes="error" TextWrapping="Wrap" Text="{Binding Error}" />
        </StackPanel>
      </Border>

      <!-- StreamLoots -->
      <Border Classes="card" IsVisible="{Binding HasStreamLoots}">
        <StackPanel Spacing="8" DataContext="{Binding StreamLoots}" x:DataType="vm:StreamLootsCardViewModel">
          <TextBlock Classes="h2" Text="StreamLoots" />
          <TextBlock Classes="muted" TextWrapping="Wrap"
                     Text="On streamloots.com open your dashboard → Alerts &amp; Widgets → Alerts, show the alerts web link (https://widgets.streamloots.com/alerts/...) and paste it here. Chest purchases, gifts and card redemptions become triggers for your actions. The Test button on the StreamLoots website sends real test alerts through this connection." />
          <TextBox Name="StreamLootsUrl" Text="{Binding AlertsUrl}" PasswordChar="•" PlaceholderText="Alerts widget URL" ToolTip.Tip="The private web link of your StreamLoots alerts. Treat it like a password. It stays hidden." />
          <TextBlock Classes="muted" Text="{Binding MaskedUrl}" TextWrapping="Wrap" />
          <CheckBox Content="Connect automatically on startup" IsChecked="{Binding AutoConnect}" ToolTip.Tip="Ticked: Cuebot connects by itself every time it starts." />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="Connect" Classes="accent" Command="{Binding ConnectCommand}" ToolTip.Tip="Connects now." />
            <Button Content="Disconnect" Command="{Binding DisconnectCommand}" ToolTip.Tip="Disconnects. Your saved settings stay." />
          </StackPanel>
          <TextBlock TextWrapping="Wrap">
            <Run Text="{Binding State}" FontWeight="SemiBold" /><Run Text="  " /><Run Text="{Binding StatusMessage}" Foreground="{StaticResource CuebotMuted}" />
          </TextBlock>
          <TextBlock Name="StreamLootsLast" TextWrapping="Wrap">
            <Run Text="Last alert: " FontWeight="SemiBold" /><Run Text="{Binding LastAlert}" />
          </TextBlock>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <ComboBox ItemsSource="{Binding TestKinds}" SelectedItem="{Binding SelectedTestKind}" MinWidth="200" ToolTip.Tip="Choose which kind of pretend alert to send." />
            <Button Content="Send test alert" Command="{Binding SendTestCommand}" ToolTip.Tip="Sends a pretend alert to your own actions so you can test them. Nothing is sent to StreamLoots." />
          </StackPanel>
          <TextBlock Classes="muted" TextWrapping="Wrap" Text="{Binding Info}" />
          <TextBlock Classes="error" TextWrapping="Wrap" Text="{Binding Error}" />
        </StackPanel>
      </Border>

      <!-- Crowd Control -->
      <Border Classes="card" IsVisible="{Binding HasCrowdControl}">
        <StackPanel Spacing="8" DataContext="{Binding CrowdControl}" x:DataType="vm:CrowdControlCardViewModel">
          <TextBlock Classes="h2" Text="Crowd Control" />
          <TextBlock Classes="muted" TextWrapping="Wrap"
                     Text="In the Crowd Control app open Overlays &amp; Assets, copy your private overlay web link (it ends in ?key=...) and paste it here. Cuebot then hears what the overlay hears: effect requests, successes, failures, refunds, timed effects, coin purchases and game sessions. It reconnects by itself." />
          <TextBox Name="CrowdControlUrl" Text="{Binding OverlayUrl}" PasswordChar="•" PlaceholderText="Overlay URL" ToolTip.Tip="Your private Crowd Control overlay link. Treat it like a password. It stays hidden." />
          <TextBlock Classes="muted" Text="{Binding MaskedUrl}" TextWrapping="Wrap" />
          <CheckBox Content="Connect automatically on startup" IsChecked="{Binding AutoConnect}" ToolTip.Tip="Ticked: Cuebot connects by itself every time it starts." />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="Connect" Classes="accent" Command="{Binding ConnectCommand}" ToolTip.Tip="Connects now." />
            <Button Content="Disconnect" Command="{Binding DisconnectCommand}" ToolTip.Tip="Disconnects. Your saved settings stay." />
          </StackPanel>
          <TextBlock TextWrapping="Wrap">
            <Run Text="{Binding State}" FontWeight="SemiBold" /><Run Text="  " /><Run Text="{Binding StatusMessage}" Foreground="{StaticResource CuebotMuted}" />
          </TextBlock>
          <TextBlock Name="CrowdControlSession" TextWrapping="Wrap">
            <Run Text="Game session: " FontWeight="SemiBold" /><Run Text="{Binding SessionText}" />
          </TextBlock>
          <TextBlock TextWrapping="Wrap">
            <Run Text="Timed effects: " FontWeight="SemiBold" /><Run Text="{Binding TimedEffectsText}" />
          </TextBlock>
          <TextBlock Name="CrowdControlLast" TextWrapping="Wrap">
            <Run Text="Last event: " FontWeight="SemiBold" /><Run Text="{Binding LastEvent}" />
          </TextBlock>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <ComboBox ItemsSource="{Binding TestKinds}" SelectedItem="{Binding SelectedTestKind}" MinWidth="200" ToolTip.Tip="Choose which kind of pretend event to send." />
            <Button Content="Send test event" Command="{Binding SendTestCommand}" ToolTip.Tip="Sends a pretend event to your own actions so you can test them. Nothing is sent to Crowd Control." />
          </StackPanel>
          <TextBlock Classes="muted" TextWrapping="Wrap" Text="{Binding Info}" />
          <TextBlock Classes="error" TextWrapping="Wrap" Text="{Binding Error}" />
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>

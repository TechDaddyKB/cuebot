<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Cuebot.App.ViewModels.Integrations"
             x:Class="Cuebot.App.Views.Integrations.DiscordBotView"
             x:DataType="vm:DiscordBotViewModel">
  <ScrollViewer Padding="24">
    <StackPanel MaxWidth="860" HorizontalAlignment="Left">
      <TextBlock Classes="h1" Text="Discord bot" />
      <TextBlock Classes="muted" TextWrapping="Wrap" Margin="0,0,0,8"
                 Text="Your own bot in your own Discord server: it posts your going-live message (and edits it when the stream ends), gives roles, answers slash commands like /socials and can start actions. You make the bot yourself in Discord's Developer Portal; it takes about five minutes and costs nothing. Cuebot runs it from this computer, so it is online while Cuebot is. (Just want to post into a channel? The &quot;Basic webhook&quot; step needs no bot.)" />

      <!-- 1. Create the bot -->
      <Border Classes="card">
        <StackPanel Spacing="8">
          <TextBlock Classes="h2" Text="1. Create your bot" />
          <TextBlock TextWrapping="Wrap"
                     Text="In the Developer Portal click New Application and give it a name (this is your bot's name). Open Bot on the left, click Reset Token, then Copy, and paste the token below. The token is like a password for your bot: never show it on stream." />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="Open the Developer Portal" Command="{Binding OpenPortalCommand}" ToolTip.Tip="Opens discord.com/developers/applications in your browser. Sign in with your normal Discord account." />
            <Button Content="Step-by-step guide" Command="{Binding OpenGuideCommand}" ToolTip.Tip="Opens Cuebot's guide with pictures of every click." />
          </StackPanel>
          <TextBox Name="DiscordToken" Text="{Binding BotToken}" PasswordChar="•" PlaceholderText="Bot token" ToolTip.Tip="Paste the token you copied from the Bot page. It stays hidden and is stored encrypted." />
          <TextBlock Classes="muted" Text="{Binding MaskedToken}" TextWrapping="Wrap" />
        </StackPanel>
      </Border>

      <!-- 2. Switches -->
      <Border Classes="card">
        <StackPanel Spacing="8">
          <TextBlock Classes="h2" Text="2. Extra switches (only if you need them)" />
          <TextBlock Classes="muted" TextWrapping="Wrap"
                     Text="Discord keeps two kinds of information private unless you switch them on. Tick a box here AND turn on the switch with the same name in the Developer Portal (Bot page, &quot;Privileged Gateway Intents&quot;, then Save Changes). If they do not match, Discord refuses the connection and Cuebot tells you which switch to turn on." />
          <CheckBox Content="Message Content Intent: read what people write" IsChecked="{Binding MessageContent}"
                    ToolTip.Tip="Needed for the &quot;Message posted in a channel&quot; trigger to see the text of messages. Slash commands do not need it." />
          <CheckBox Content="Server Members Intent: know when someone joins" IsChecked="{Binding ServerMembers}"
                    ToolTip.Tip="Needed for the &quot;Member joined the server&quot; trigger (for example to welcome people or give them a role)." />
          <TextBlock Classes="muted" Text="{Binding ReconnectHint}" TextWrapping="Wrap" />
        </StackPanel>
      </Border>

      <!-- 3. Invite and connect -->
      <Border Classes="card">
        <StackPanel Spacing="8">
          <TextBlock Classes="h2" Text="3. Invite the bot and connect" />
          <TextBlock Classes="muted" TextWrapping="Wrap"
                     Text="The invite button opens Discord in your browser with the right permissions already ticked: view channels, send messages, embed links, manage messages, read message history, manage roles and use slash commands. Pick your server and click Authorize. To give roles, drag the bot's role above those roles in Server Settings, Roles." />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="Invite the bot to your server" Command="{Binding InviteCommand}" ToolTip.Tip="Opens Discord's invite page for your bot. You need to be allowed to manage the server you add it to." />
            <Button Content="Connect" Classes="accent" Command="{Binding ConnectCommand}" ToolTip.Tip="Brings your bot online now." />
            <Button Content="Disconnect" Command="{Binding DisconnectCommand}" ToolTip.Tip="Takes the bot offline. Your saved settings stay." />
          </StackPanel>
          <CheckBox Content="Connect automatically on startup" IsChecked="{Binding AutoConnect}" ToolTip.Tip="Ticked: your bot comes online by itself every time Cuebot starts." />
          <TextBlock TextWrapping="Wrap">
            <Run Text="{Binding State}" FontWeight="SemiBold" /><Run Text="  " /><Run Text="{Binding StatusMessage}" Foreground="{StaticResource CuebotMuted}" />
          </TextBlock>
          <TextBlock Classes="muted" TextWrapping="Wrap" Text="{Binding Info}" />
          <TextBlock Classes="error" TextWrapping="Wrap" Text="{Binding Error}" />
        </StackPanel>
      </Border>

      <!-- Servers -->
      <Border Classes="card">
        <StackPanel Spacing="8">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Classes="h2" Text="Your bot's servers" />
            <Button Grid.Column="1" Content="Refresh" Command="{Binding RefreshCommand}" ToolTip.Tip="Asks Discord again for the bot's servers, channels and roles." />
          </Grid>
          <TextBlock Classes="muted" TextWrapping="Wrap" IsVisible="{Binding HasNoServers}"
                     Text="Nothing yet. Invite the bot, then click Connect or Refresh. The channels and roles listed here are the ones you can pick in the Discord steps." />
          <ItemsControl Name="DiscordServers" ItemsSource="{Binding Servers}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:DiscordServerRowViewModel">
                <StackPanel Margin="0,4" Spacing="2">
                  <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding Channels}" TextWrapping="Wrap" />
                  <TextBlock Classes="muted" TextWrapping="Wrap">
                    <Run Text="Roles: " /><Run Text="{Binding Roles}" />
                  </TextBlock>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <!-- Slash commands -->
      <Border Classes="card">
        <StackPanel Spacing="8">
          <TextBlock Classes="h2" Text="Slash commands" />
          <TextBlock Classes="muted" TextWrapping="Wrap"
                     Text="Commands people type in your server, like /socials. Add them here, click Register, then make an action with the &quot;Slash command used&quot; trigger. Use the &quot;Reply to slash command&quot; step to answer; if the action has none, the bot answers with the default reply below." />
          <TextBlock Classes="muted" Text="No slash commands yet." IsVisible="{Binding HasNoCommands}" />
          <ItemsControl Name="DiscordCommands" ItemsSource="{Binding Commands}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:DiscordCommandRowViewModel">
                <Border BorderBrush="{StaticResource CuebotMuted}" BorderThickness="0,0,0,1" Padding="0,6">
                  <StackPanel Spacing="6">
                    <Grid ColumnDefinitions="Auto,160,*,Auto" ColumnSpacing="8">
                      <TextBlock Text="/" VerticalAlignment="Center" FontWeight="SemiBold" />
                      <TextBox Grid.Column="1" Text="{Binding Name}" PlaceholderText="socials" ToolTip.Tip="What people type after the slash: lowercase letters, numbers, - or _, no spaces." />
                      <TextBox Grid.Column="2" Text="{Binding Description}" PlaceholderText="What it does, like &quot;Shows my socials&quot;" ToolTip.Tip="Shown under the command in Discord (up to 100 characters)." />
                      <Button Grid.Column="3" Content="Remove" Command="{Binding RemoveCommand}" ToolTip.Tip="Deletes this command here. Click Register afterwards to remove it from Discord too." />
                    </Grid>
                    <Grid ColumnDefinitions="Auto,160,*" ColumnSpacing="8">
                      <TextBlock Text="Text box" VerticalAlignment="Center" />
                      <TextBox Grid.Column="1" Text="{Binding OptionName}" PlaceholderText="(none)" ToolTip.Tip="Optional: a name for something people can type after the command, like song. Leave empty for none. Your action gets it as %option%." />
                      <TextBox Grid.Column="2" Text="{Binding OptionDescription}" PlaceholderText="What to type there" ToolTip.Tip="A hint Discord shows for that text box." />
                    </Grid>
                    <StackPanel Orientation="Horizontal" Spacing="16">
                      <CheckBox Content="Text box must be filled in" IsChecked="{Binding OptionRequired}" ToolTip.Tip="Ticked: Discord only sends the command when the text box is filled in." />
                      <CheckBox Content="Only they see the answer" IsChecked="{Binding Private}" ToolTip.Tip="Ticked: the answer is shown only to the person who used the command." />
                    </StackPanel>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="Add command" Command="{Binding AddCommandCommand}" ToolTip.Tip="Adds a new slash command to the list." />
            <Button Content="Register" Classes="accent" Command="{Binding RegisterCommand}" ToolTip.Tip="Sends this list to Discord for every server the bot is in. Changes show up right away." />
          </StackPanel>
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
            <TextBlock Text="Default reply" VerticalAlignment="Center" />
            <TextBox Grid.Column="1" Text="{Binding DefaultReply}" PlaceholderText="Done ✅" ToolTip.Tip="What the bot answers when the action finished without a &quot;Reply to slash command&quot; step, so Discord does not keep saying the bot is thinking." />
          </Grid>
          <TextBlock Classes="muted" TextWrapping="Wrap" Text="{Binding Info}" />
          <TextBlock Classes="error" TextWrapping="Wrap" Text="{Binding Error}" />
        </StackPanel>
      </Border>

    </StackPanel>
  </ScrollViewer>
</UserControl>

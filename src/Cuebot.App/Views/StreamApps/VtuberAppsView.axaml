<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Cuebot.App.ViewModels.StreamApps"
             x:Class="Cuebot.App.Views.StreamApps.VtuberAppsView"
             x:DataType="vm:VtuberAppsViewModel">
  <ScrollViewer Padding="24">
    <StackPanel MaxWidth="860" HorizontalAlignment="Left">
      <TextBlock Classes="h1" Text="VTuber apps" />
      <TextBlock Classes="muted" TextWrapping="Wrap" Margin="0,0,0,8"
                 Text="Let chat change your avatar. Each app below can be controlled from an action (look for its name in the step list), and changes in the app can start actions. None of them needs a password. Settings are stored in streamapps.json." />

      <!-- veadotube -->
      <Border Classes="card" DataContext="{Binding Veadotube}">
        <StackPanel Spacing="8">
          <TextBlock Classes="h2" Text="veadotube (mini or full)" />
          <TextBlock Classes="muted" TextWrapping="Wrap"
                     Text="Cuebot finds veadotube by itself while it is open (it picks a new &quot;door&quot; number every time it starts); its WebSocket server must be on (it is by default). Then actions can change your avatar state and push-to-talk, and state changes can start actions. For push-to-talk, tick &quot;use websocket&quot; in veadotube mini's push-to-talk settings." />
          <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto">
            <TextBlock Text="Which veadotube" VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBox Grid.Column="1" Name="VeadoInstance" Text="{Binding Instance}" PlaceholderText="Leave empty for the first one that is open"
                     ToolTip.Tip="Most people leave this empty. If you run more than one, type its name (for example veadotube mini). On another computer, type its address like 192.168.1.20:2424." />
          </Grid>
          <CheckBox Content="Connect automatically on startup" IsChecked="{Binding AutoConnect}" ToolTip.Tip="Connects to veadotube as soon as Cuebot starts." />
          <CheckBox Content="Keep looking when veadotube closes (or is not open yet)" IsChecked="{Binding AutoReconnect}"
                    ToolTip.Tip="Tries again by itself, so you can open veadotube before or after Cuebot." />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="Connect" Classes="accent" Command="{Binding ConnectCommand}" ToolTip.Tip="Connects Cuebot to veadotube." />
            <Button Content="Disconnect" Command="{Binding DisconnectCommand}" ToolTip.Tip="Closes the connection to veadotube." />
            <Button Content="Which are open?" Command="{Binding FindOpenCommand}" ToolTip.Tip="Lists the veadotube programs open on this computer right now." />
            <Button Content="Toggle push-to-talk" Command="{Binding TogglePushToTalkCommand}" IsEnabled="{Binding IsConnected}"
                    ToolTip.Tip="Turns veadotube's push-to-talk on or off, as a test." />
          </StackPanel>
          <TextBlock TextWrapping="Wrap">
            <Run Text="{Binding State}" FontWeight="SemiBold" /><Run Text="  " /><Run Text="{Binding StatusMessage}" Foreground="{StaticResource CuebotMuted}" />
          </TextBlock>
          <TextBlock Classes="muted" Text="{Binding PushToTalk}" />
          <TextBlock Classes="muted" Text="Connect to list your avatar states." IsVisible="{Binding HasNoStates}" />
          <ItemsControl Name="VeadoStates" ItemsSource="{Binding States}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:VtuberRowViewModel">
                <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,2">
                  <Image Source="{Binding Image}" IsVisible="{Binding HasImage}" Width="40" Height="40" Margin="0,0,8,0"
                         AutomationProperties.Name="{Binding Name}" />
                  <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" />
                  <Button Grid.Column="2" Content="{Binding ActionLabel}" Command="{Binding RunCommand}" ToolTip.Tip="{Binding Tip}" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Classes="muted" TextWrapping="Wrap" Text="{Binding Info}" />
          <TextBlock Classes="error" TextWrapping="Wrap" Text="{Binding Error}" />
        </StackPanel>
      </Border>

      <!-- PNGTuber Remix -->
      <Border Classes="card" DataContext="{Binding PngtuberRemix}">
        <StackPanel Spacing="8">
          <TextBlock Classes="h2" Text="PNGTuber Remix" />
          <TextBlock Classes="muted" TextWrapping="Wrap"
                     Text="In PNGTuber Remix, open the WebSocket tab on the right (use the arrows next to the tabs to find it), tick Auto-Start and press Start. Then actions can switch your avatar state, show or hide sprites (like a hat), shake or bounce them, and throw things at your avatar." />
          <Grid ColumnDefinitions="Auto,*,Auto,140" RowDefinitions="Auto">
            <TextBlock Text="Host" VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBox Grid.Column="1" Name="RemixHost" Text="{Binding Host}" PlaceholderText="127.0.0.1"
                     ToolTip.Tip="The computer where PNGTuber Remix runs. 127.0.0.1 means this same computer, so most people can leave it." />
            <TextBlock Grid.Column="2" Text="Port" VerticalAlignment="Center" Margin="12,0,8,0" />
            <NumericUpDown Grid.Column="3" Name="RemixPort" Value="{Binding Port}" Minimum="1" Maximum="65535" FormatString="0"
                           ToolTip.Tip="The &quot;door&quot; number in PNGTuber Remix's WebSocket tab (9321). Only change it if you changed it there too." />
          </Grid>
          <CheckBox Content="Connect automatically on startup" IsChecked="{Binding AutoConnect}" ToolTip.Tip="Connects to PNGTuber Remix as soon as Cuebot starts." />
          <CheckBox Content="Keep trying when PNGTuber Remix closes (or is not started yet)" IsChecked="{Binding AutoReconnect}"
                    ToolTip.Tip="Tries again by itself, so you can open PNGTuber Remix before or after Cuebot." />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="Connect" Classes="accent" Command="{Binding ConnectCommand}" ToolTip.Tip="Connects Cuebot to PNGTuber Remix." />
            <Button Content="Disconnect" Command="{Binding DisconnectCommand}" ToolTip.Tip="Closes the connection to PNGTuber Remix." />
            <Button Content="Reload" Command="{Binding ReloadCommand}" IsEnabled="{Binding IsConnected}"
                    ToolTip.Tip="Reads your states and sprites again. Use it after you change your model." />
            <Button Content="Throw test" Command="{Binding ThrowTestCommand}" IsEnabled="{Binding IsConnected}"
                    ToolTip.Tip="Throws some of your throwable images at your avatar now, as a test." />
          </StackPanel>
          <TextBlock TextWrapping="Wrap">
            <Run Text="{Binding State}" FontWeight="SemiBold" /><Run Text="  " /><Run Text="{Binding StatusMessage}" Foreground="{StaticResource CuebotMuted}" />
          </TextBlock>
          <TextBlock Classes="muted" Text="Connect to list your avatar states." IsVisible="{Binding HasNoStates}" />
          <ItemsControl Name="RemixStates" ItemsSource="{Binding States}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:VtuberRowViewModel">
                <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                  <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                  <Button Grid.Column="1" Content="{Binding ActionLabel}" Command="{Binding RunCommand}" ToolTip.Tip="{Binding Tip}" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Classes="muted" TextWrapping="Wrap" Text="{Binding Info}" />
          <TextBlock Classes="error" TextWrapping="Wrap" Text="{Binding Error}" />
        </StackPanel>
      </Border>

      <!-- RahiTuber -->
      <Border Classes="card" DataContext="{Binding Rahituber}">
        <StackPanel Spacing="8">
          <TextBlock Classes="h2" Text="RahiTuber" />
          <TextBlock Classes="muted" TextWrapping="Wrap"
                     Text="In RahiTuber open the menu (Esc), then Preferences, then Integration, and tick &quot;Control States via HTTP&quot;. Then actions can press your states like their hotkeys. Use a state's name, or its place in the list counted from 0 (0 is the top one)." />
          <Grid ColumnDefinitions="Auto,*,Auto,140" RowDefinitions="Auto">
            <TextBlock Text="Host" VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBox Grid.Column="1" Name="RahituberHost" Text="{Binding Host}" PlaceholderText="127.0.0.1"
                     ToolTip.Tip="The computer where RahiTuber runs. 127.0.0.1 means this same computer, so most people can leave it." />
            <TextBlock Grid.Column="2" Text="Port" VerticalAlignment="Center" Margin="12,0,8,0" />
            <NumericUpDown Grid.Column="3" Name="RahituberPort" Value="{Binding Port}" Minimum="1" Maximum="65535" FormatString="0"
                           ToolTip.Tip="The HTTP Port next to &quot;Control States via HTTP&quot; in RahiTuber (8000). Only change it if you changed it there too." />
          </Grid>
          <Grid ColumnDefinitions="Auto,*,Auto,Auto" RowDefinitions="Auto">
            <TextBlock Text="Test state" VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBox Grid.Column="1" Name="RahituberTestState" Text="{Binding TestState}"
                     ToolTip.Tip="A state's name, or its number counted from 0." />
            <Button Grid.Column="2" Margin="8,0,0,0" Content="Press it" Classes="accent" Command="{Binding SendTestCommand}"
                    ToolTip.Tip="Presses this state in RahiTuber now, as a test. Watch your avatar." />
            <Button Grid.Column="3" Margin="8,0,0,0" Content="Check connection" Command="{Binding ConnectCommand}"
                    ToolTip.Tip="Checks that RahiTuber answers, without changing your avatar." />
          </Grid>
          <TextBlock TextWrapping="Wrap">
            <Run Text="{Binding State}" FontWeight="SemiBold" /><Run Text="  " /><Run Text="{Binding StatusMessage}" Foreground="{StaticResource CuebotMuted}" />
          </TextBlock>
          <TextBlock Classes="muted" TextWrapping="Wrap" Text="{Binding Info}" />
          <TextBlock Classes="error" TextWrapping="Wrap" Text="{Binding Error}" />
        </StackPanel>
      </Border>

      <!-- VNyan -->
      <Border Classes="card" DataContext="{Binding Vnyan}">
        <StackPanel Spacing="8">
          <TextBlock Classes="h2" Text="VNyan" />
          <TextBlock Classes="muted" TextWrapping="Wrap"
                     Text="In VNyan's node graph, add an &quot;API Message&quot; node and type a name into it, for example Wave. Then use the &quot;Send to VNyan&quot; step with that same name, and whatever you connect after the node runs. VNyan's API is on by default on port 8069." />
          <Grid ColumnDefinitions="Auto,*,Auto,140" RowDefinitions="Auto">
            <TextBlock Text="Host" VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBox Grid.Column="1" Name="VnyanHost" Text="{Binding Host}" PlaceholderText="127.0.0.1"
                     ToolTip.Tip="The address of the computer where VNyan runs. 127.0.0.1 means this same computer, so most people can leave it." />
            <TextBlock Grid.Column="2" Text="Port" VerticalAlignment="Center" Margin="12,0,8,0" />
            <NumericUpDown Grid.Column="3" Name="VnyanPort" Value="{Binding Port}" Minimum="1" Maximum="65535" FormatString="0"
                           ToolTip.Tip="The &quot;door&quot; number of VNyan's API. Only change it if you changed it in VNyan too." />
          </Grid>
          <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto">
            <TextBlock Text="Test name" VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBox Grid.Column="1" Name="VnyanTestAction" Text="{Binding TestAction}"
                     ToolTip.Tip="The name of an API Message node in VNyan to run as a test." />
            <Button Grid.Column="2" Margin="8,0,0,0" Content="Send test" Classes="accent" Command="{Binding SendTestCommand}"
                    ToolTip.Tip="Sends this name to VNyan now. VNyan says it got it; your node then runs." />
          </Grid>
          <TextBlock TextWrapping="Wrap">
            <Run Text="{Binding State}" FontWeight="SemiBold" /><Run Text="  " /><Run Text="{Binding StatusMessage}" Foreground="{StaticResource CuebotMuted}" />
          </TextBlock>
          <TextBlock Classes="muted" TextWrapping="Wrap" Text="{Binding Info}" />
          <TextBlock Classes="error" TextWrapping="Wrap" Text="{Binding Error}" />
        </StackPanel>
      </Border>

      <!-- VRChat -->
      <Border Classes="card" DataContext="{Binding Vrchat}">
        <StackPanel Spacing="8">
          <TextBlock Classes="h2" Text="VRChat (OSC)" />
          <TextBlock Classes="muted" TextWrapping="Wrap"
                     Text="In VRChat open the Action Menu, then Options, then OSC, and make sure it is Enabled. Cuebot can then set your avatar's parameters (like toggling a hat), write in your chatbox, and start actions when you change avatar or a parameter changes." />
          <Grid ColumnDefinitions="Auto,*,Auto,110,Auto,110" RowDefinitions="Auto">
            <TextBlock Text="Host" VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBox Grid.Column="1" Name="VrchatHost" Text="{Binding Host}" PlaceholderText="127.0.0.1"
                     ToolTip.Tip="The computer where VRChat runs. 127.0.0.1 means this same computer." />
            <TextBlock Grid.Column="2" Text="Send to" VerticalAlignment="Center" Margin="12,0,8,0" />
            <NumericUpDown Grid.Column="3" Name="VrchatSendPort" Value="{Binding SendPort}" Minimum="1" Maximum="65535" FormatString="0"
                           ToolTip.Tip="The &quot;door&quot; VRChat listens on (9000 unless you changed it)." />
            <TextBlock Grid.Column="4" Text="Listen on" VerticalAlignment="Center" Margin="12,0,8,0" />
            <NumericUpDown Grid.Column="5" Name="VrchatListenPort" Value="{Binding ListenPort}" Minimum="1" Maximum="65535" FormatString="0"
                           ToolTip.Tip="The &quot;door&quot; VRChat talks back on (9001). Only one app can listen there; if another OSC tool already does, Cuebot can still send but cannot hear VRChat." />
          </Grid>
          <CheckBox Content="Connect automatically on startup" IsChecked="{Binding AutoConnect}" ToolTip.Tip="Opens the OSC connection as soon as Cuebot starts." />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="Connect" Classes="accent" Command="{Binding ConnectCommand}" ToolTip.Tip="Opens the OSC connection to VRChat." />
            <Button Content="Disconnect" Command="{Binding DisconnectCommand}" ToolTip.Tip="Closes the OSC connection." />
          </StackPanel>
          <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto">
            <TextBlock Text="Chatbox test" VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBox Grid.Column="1" Name="VrchatChatText" Text="{Binding ChatText}" MaxLength="144"
                     ToolTip.Tip="Text to show above your avatar. Everyone in your world can see it." />
            <Button Grid.Column="2" Margin="8,0,0,0" Content="Send" Command="{Binding SendChatCommand}" IsEnabled="{Binding IsConnected}"
                    ToolTip.Tip="Shows this text in your VRChat chatbox now. Everyone in your world can see it." />
          </Grid>
          <TextBlock TextWrapping="Wrap">
            <Run Text="{Binding State}" FontWeight="SemiBold" /><Run Text="  " /><Run Text="{Binding StatusMessage}" Foreground="{StaticResource CuebotMuted}" />
          </TextBlock>
          <TextBlock Classes="muted" TextWrapping="Wrap" Text="{Binding Heard}" />
          <TextBlock Classes="muted" TextWrapping="Wrap" Text="{Binding Info}" />
          <TextBlock Classes="error" TextWrapping="Wrap" Text="{Binding Error}" />
        </StackPanel>
      </Border>

      <!-- Warudo -->
      <Border Classes="card" DataContext="{Binding Warudo}">
        <StackPanel Spacing="8">
          <TextBlock Classes="h2" Text="Warudo" />
          <TextBlock Classes="muted" TextWrapping="Wrap"
                     Text="Cuebot uses the same door as Warudo's built-in Stream Deck support, so no mod is needed. In a Warudo blueprint, add an &quot;On Stream Deck Trigger&quot;, &quot;On Stream Deck Toggle&quot; or &quot;On Stream Deck Message&quot; node and type a Receiver Name. Warudo only opens the door once your scene has one of these nodes." />
          <Grid ColumnDefinitions="Auto,*,Auto,140" RowDefinitions="Auto">
            <TextBlock Text="Host" VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBox Grid.Column="1" Name="WarudoHost" Text="{Binding Host}" PlaceholderText="localhost"
                     ToolTip.Tip="Warudo only listens on its own computer, so leave this as localhost." />
            <TextBlock Grid.Column="2" Text="Port" VerticalAlignment="Center" Margin="12,0,8,0" />
            <NumericUpDown Grid.Column="3" Name="WarudoPort" Value="{Binding Port}" Minimum="1" Maximum="65535" FormatString="0"
                           ToolTip.Tip="Warudo's Stream Deck door number, 19069. You should not need to change it." />
          </Grid>
          <Grid ColumnDefinitions="*,Auto,140" RowDefinitions="Auto">
            <TextBlock Classes="muted" TextWrapping="Wrap" VerticalAlignment="Center"
                       Text="Warudo's own WebSocket door is always open while Warudo runs. The step Send WebSocket message to Warudo uses it for On WebSocket Message Received nodes." />
            <TextBlock Grid.Column="1" Text="WebSocket port" VerticalAlignment="Center" Margin="12,0,8,0" />
            <NumericUpDown Grid.Column="2" Name="WarudoWebSocketPort" Value="{Binding WebSocketPort}" Minimum="1" Maximum="65535" FormatString="0"
                           ToolTip.Tip="Warudo's WebSocket door number, 19190. You should not need to change it." />
          </Grid>
          <CheckBox Content="Connect automatically on startup" IsChecked="{Binding AutoConnect}" ToolTip.Tip="Connects to Warudo as soon as Cuebot starts." />
          <CheckBox Content="Keep trying when Warudo closes (or is not listening yet)" IsChecked="{Binding AutoReconnect}"
                    ToolTip.Tip="Tries again by itself, so you can open Warudo before or after Cuebot." />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="Connect" Classes="accent" Command="{Binding ConnectCommand}" ToolTip.Tip="Connects Cuebot to Warudo." />
            <Button Content="Disconnect" Command="{Binding DisconnectCommand}" ToolTip.Tip="Closes the connection to Warudo." />
            <Button Content="Reload receivers" Command="{Binding ReloadCommand}" IsEnabled="{Binding IsConnected}"
                    ToolTip.Tip="Asks Warudo again for the Receiver Names in your scene. Use it after you add a node." />
            <Button Content="Test WebSocket" Command="{Binding TestWebSocketCommand}"
                    ToolTip.Tip="Sends &quot;Hello from Cuebot&quot; to Warudo's On WebSocket Message Received nodes." />
          </StackPanel>
          <TextBlock TextWrapping="Wrap">
            <Run Text="{Binding State}" FontWeight="SemiBold" /><Run Text="  " /><Run Text="{Binding StatusMessage}" Foreground="{StaticResource CuebotMuted}" />
          </TextBlock>
          <TextBlock Classes="muted" Text="Connect to list the receivers in your Warudo scene." IsVisible="{Binding HasNoReceivers}" />
          <ItemsControl Name="WarudoReceivers" ItemsSource="{Binding Receivers}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:VtuberRowViewModel">
                <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                  <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                  <Button Grid.Column="1" Content="{Binding ActionLabel}" Command="{Binding RunCommand}" ToolTip.Tip="{Binding Tip}" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Classes="muted" TextWrapping="Wrap" Text="{Binding Info}" />
          <TextBlock Classes="error" TextWrapping="Wrap" Text="{Binding Error}" />
        </StackPanel>
      </Border>

      <!-- nizima LIVE -->
      <Border Classes="card" DataContext="{Binding Nizima}">
        <StackPanel Spacing="8">
          <TextBlock Classes="h2" Text="nizima LIVE" />
          <TextBlock Classes="muted" TextWrapping="Wrap"
                     Text="In nizima LIVE open the Plugin Manager and switch the plug-in function on. Press Connect here: Cuebot appears in the Plugin Manager. Switch Cuebot on there (only the first time). Then actions can turn expressions on and off, play motions, press the model's hotkeys, show items and switch effects." />
          <Grid ColumnDefinitions="Auto,140" RowDefinitions="Auto">
            <TextBlock Text="Port" VerticalAlignment="Center" Margin="0,0,8,0" />
            <NumericUpDown Grid.Column="1" Name="NizimaPort" Value="{Binding Port}" Minimum="1" Maximum="65535" FormatString="0"
                           ToolTip.Tip="The port shown in nizima LIVE's Plugin Manager (22022 unless nizima LIVE had to pick another)." />
          </Grid>
          <CheckBox Content="Connect automatically on startup" IsChecked="{Binding AutoConnect}" ToolTip.Tip="Connects to nizima LIVE as soon as Cuebot starts." />
          <CheckBox Content="Keep trying when nizima LIVE closes (or its plug-ins are off)" IsChecked="{Binding AutoReconnect}"
                    ToolTip.Tip="Tries again by itself, so you can open nizima LIVE before or after Cuebot." />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="Connect" Classes="accent" Command="{Binding ConnectCommand}" ToolTip.Tip="Connects Cuebot to nizima LIVE." />
            <Button Content="Disconnect" Command="{Binding DisconnectCommand}" ToolTip.Tip="Closes the connection to nizima LIVE." />
            <Button Content="Reload" Command="{Binding ReloadCommand}" IsEnabled="{Binding IsConnected}"
                    ToolTip.Tip="Reads your models, expressions, motions, items and effects again." />
          </StackPanel>
          <TextBlock TextWrapping="Wrap">
            <Run Text="{Binding State}" FontWeight="SemiBold" /><Run Text="  " /><Run Text="{Binding StatusMessage}" Foreground="{StaticResource CuebotMuted}" />
          </TextBlock>
          <TextBlock Classes="muted" Text="Connect to list your model's expressions." IsVisible="{Binding HasNoExpressions}" />
          <ItemsControl Name="NizimaExpressions" ItemsSource="{Binding Expressions}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:VtuberRowViewModel">
                <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                  <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                  <Button Grid.Column="1" Content="{Binding ActionLabel}" Command="{Binding RunCommand}" ToolTip.Tip="{Binding Tip}" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Classes="muted" TextWrapping="Wrap" Text="{Binding Info}" />
          <TextBlock Classes="error" TextWrapping="Wrap" Text="{Binding Error}" />
        </StackPanel>
      </Border>

      <!-- Animaze -->
      <Border Classes="card" DataContext="{Binding Animaze}">
        <StackPanel Spacing="8">
          <TextBlock Classes="h2" Text="Animaze" />
          <TextBlock Classes="muted" TextWrapping="Wrap"
                     Text="In Animaze open Settings, then Animaze API, and switch it on (it is off at first). Then actions can change your avatar or background, play emotes, special actions and poses, and start actions when you change avatar." />
          <Grid ColumnDefinitions="Auto,*,Auto,140" RowDefinitions="Auto">
            <TextBlock Text="Host" VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBox Grid.Column="1" Name="AnimazeHost" Text="{Binding Host}" PlaceholderText="127.0.0.1"
                     ToolTip.Tip="The computer where Animaze runs. 127.0.0.1 means this same computer." />
            <TextBlock Grid.Column="2" Text="Port" VerticalAlignment="Center" Margin="12,0,8,0" />
            <NumericUpDown Grid.Column="3" Name="AnimazePort" Value="{Binding Port}" Minimum="1" Maximum="65535" FormatString="0"
                           ToolTip.Tip="The &quot;door&quot; number in Animaze's API settings (9000). Only change it if you changed it there too." />
          </Grid>
          <CheckBox Content="Connect automatically on startup" IsChecked="{Binding AutoConnect}" ToolTip.Tip="Connects to Animaze as soon as Cuebot starts." />
          <CheckBox Content="Keep trying when Animaze closes (or its API is off)" IsChecked="{Binding AutoReconnect}"
                    ToolTip.Tip="Tries again by itself, so you can open Animaze before or after Cuebot." />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="Connect" Classes="accent" Command="{Binding ConnectCommand}" ToolTip.Tip="Connects Cuebot to Animaze." />
            <Button Content="Disconnect" Command="{Binding DisconnectCommand}" ToolTip.Tip="Closes the connection to Animaze." />
            <Button Content="Reload" Command="{Binding ReloadCommand}" IsEnabled="{Binding IsConnected}"
                    ToolTip.Tip="Reads your avatars, emotes and animations again." />
          </StackPanel>
          <TextBlock TextWrapping="Wrap">
            <Run Text="{Binding State}" FontWeight="SemiBold" /><Run Text="  " /><Run Text="{Binding StatusMessage}" Foreground="{StaticResource CuebotMuted}" />
          </TextBlock>
          <TextBlock Classes="muted" Text="{Binding Avatar}" />
          <TextBlock Classes="muted" Text="Connect to list your avatar's emotes." IsVisible="{Binding HasNoEmotes}" />
          <ItemsControl Name="AnimazeEmotes" ItemsSource="{Binding Emotes}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:VtuberRowViewModel">
                <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                  <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                  <Button Grid.Column="1" Content="{Binding ActionLabel}" Command="{Binding RunCommand}" ToolTip.Tip="{Binding Tip}" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Classes="muted" TextWrapping="Wrap" Text="{Binding Info}" />
          <TextBlock Classes="error" TextWrapping="Wrap" Text="{Binding Error}" />
        </StackPanel>
      </Border>

      <!-- VMC -->
      <Border Classes="card" DataContext="{Binding Vmc}">
        <StackPanel Spacing="8">
          <TextBlock Classes="h2" Text="VMC (VSeeFace, VMagicMirror and other 3D apps)" />
          <TextBlock Classes="muted" TextWrapping="Wrap"
                     Text="VMC is a shared language many 3D VTuber apps understand. Cuebot uses it to make your avatar smile, look angry and so on. Switch on the app's VMC receiver (in VSeeFace: Settings, General settings, VMC receiver, and untick Apply expressions so Cuebot's win). Most apps listen on port 39539." />
          <Grid ColumnDefinitions="Auto,*,Auto,140" RowDefinitions="Auto">
            <TextBlock Text="Host" VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBox Grid.Column="1" Name="VmcHost" Text="{Binding Host}" PlaceholderText="127.0.0.1"
                     ToolTip.Tip="The computer where your 3D app runs. 127.0.0.1 means this same computer." />
            <TextBlock Grid.Column="2" Text="Port" VerticalAlignment="Center" Margin="12,0,8,0" />
            <NumericUpDown Grid.Column="3" Name="VmcPort" Value="{Binding Port}" Minimum="1" Maximum="65535" FormatString="0"
                           ToolTip.Tip="The &quot;door&quot; number of your app's VMC receiver (39539 in most apps)." />
          </Grid>
          <CheckBox Content="Connect automatically on startup" IsChecked="{Binding AutoConnect}" ToolTip.Tip="Gets VMC ready as soon as Cuebot starts." />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="Connect" Classes="accent" Command="{Binding ConnectCommand}" ToolTip.Tip="Gets Cuebot ready to send VMC." />
            <Button Content="Disconnect" Command="{Binding DisconnectCommand}" ToolTip.Tip="Stops sending VMC." />
          </StackPanel>
          <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto">
            <TextBlock Text="Test expression" VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBox Grid.Column="1" Name="VmcTestExpression" Text="{Binding TestExpression}"
                     ToolTip.Tip="An expression your avatar has, like Joy, Angry, Sorrow, Fun or Surprised." />
            <Button Grid.Column="2" Margin="8,0,0,0" Content="Show for 3 seconds" Classes="accent" Command="{Binding SendTestCommand}" IsEnabled="{Binding IsConnected}"
                    ToolTip.Tip="Shows this expression on your avatar for 3 seconds, as a test. VMC never answers, so watch your avatar." />
          </Grid>
          <TextBlock TextWrapping="Wrap">
            <Run Text="{Binding State}" FontWeight="SemiBold" /><Run Text="  " /><Run Text="{Binding StatusMessage}" Foreground="{StaticResource CuebotMuted}" />
          </TextBlock>
          <TextBlock Classes="muted" TextWrapping="Wrap" Text="{Binding Info}" />
          <TextBlock Classes="error" TextWrapping="Wrap" Text="{Binding Error}" />
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>

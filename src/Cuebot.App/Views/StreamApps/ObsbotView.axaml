<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Cuebot.App.ViewModels.StreamApps"
             x:Class="Cuebot.App.Views.StreamApps.ObsbotView"
             x:DataType="vm:ObsbotViewModel">
  <ScrollViewer Padding="24">
    <StackPanel MaxWidth="860" HorizontalAlignment="Left">
      <TextBlock Classes="h1" Text="OBSBOT" />
      <TextBlock Classes="muted" TextWrapping="Wrap" Margin="0,0,0,8"
                 Text="Control OBSBOT Tiny, Meet and Tail cameras. Cuebot talks to OBSBOT Center (the camera's own app) using OSC, a simple remote-control language, or straight to a Tail 2 / Tail Air. Settings are stored in streamapps.json." />
      <Border Classes="card">
        <StackPanel Spacing="8">
          <TextBlock Classes="h2" Text="OBSBOT Center (OSC)" />
          <TextBlock Classes="muted" TextWrapping="Wrap"
                     Text="In OBSBOT Center open Settings → OSC, switch OSC on and pick UDP or TCP. Enter its receive port below (and, for UDP, the port it sends replies to). OBSBOT Center runs on Windows and macOS; on Linux point Cuebot at a Tail 2 / Tail Air's own IP, or at a Windows/Mac PC running Center. OSC has no password: only allow it on networks you trust." />
          <Grid ColumnDefinitions="Auto,*,Auto,150,Auto,110" RowDefinitions="Auto">
            <TextBlock Text="Host" VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBox Grid.Column="1" Name="ObsbotHost" Text="{Binding Host}" PlaceholderText="127.0.0.1"
                     ToolTip.Tip="The address of the computer running OBSBOT Center, or the camera itself for Tail 2 / Tail Air direct. 127.0.0.1 means this same computer." />
            <TextBlock Grid.Column="2" Text="Port" VerticalAlignment="Center" Margin="12,0,8,0" />
            <NumericUpDown Grid.Column="3" Name="ObsbotPort" Value="{Binding Port}" Minimum="1" Maximum="65535" FormatString="0"
                             ToolTip.Tip="The port OBSBOT Center listens on. Copy the number shown in OBSBOT Center under Settings → OSC." />
            <ComboBox Grid.Column="5" Margin="12,0,0,0" ItemsSource="{Binding Transports}" SelectedIndex="{Binding TransportIndex}"
                      ToolTip.Tip="How messages travel to OBSBOT Center. Pick the same one (UDP or TCP) that you chose in OBSBOT Center." />
          </Grid>
          <Grid ColumnDefinitions="Auto,150,Auto,110,Auto,*" RowDefinitions="Auto">
            <TextBlock Text="Reply port (UDP)" VerticalAlignment="Center" Margin="0,0,8,0" />
            <NumericUpDown Grid.Column="1" Value="{Binding ListenPort}" Minimum="0" Maximum="65535" FormatString="0" IsEnabled="{Binding IsUdp}"
                             ToolTip.Tip="Only for UDP. The port Cuebot listens on to hear OBSBOT Center's replies. Use the reply port set in OBSBOT Center." />
            <TextBlock Grid.Column="2" Text="Poll every (s)" VerticalAlignment="Center" Margin="12,0,8,0" />
            <NumericUpDown Grid.Column="3" Value="{Binding PollSeconds}" Minimum="0" Maximum="3600" FormatString="0"
                             ToolTip.Tip="How often, in seconds, Cuebot asks the camera for its latest state. 0 means never ask." />
            <ComboBox Grid.Column="5" Margin="12,0,0,0" ItemsSource="{Binding SeriesNames}" SelectedIndex="{Binding SeriesIndex}"
                      ToolTip.Tip="Which kind of OBSBOT camera you have. Auto works it out from the camera name, so leave it unless controls do not work." />
          </Grid>
          <CheckBox Content="Connect automatically on startup" IsChecked="{Binding AutoConnect}" ToolTip.Tip="Connects as soon as Cuebot starts, so you do not have to press Connect." />
          <CheckBox Content="Reconnect when the connection drops (or OBSBOT Center is not running yet)" IsChecked="{Binding AutoReconnect}"
                    ToolTip.Tip="Tries to connect again by itself if the connection is lost, or if OBSBOT Center was not open yet when Cuebot started." />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="Connect" Classes="accent" Command="{Binding ConnectCommand}" ToolTip.Tip="Connects Cuebot to OBSBOT Center (or the camera) using the settings above." />
            <Button Content="Disconnect" Command="{Binding DisconnectCommand}" ToolTip.Tip="Closes the connection to the camera control." />
            <Button Content="Refresh" Command="{Binding RefreshStateCommand}" IsEnabled="{Binding CanSend}"
                    ToolTip.Tip="Asks the camera for its current state, like zoom and presets." />
          </StackPanel>
          <TextBlock TextWrapping="Wrap">
            <Run Text="{Binding State}" FontWeight="SemiBold" /><Run Text="  " /><Run Text="{Binding StatusMessage}" Foreground="{StaticResource CuebotMuted}" />
          </TextBlock>
          <TextBlock Name="ObsbotCamera" TextWrapping="Wrap">
            <Run Text="Camera: " FontWeight="SemiBold" /><Run Text="{Binding Camera}" />
          </TextBlock>
          <TextBlock TextWrapping="Wrap">
            <Run Text="Presets: " FontWeight="SemiBold" /><Run Text="{Binding Presets}" />
          </TextBlock>
          <TextBlock Text="Cameras in OBSBOT Center" FontWeight="SemiBold" />
          <TextBlock Classes="muted" Text="Connect to list the cameras OBSBOT Center sees." IsVisible="{Binding HasNoDevices}" />
          <ItemsControl Name="ObsbotDevices" ItemsSource="{Binding Devices}" />

          <TextBlock Text="Quick controls" FontWeight="SemiBold" Margin="0,4,0,0" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="◀" Command="{Binding NudgeCommand}" CommandParameter="Left" IsEnabled="{Binding CanSend}" ToolTip.Tip="Turns the camera a little to the left." />
            <Button Content="▲" Command="{Binding NudgeCommand}" CommandParameter="Up" IsEnabled="{Binding CanSend}" ToolTip.Tip="Tilts the camera a little up." />
            <Button Content="▼" Command="{Binding NudgeCommand}" CommandParameter="Down" IsEnabled="{Binding CanSend}" ToolTip.Tip="Tilts the camera a little down." />
            <Button Content="▶" Command="{Binding NudgeCommand}" CommandParameter="Right" IsEnabled="{Binding CanSend}" ToolTip.Tip="Turns the camera a little to the right." />
            <Button Content="Reset gimbal" Command="{Binding ResetGimbalCommand}" IsEnabled="{Binding CanSend}"
                    ToolTip.Tip="Points the camera back to its straight-ahead starting position (the gimbal is the motor that moves it)." />
            <Button Content="AI lock" Command="{Binding ToggleAiLockCommand}" IsEnabled="{Binding CanSend}"
                    ToolTip.Tip="Turns the camera's automatic tracking lock on or off. When locked, the camera keeps following the person it is tracking." />
            <Button Content="Snapshot" Command="{Binding SnapshotCommand}" IsEnabled="{Binding CanSend}"
                    ToolTip.Tip="Takes a picture. OBSBOT Center saves it while its preview window is open." />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="Zoom" VerticalAlignment="Center" />
            <NumericUpDown Name="ObsbotZoom" Value="{Binding Zoom}" Minimum="0" Maximum="100" FormatString="0" Width="120"
                             ToolTip.Tip="How close the camera zooms, from 0 (widest) to 100 (closest). Press Set zoom to apply it." />
            <Button Content="Set zoom" Command="{Binding ApplyZoomCommand}" IsEnabled="{Binding CanSend}"
                    ToolTip.Tip="Zooms the camera to the number in the box." />
            <TextBlock Text="Preset" VerticalAlignment="Center" Margin="12,0,0,0" />
            <Button Content="1" Command="{Binding PresetCommand}" CommandParameter="1" IsEnabled="{Binding CanSend}" ToolTip.Tip="Moves the camera to saved position number 1 (a camera preset)." />
            <Button Content="2" Command="{Binding PresetCommand}" CommandParameter="2" IsEnabled="{Binding CanSend}" ToolTip.Tip="Moves the camera to saved position number 2." />
            <Button Content="3" Command="{Binding PresetCommand}" CommandParameter="3" IsEnabled="{Binding CanSend}" ToolTip.Tip="Moves the camera to saved position number 3." />
          </StackPanel>
          <TextBlock Classes="muted" TextWrapping="Wrap">
            <Run Text="Last OSC message: " /><Run Text="{Binding LastMessage}" />
          </TextBlock>
          <TextBlock Classes="muted" TextWrapping="Wrap" Text="{Binding Info}" />
          <TextBlock Classes="error" TextWrapping="Wrap" Text="{Binding Error}" />
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>

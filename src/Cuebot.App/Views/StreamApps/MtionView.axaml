<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Cuebot.App.ViewModels.StreamApps"
             x:Class="Cuebot.App.Views.StreamApps.MtionView"
             x:DataType="vm:MtionViewModel">
  <ScrollViewer Padding="24">
    <StackPanel MaxWidth="860" HorizontalAlignment="Left">
      <TextBlock Classes="h1" Text="mtion studio" />
      <TextBlock Classes="muted" TextWrapping="Wrap" Margin="0,0,0,8"
                 Text="Fire mtion studio's external triggers and read the open clubhouse through mtion's local developer API. Settings are stored in streamapps.json." />
      <Border Classes="card">
        <StackPanel Spacing="8">
          <TextBlock Classes="h2" Text="Developer API" />
          <TextBlock Classes="muted" TextWrapping="Wrap"
                     Text="While mtion studio is open it can be reached at http://localhost:35393. There is nothing to switch on and no key or password. Add external triggers to your clubhouse in mtion, then use them in the &quot;Send trigger&quot; sub-action (an action step)." />
          <Grid ColumnDefinitions="Auto,*,Auto,150,Auto,110" RowDefinitions="Auto">
            <TextBlock Text="Host" VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBox Grid.Column="1" Name="MtionHost" Text="{Binding Host}" PlaceholderText="localhost"
                     ToolTip.Tip="The address of the computer where mtion studio runs. 127.0.0.1 (or localhost) means this same computer, so most people can leave it." />
            <TextBlock Grid.Column="2" Text="Port" VerticalAlignment="Center" Margin="12,0,8,0" />
            <NumericUpDown Grid.Column="3" Value="{Binding Port}" Minimum="1" Maximum="65535" FormatString="0"
                             ToolTip.Tip="A number that says which &quot;door&quot; on that computer Cuebot connects to. Only change it if you changed it in mtion studio too." />
            <TextBlock Grid.Column="4" Text="Check every (s)" VerticalAlignment="Center" Margin="12,0,8,0" />
            <NumericUpDown Grid.Column="5" Value="{Binding PollSeconds}" Minimum="1" Maximum="3600" FormatString="0"
                             ToolTip.Tip="How often, in seconds, Cuebot looks at mtion studio to see if it is running and what triggers it has." />
          </Grid>
          <CheckBox Content="Watch for mtion studio on startup" IsChecked="{Binding AutoConnect}"
                    ToolTip.Tip="Starts watching for mtion studio as soon as Cuebot starts." />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="Start watching" Classes="accent" Command="{Binding ConnectCommand}"
                    ToolTip.Tip="Starts checking regularly for mtion studio and lists its triggers." />
            <Button Content="Stop" Command="{Binding DisconnectCommand}" ToolTip.Tip="Stops checking for mtion studio." />
            <Button Content="Check now" Command="{Binding CheckCommand}" ToolTip.Tip="Looks at mtion studio once, right now, without waiting for the next check." />
          </StackPanel>
          <TextBlock TextWrapping="Wrap">
            <Run Text="{Binding State}" FontWeight="SemiBold" /><Run Text="  " /><Run Text="{Binding StatusMessage}" Foreground="{StaticResource CuebotMuted}" />
          </TextBlock>
          <TextBlock Name="MtionClubhouse" TextWrapping="Wrap">
            <Run Text="Clubhouse: " FontWeight="SemiBold" /><Run Text="{Binding Clubhouse}" />
          </TextBlock>
          <TextBlock Text="External triggers" FontWeight="SemiBold" />
          <TextBlock Classes="muted" Text="Start watching (or check now) to list the open clubhouse's external triggers." IsVisible="{Binding HasNoTriggers}" />
          <ItemsControl Name="MtionTriggers" ItemsSource="{Binding Triggers}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:MtionTriggerRowViewModel">
                <Grid ColumnDefinitions="200,*,Auto" Margin="0,2">
                  <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="1" Classes="muted" Text="{Binding Details}" VerticalAlignment="Center" TextWrapping="Wrap" />
                  <Button Grid.Column="2" Content="Fire" Command="{Binding FireCommand}" ToolTip.Tip="Sets off this trigger in mtion studio right now, as a test." />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Classes="muted" TextWrapping="Wrap" Text="{Binding Info}" />
          <TextBlock Classes="error" TextWrapping="Wrap" Text="{Binding Error}" />
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Cuebot.App.ViewModels.Webhooks"
             x:Class="Cuebot.App.Views.Webhooks.WebhookServicesView"
             x:DataType="vm:WebhookServicesViewModel">
  <ScrollViewer Padding="24">
    <StackPanel MaxWidth="760" HorizontalAlignment="Left">
      <TextBlock Classes="h1" Text="Webhook services" />
      <TextBlock Classes="muted" TextWrapping="Wrap" Margin="0,0,0,8"
                 Text="Ko-fi, Patreon, Fourthwall, Shopify, Throne and your own hooks reach Cuebot through your relay (see the Relay tab). Cuebot checks each message with the secret you enter, or for Throne with its public key, so fakes are thrown away. A real message becomes triggers, items in the activity feed, spoken events and credits. Secrets are saved in webhooks.json, hidden here and never written to the log." />

      <ItemsControl ItemsSource="{Binding Services}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:WebhookCardViewModel">
            <Border Classes="card">
              <StackPanel Spacing="8">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Classes="h2" Text="{Binding Name}" />
                  <ToggleSwitch Grid.Column="1" IsChecked="{Binding Enabled}" OnContent="Enabled" OffContent="Off" ToolTip.Tip="Switches this service on or off. When off, its messages are ignored." />
                </Grid>
                <TextBlock Classes="muted" TextWrapping="Wrap" Text="{Binding Help}" />
                <TextBox Name="Secret" Text="{Binding Secret}" PasswordChar="•" PlaceholderText="{Binding SecretLabel}" ToolTip.Tip="The secret code you set up on the service's website. Cuebot uses it to check that messages really come from that service. It is hidden as dots. Keep it private." />
                <TextBlock Classes="muted" Text="{Binding MaskedSecret}" />
                <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding CanGenerate}">
                  <Button Content="Generate token" Command="{Binding GenerateCommand}" ToolTip.Tip="Makes a random token (a secret code) and shows it. Add it to the end of the web address you give to the service (as /token or ?token=token). Once it is set, messages without it are refused." />
                  <SelectableTextBlock Text="{Binding GeneratedToken}" VerticalAlignment="Center" FontFamily="monospace" />
                </StackPanel>
                <TextBlock Classes="muted" TextWrapping="Wrap" Text="{Binding LastDelivery}" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <ComboBox ItemsSource="{Binding TestKinds}" SelectedItem="{Binding SelectedTestKind}" MinWidth="180" ToolTip.Tip="The kind of pretend event to send." />
                  <Button Content="Send test event" Command="{Binding SendTestCommand}" ToolTip.Tip="Sends a pretend event to Cuebot, so you can try your triggers and actions. Nothing is sent to the real service." />
                </StackPanel>
                <TextBlock Classes="muted" TextWrapping="Wrap" Text="{Binding Info}" />
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <Border Classes="card" DataContext="{Binding Kofi}" x:DataType="vm:KofiOptionsViewModel">
        <StackPanel Spacing="8">
          <TextBlock Classes="h2" Text="Ko-fi extras" />
          <CheckBox Content="Show private supporters' names and messages" IsChecked="{Binding ShowPrivateSupporters}"
                    ToolTip.Tip="Off (best): when a supporter ticks 'make this private' on Ko-fi, triggers and overlays get &quot;Anonymous&quot; and no message. Their real name and message are only in %privateName% and %privateMessage%. The activity feed and credits always hide them." />
          <TextBlock Classes="muted" TextWrapping="Wrap"
                     Text="Ko-fi goal: Ko-fi has no way for apps to read the goal on your page, so Cuebot counts it from the payments it receives. Type what your Ko-fi goal already shows as the start amount. Test events never count." />
          <Grid ColumnDefinitions="*,8,140,8,140,8,90">
            <TextBox Text="{Binding GoalTitle}" PlaceholderText="Goal title" ToolTip.Tip="The goal's name, shown by goal widgets and in %kofiGoalTitle%." />
            <NumericUpDown Grid.Column="2" Value="{Binding GoalTarget}" Minimum="0" FormatString="0.##" ToolTip.Tip="The goal's target. 0 means no goal." />
            <NumericUpDown Grid.Column="4" Value="{Binding GoalStart}" Minimum="0" FormatString="0.##" ToolTip.Tip="What was raised before Cuebot started counting (copy it from your Ko-fi goal)." />
            <TextBox Grid.Column="6" Text="{Binding GoalCurrency}" PlaceholderText="USD" ToolTip.Tip="Only payments in this currency count, because Cuebot does not convert. Leave empty to count every currency." />
          </Grid>
          <WrapPanel>
            <CheckBox Content="Donations" IsChecked="{Binding CountDonations}" Margin="0,0,12,0" ToolTip.Tip="Donations count toward the goal." />
            <CheckBox Content="Memberships" IsChecked="{Binding CountMemberships}" Margin="0,0,12,0" ToolTip.Tip="Membership payments count toward the goal." />
            <CheckBox Content="Commissions" IsChecked="{Binding CountCommissions}" Margin="0,0,12,0" ToolTip.Tip="Commissions count toward the goal." />
            <CheckBox Content="Shop orders" IsChecked="{Binding CountShopOrders}" ToolTip.Tip="Shop orders count toward the goal." />
          </WrapPanel>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Classes="muted" Text="{Binding GoalProgress}" VerticalAlignment="Center" TextWrapping="Wrap" />
            <Button Content="Reset goal" Command="{Binding ResetGoalCommand}" ToolTip.Tip="Starts counting again from the start amount." />
          </StackPanel>
          <TextBlock Classes="muted" TextWrapping="Wrap"
                     Text="Product names: Ko-fi names a product without variations only by its code (the end of its link). One per line: code = name | picture link (the picture is optional)." />
          <TextBox Text="{Binding ProductsText}" AcceptsReturn="True" MinHeight="60" PlaceholderText="1a2b3c4d5e = Sticker pack | https://example.com/stickers.png"
                   ToolTip.Tip="Gives shop items a name (and picture) in %item0%, %item0.image%, alerts and the feed." />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="Membership probably lapsed after (days)" VerticalAlignment="Center" />
            <NumericUpDown Value="{Binding LapseDays}" Minimum="1" Maximum="400" FormatString="0" Width="120"
                           ToolTip.Tip="Ko-fi never says when a membership ends. When a member's last payment is older than this, the Membership Lapsed trigger runs once. It is an estimate." />
          </StackPanel>
          <TextBlock Classes="muted" TextWrapping="Wrap" Text="{Binding Summary}" />
        </StackPanel>
      </Border>

      <Border Classes="card" DataContext="{Binding Patreon}" x:DataType="vm:PatreonOptionsViewModel">
        <StackPanel Spacing="8">
          <TextBlock Classes="h2" Text="Patreon extras" />
          <TextBlock Classes="muted" TextWrapping="Wrap"
                     Text="Optional Patreon API connection. On patreon.com/portal/registration/register-clients create a client for yourself and copy its Client ID, Client Secret, Creator's Access Token and Creator's Refresh Token here. Cuebot then reads your campaign's currency, tiers and patron count, syncs the member list every 6 hours, tells upgrades from downgrades, and can create the webhook for you. Tokens are saved like the other secrets and never written to the log." />
          <Grid ColumnDefinitions="*,8,*" RowDefinitions="Auto,8,Auto">
            <TextBox Text="{Binding ClientId}" PlaceholderText="Client ID" ToolTip.Tip="Your Patreon client's Client ID. Needed to refresh the access token." />
            <TextBox Grid.Column="2" Name="PatreonClientSecret" Text="{Binding ClientSecret}" PasswordChar="•" PlaceholderText="Client Secret" ToolTip.Tip="Your Patreon client's Client Secret. Needed to refresh the access token. Hidden as dots; keep it private." />
            <TextBox Grid.Row="2" Name="PatreonAccessToken" Text="{Binding AccessToken}" PasswordChar="•" PlaceholderText="Creator's Access Token" ToolTip.Tip="The Creator's Access Token of your client. Hidden as dots; keep it private." />
            <TextBox Grid.Row="2" Grid.Column="2" Name="PatreonRefreshToken" Text="{Binding RefreshToken}" PasswordChar="•" PlaceholderText="Creator's Refresh Token" ToolTip.Tip="The Creator's Refresh Token. Cuebot uses it to get a new access token when the old one runs out. Hidden as dots; keep it private." />
          </Grid>
          <TextBlock Classes="muted" TextWrapping="Wrap" Text="{Binding SavedTokens}" />
          <WrapPanel>
            <Button Content="Connect" Classes="accent" Command="{Binding ConnectCommand}" Margin="0,0,8,8" ToolTip.Tip="Reads your campaign, tiers and member list with the token." />
            <Button Content="Sync members" Command="{Binding SyncCommand}" Margin="0,0,8,8" ToolTip.Tip="Reads the member list now (Cuebot also does it every 6 hours)." />
            <Button Content="Create webhook" Command="{Binding CreateWebhookCommand}" Margin="0,0,8,8" ToolTip.Tip="Creates the Patreon webhook for the Cuebot URL shown on the Relay tab, with every member, pledge and post event, and saves its secret above." />
            <Button Content="Check webhook" Command="{Binding CheckWebhookCommand}" Margin="0,0,8,8" ToolTip.Tip="Asks Patreon whether the webhook Cuebot created is working or paused." />
            <Button Content="Resume webhook" Command="{Binding ResumeWebhookCommand}" IsVisible="{Binding CanResume}" Margin="0,0,8,8" ToolTip.Tip="Un-pauses the webhook. Patreon then sends the deliveries it held back; old ones are marked stale." />
            <Button Content="Disconnect" Command="{Binding DisconnectCommand}" Margin="0,0,8,8" ToolTip.Tip="Removes the tokens. Webhooks keep working." />
          </WrapPanel>
          <TextBlock TextWrapping="Wrap" Text="{Binding Status}" />
          <TextBlock Classes="muted" TextWrapping="Wrap" Text="{Binding WebhookHealth}" />
          <Grid ColumnDefinitions="Auto,8,90,24,Auto,8,90">
            <TextBlock Text="Currency when unknown" VerticalAlignment="Center" />
            <TextBox Grid.Column="2" Text="{Binding Currency}" PlaceholderText="USD" ToolTip.Tip="Your campaign's currency, used when neither the delivery nor the API names it. Leave empty to leave it unknown." />
            <TextBlock Grid.Column="4" Text="Stale after (hours)" VerticalAlignment="Center" />
            <NumericUpDown Grid.Column="6" Value="{Binding StaleHours}" Minimum="0" Maximum="720" FormatString="0"
                           ToolTip.Tip="A new pledge that started and was charged longer ago than this is marked stale: it is a backlog Patreon sent after a paused webhook was resumed. Patreon triggers skip stale deliveries unless you untick that. 0 turns this off." />
          </Grid>
          <CheckBox Content="Tag linked viewers as patrons" IsChecked="{Binding LinkViewers}"
                    ToolTip.Tip="When a patron linked Twitch or YouTube on Patreon, Cuebot sets their user variables isPatron, patreonTier, patreonStatus, patreonAmount and patreonSince." />
          <TextBlock Classes="muted" TextWrapping="Wrap" Text="{Binding Info}" />
        </StackPanel>
      </Border>

      <Border Classes="card" DataContext="{Binding Fourthwall}" x:DataType="vm:FourthwallOptionsViewModel">
        <StackPanel Spacing="8">
          <TextBlock Classes="h2" Text="Fourthwall extras" />
          <CheckBox Content="Hide supporter names on stream" IsChecked="{Binding HideSupporterNames}"
                    ToolTip.Tip="Shows &quot;A supporter&quot; instead of the name of anyone who orders, donates, gifts, joins or gets a thank-you (feed, speech, alerts, %user%). %fw.username% keeps the real name for private use." />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="Shop address" VerticalAlignment="Center" />
            <TextBox Text="{Binding ShopAddress}" PlaceholderText="myshop.fourthwall.com" MinWidth="260"
                     ToolTip.Tip="Your shop's web address, for the gift claim links in %fw.giftUrls% (https://&lt;shop&gt;/gifts/&lt;gift id&gt;). Filled in from the API when connected." />
          </StackPanel>
          <TextBlock Classes="muted" TextWrapping="Wrap"
                     Text="Optional Fourthwall Open API connection. In your Fourthwall admin open Settings → For developers → Open API (a SUPER ADMIN can do this), create an API user and copy its user name and password here. Cuebot then knows tier names and members, fills the Products widget from your shop, catches up on events that never arrived, can set up the webhook, mark the shop live while you stream on Twitch and run gift draws from chat. The password is saved like the other secrets and never written to the log." />
          <Grid ColumnDefinitions="*,8,*">
            <TextBox Name="FourthwallApiUser" Text="{Binding ApiUser}" PasswordChar="•" PlaceholderText="API user name" ToolTip.Tip="The Open API user name. Hidden as dots." />
            <TextBox Grid.Column="2" Name="FourthwallApiPassword" Text="{Binding ApiPassword}" PasswordChar="•" PlaceholderText="API password" ToolTip.Tip="The Open API user's password. Hidden as dots; keep it private." />
          </Grid>
          <TextBlock Classes="muted" TextWrapping="Wrap" Text="{Binding SavedCredentials}" />
          <WrapPanel>
            <Button Content="Connect" Classes="accent" Command="{Binding ConnectCommand}" Margin="0,0,8,8" ToolTip.Tip="Reads your shop, tiers, members and products with the API user." />
            <Button Content="Sync members" Command="{Binding SyncCommand}" Margin="0,0,8,8" ToolTip.Tip="Reads the member list now (Cuebot also does it every 6 hours)." />
            <Button Content="Refresh products" Command="{Binding RefreshProductsCommand}" Margin="0,0,8,8" ToolTip.Tip="Reads the products the Products widget shows (also after every product change and every 30 minutes)." />
            <Button Content="Set up webhook" Command="{Binding SetUpWebhookCommand}" Margin="0,0,8,8" ToolTip.Tip="Creates the Fourthwall webhook for the Cuebot URL shown on the Relay tab with every event Cuebot handles, or adds the missing ones. Copy the shop's webhook secret into the card above by hand: the API does not give it." />
            <Button Content="Check webhook" Command="{Binding CheckWebhookCommand}" Margin="0,0,8,8" ToolTip.Tip="Asks Fourthwall which events the webhook sends." />
            <Button Content="Catch up now" Command="{Binding CatchUpCommand}" Margin="0,0,8,8" ToolTip.Tip="Asks Fourthwall which events it sent and replays those that never reached Cuebot." />
            <Button Content="Disconnect" Command="{Binding DisconnectCommand}" Margin="0,0,8,8" ToolTip.Tip="Removes the API user. Webhooks keep working." />
          </WrapPanel>
          <TextBlock TextWrapping="Wrap" Text="{Binding Status}" />
          <TextBlock Classes="muted" TextWrapping="Wrap" Text="{Binding WebhookHealth}" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="Catch up every (minutes)" VerticalAlignment="Center" />
            <NumericUpDown Value="{Binding CatchUpMinutes}" Minimum="0" Maximum="240" FormatString="0" Width="120"
                           ToolTip.Tip="With the API connected, Cuebot checks Fourthwall's event list this often and replays events no delivery brought (marked isReplay). 0 turns this off." />
            <TextBlock Text="Showcase collection" VerticalAlignment="Center" Margin="16,0,0,0" />
            <TextBox Text="{Binding ProductsCollection}" PlaceholderText="every public product" MinWidth="180"
                     ToolTip.Tip="The collection (its slug, from its web address) the Products widget shows. Leave empty for every public product." />
          </StackPanel>
          <CheckBox Content="Tell Fourthwall when I am live on Twitch" IsChecked="{Binding MarkStreamingLive}"
                    ToolTip.Tip="When your Twitch stream goes live or offline, Cuebot sets the shop's streaming status. Viewers can only buy stream gifts while the shop is streaming." />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <CheckBox Content="Run gift draws from Twitch chat with" IsChecked="{Binding RunGiftDraws}"
                      ToolTip.Tip="When a Fourthwall gift draw starts, viewers type the command in Twitch chat until the draw's time is up; Cuebot then hands Fourthwall the entrants and Fourthwall picks the winners. Fourthwall's gifting must be set to Open API." />
            <TextBox Text="{Binding EntryCommand}" Width="120" ToolTip.Tip="What viewers type to enter a gift draw." />
          </StackPanel>
          <TextBlock Classes="error" TextWrapping="Wrap" Text="{Binding GiftingNote}" />
          <TextBlock Classes="muted" TextWrapping="Wrap" Text="{Binding Info}" />
        </StackPanel>
      </Border>

      <Border Classes="card" DataContext="{Binding Custom}" x:DataType="vm:CustomHooksViewModel">
        <StackPanel Spacing="8">
          <TextBlock Classes="h2" Text="Custom webhooks" />
          <TextBlock Classes="muted" TextWrapping="Wrap"
                     Text="Your own hooks for IFTTT, Zapier, scripts or other apps. Another program calls a web address ending in /custom/&lt;name&gt;?token=&lt;token&gt; (or sends the token in an X-Cuebot-Token header). The Custom Webhook trigger then gets the hook name, method, headers, query, body and the body's top-level JSON keys as variables." />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBox Text="{Binding NewName}" PlaceholderText="Hook name, e.g. doorbell" MinWidth="240" ToolTip.Tip="A short name for your hook. It becomes part of the web address that the other program calls." />
            <Button Content="Add hook" Classes="accent" Command="{Binding AddCommand}" ToolTip.Tip="Creates the hook and a secret token for it." />
          </StackPanel>
          <TextBlock Classes="muted" Text="No custom hooks yet." IsVisible="{Binding HasNoHooks}" />
          <ItemsControl ItemsSource="{Binding Hooks}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:CustomHookViewModel">
                <Grid ColumnDefinitions="140,*,Auto" Margin="0,4">
                  <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" />
                  <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock Classes="muted" Text="{Binding MaskedToken}" IsVisible="{Binding !ShowToken}" VerticalAlignment="Center" />
                    <SelectableTextBlock Text="{Binding Token}" IsVisible="{Binding ShowToken}" FontFamily="monospace" VerticalAlignment="Center" />
                    <CheckBox Content="Show" IsChecked="{Binding ShowToken}" ToolTip.Tip="Shows the secret token instead of dots. Do not show it on stream." />
                  </StackPanel>
                  <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
                    <ToggleSwitch IsChecked="{Binding Enabled}" OnContent="On" OffContent="Off" ToolTip.Tip="Switches this hook on or off. When off, calls to it are ignored." />
                    <Button Content="Test" Command="{Binding TestCommand}" ToolTip.Tip="Pretends this hook was called, so you can try your triggers. Nothing leaves your computer." />
                    <Button Content="New token" Command="{Binding RegenerateCommand}" ToolTip.Tip="Makes a new secret token. The old one stops working, so update every program that calls this hook." />
                    <Button Content="Remove" Command="{Binding RemoveCommand}" ToolTip.Tip="Deletes this hook. Programs that call it will stop working." />
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Classes="muted" TextWrapping="Wrap" Text="{Binding LastDelivery}" />
          <TextBlock Classes="muted" TextWrapping="Wrap" Text="{Binding Info}" />
          <TextBlock Classes="error" TextWrapping="Wrap" Text="{Binding Error}" />
        </StackPanel>
      </Border>

      <Border Classes="card">
        <StackPanel Spacing="8">
          <TextBlock Classes="h2" Text="Last events" />
          <TextBlock Classes="muted" Text="No events yet. Send a test event to try your triggers." IsVisible="{Binding HasNoEvents}" />
          <ItemsControl ItemsSource="{Binding RecentEvents}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:WebhookRecordViewModel">
                <Grid ColumnDefinitions="70,140,*,Auto" Margin="0,2">
                  <TextBlock Classes="muted" Text="{Binding Time}" />
                  <TextBlock Grid.Column="1" Text="{Binding Service}" FontWeight="SemiBold" />
                  <TextBlock Grid.Column="2" Text="{Binding Summary}" TextWrapping="Wrap" />
                  <TextBlock Grid.Column="3" Classes="muted" Text="{Binding EventType}" Margin="8,0,0,0" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>

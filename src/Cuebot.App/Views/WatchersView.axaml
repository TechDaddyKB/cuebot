<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Cuebot.App.ViewModels"
             x:Class="Cuebot.App.Views.WatchersView"
             x:DataType="vm:WatchersViewModel"
             x:Name="Root">
  <DockPanel Margin="24,24,24,16">
    <StackPanel DockPanel.Dock="Top">
      <DockPanel Margin="0,0,0,8">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
          <Button Content="+ Folder watcher" Command="{Binding AddFileWatcherCommand}" ToolTip.Tip="Adds a watcher that notices when files in a folder are created, changed, deleted or renamed." />
          <Button Content="+ File tail" Command="{Binding AddFileTailCommand}" ToolTip.Tip="Adds a watcher that reads new lines as they are added to the end of a text file, like a game's log." />
          <Button Content="+ Process watcher" Command="{Binding AddProcessWatcherCommand}" ToolTip.Tip="Adds a watcher that notices when a program on this computer starts or stops." />
        </StackPanel>
        <TextBlock Classes="h1" Text="Watchers" Margin="0" VerticalAlignment="Center" />
      </DockPanel>
      <TextBlock Classes="muted" TextWrapping="Wrap" Margin="0,0,0,8"
                 Text="A watcher keeps an eye on your computer and starts your actions (through triggers) when a file changes, when a new line is added to a file, or when a program starts or stops. Choose the watcher by its name in the trigger's settings. New watchers start switched off: fill them in, then tick Enabled." />
    </StackPanel>

    <TabControl x:Name="Kinds" SelectedIndex="{Binding SelectedTabIndex}">
      <TabItem Header="Folders">
        <ScrollViewer Margin="0,8,0,0">
          <StackPanel MaxWidth="980" HorizontalAlignment="Left">
            <TextBlock Classes="muted" IsVisible="{Binding !FileWatchers.Count}" Margin="0,8"
                       Text="No folder watchers. They fire File created / changed / deleted / renamed." />
            <ItemsControl ItemsSource="{Binding FileWatchers}">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="vm:FileWatcherItemViewModel">
                  <Border Classes="card">
                    <StackPanel Spacing="8">
                      <Grid ColumnDefinitions="*,12,Auto,12,Auto,8,Auto">
                        <TextBox Text="{Binding Name}" PlaceholderText="Name" FontWeight="SemiBold" ToolTip.Tip="The name you pick in the trigger's settings to use this watcher." />
                        <CheckBox Grid.Column="2" Content="Enabled" IsChecked="{Binding Enabled}" ToolTip.Tip="Tick to start watching. Untick to pause it without deleting it." />
                        <Button Grid.Column="4" Content="Duplicate"
                                Command="{Binding DuplicateCommand}" ToolTip.Tip="Makes a copy of this watcher to change." />
                        <Button Grid.Column="6" Content="Remove"
                                Command="{Binding RemoveCommand}" ToolTip.Tip="Deletes this watcher." />
                      </Grid>
                      <Grid ColumnDefinitions="Auto,8,*,8,Auto,12,Auto,8,200">
                        <TextBlock Text="Folder" VerticalAlignment="Center" />
                        <TextBox Grid.Column="2" Text="{Binding Folder}" PlaceholderText="Folder to watch" ToolTip.Tip="The folder on your computer to keep an eye on." />
                        <Button Grid.Column="4" Content="Browse…" Click="OnBrowseFolder" ToolTip.Tip="Opens a window where you pick the folder." />
                        <TextBlock Grid.Column="6" Text="Files" VerticalAlignment="Center" />
                        <TextBox Grid.Column="8" Text="{Binding Filter}" PlaceholderText="*.txt;*.log (empty = all)" ToolTip.Tip="Which files to watch. *.txt means every file ending in .txt. Separate several with a semicolon. Leave empty to watch every file." />
                      </Grid>
                      <WrapPanel ItemSpacing="16" LineSpacing="4">
                        <CheckBox Content="Include subfolders" IsChecked="{Binding IncludeSubfolders}" ToolTip.Tip="Also watches the folders inside this folder." />
                        <TextBlock Text="Fire on:" Classes="muted" VerticalAlignment="Center" FontSize="13" />
                        <CheckBox Content="Created" IsChecked="{Binding Created}" ToolTip.Tip="Run the trigger when a new file appears." />
                        <CheckBox Content="Changed" IsChecked="{Binding Changed}" ToolTip.Tip="Run the trigger when a file is edited or saved." />
                        <CheckBox Content="Deleted" IsChecked="{Binding Deleted}" ToolTip.Tip="Run the trigger when a file is removed." />
                        <CheckBox Content="Renamed" IsChecked="{Binding Renamed}" ToolTip.Tip="Run the trigger when a file gets a new name." />
                      </WrapPanel>
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <Ellipse Classes="status" Classes.good="{Binding IsRunning}" Classes.bad="{Binding IsError}" />
                        <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" TextWrapping="Wrap" />
                      </StackPanel>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="File tails">
        <ScrollViewer Margin="0,8,0,0">
          <StackPanel MaxWidth="980" HorizontalAlignment="Left">
            <TextBlock Classes="muted" IsVisible="{Binding !FileTails.Count}" Margin="0,8"
                       Text="No file tails. A file tail fires 'File tail line' for every line appended to a text file (e.g. a game log)." />
            <ItemsControl ItemsSource="{Binding FileTails}">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="vm:FileTailItemViewModel">
                  <Border Classes="card">
                    <StackPanel Spacing="8">
                      <Grid ColumnDefinitions="*,12,Auto,12,Auto,8,Auto">
                        <TextBox Text="{Binding Name}" PlaceholderText="Name" FontWeight="SemiBold" ToolTip.Tip="The name you pick in the trigger's settings to use this watcher." />
                        <CheckBox Grid.Column="2" Content="Enabled" IsChecked="{Binding Enabled}" ToolTip.Tip="Tick to start watching. Untick to pause it without deleting it." />
                        <Button Grid.Column="4" Content="Duplicate"
                                Command="{Binding DuplicateCommand}" ToolTip.Tip="Makes a copy of this watcher to change." />
                        <Button Grid.Column="6" Content="Remove"
                                Command="{Binding RemoveCommand}" ToolTip.Tip="Deletes this watcher." />
                      </Grid>
                      <Grid ColumnDefinitions="Auto,8,*,8,Auto">
                        <TextBlock Text="File" VerticalAlignment="Center" />
                        <TextBox Grid.Column="2" Text="{Binding FilePath}" PlaceholderText="Text file to follow" ToolTip.Tip="The text file to read new lines from, like a game's log file." />
                        <Button Grid.Column="4" Content="Browse…" Click="OnBrowseFile" ToolTip.Tip="Opens a window where you pick the file." />
                      </Grid>
                      <CheckBox Content="Skip empty lines" IsChecked="{Binding SkipEmptyLines}" ToolTip.Tip="Ignores lines with nothing on them, so the trigger only runs for lines that have text." />
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <Ellipse Classes="status" Classes.good="{Binding IsRunning}" Classes.bad="{Binding IsError}" />
                        <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" TextWrapping="Wrap" />
                      </StackPanel>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="Processes">
        <ScrollViewer Margin="0,8,0,0">
          <StackPanel MaxWidth="980" HorizontalAlignment="Left">
            <TextBlock Classes="muted" IsVisible="{Binding !ProcessWatchers.Count}" Margin="0,8"
                       Text="No process watchers. They fire 'Process started' (first instance) and 'Process stopped' (last instance)." />
            <ItemsControl ItemsSource="{Binding ProcessWatchers}">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="vm:ProcessWatcherItemViewModel">
                  <Border Classes="card">
                    <StackPanel Spacing="8">
                      <Grid ColumnDefinitions="*,12,Auto,12,Auto,8,Auto">
                        <TextBox Text="{Binding Name}" PlaceholderText="Name" FontWeight="SemiBold" ToolTip.Tip="The name you pick in the trigger's settings to use this watcher." />
                        <CheckBox Grid.Column="2" Content="Enabled" IsChecked="{Binding Enabled}" ToolTip.Tip="Tick to start watching. Untick to pause it without deleting it." />
                        <Button Grid.Column="4" Content="Duplicate"
                                Command="{Binding DuplicateCommand}" ToolTip.Tip="Makes a copy of this watcher to change." />
                        <Button Grid.Column="6" Content="Remove"
                                Command="{Binding RemoveCommand}" ToolTip.Tip="Deletes this watcher." />
                      </Grid>
                      <Grid ColumnDefinitions="Auto,8,320,12,*">
                        <TextBlock Text="Process" VerticalAlignment="Center" />
                        <TextBox Grid.Column="2" Text="{Binding ProcessName}" PlaceholderText="e.g. obs64 (with or without .exe)" ToolTip.Tip="The program's file name, as shown in Task Manager, like obs64. You can leave off .exe." />
                        <TextBlock Grid.Column="4" Classes="muted" VerticalAlignment="Center" TextWrapping="Wrap"
                                   Text="Programs already running when Cuebot starts do not fire 'started'." />
                      </Grid>
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <Ellipse Classes="status" Classes.good="{Binding IsRunning}" Classes.bad="{Binding IsError}" />
                        <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" TextWrapping="Wrap" />
                      </StackPanel>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>
  </DockPanel>
</UserControl>

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Cuebot.App.ViewModels"
             xmlns:hvm="using:Cuebot.App.ViewModels.History"
             xmlns:log="using:Cuebot.Core.Logging"
             xmlns:actions="using:Cuebot.Core.Actions"
             xmlns:c="using:Cuebot.App.Controls"
             x:Class="Cuebot.App.Views.DashboardView"
             x:DataType="vm:DashboardViewModel">
  <UserControl.Styles>
    <Style Selector="TextBlock.tileValue">
      <Setter Property="FontSize" Value="24" />
      <Setter Property="FontWeight" Value="Bold" />
    </Style>
    <Style Selector="c|Icon.tileIcon">
      <Setter Property="Width" Value="18" />
      <Setter Property="Height" Value="18" />
      <Setter Property="Foreground" Value="{DynamicResource CuebotAccent}" />
    </Style>
    <Style Selector="c|Icon.tileIcon.bad">
      <Setter Property="Foreground" Value="{DynamicResource CuebotBad}" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,*" Margin="24,16,24,24">
    <!-- ===== Status tiles ===== -->
    <UniformGrid x:Name="Tiles" Columns="4" Margin="0,0,0,12">
      <Border Classes="card" Margin="0,0,12,0">
        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto">
          <TextBlock Classes="label" TextTrimming="CharacterEllipsis" Text="CONNECTED" />
          <c:Icon Grid.Column="1" Classes="tileIcon" Classes.bad="{Binding ConnectionsBad}" Kind="plug" />
          <TextBlock Grid.Row="1" Classes="tileValue" Text="{Binding ConnectedCount}" />
          <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Classes="muted" Text="{Binding ConnectionsDetail}" TextTrimming="CharacterEllipsis" />
        </Grid>
      </Border>
      <Border Classes="card" Margin="0,0,12,0">
        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto">
          <TextBlock Classes="label" TextTrimming="CharacterEllipsis" Text="RUNS TODAY" />
          <c:Icon Grid.Column="1" Classes="tileIcon" Classes.bad="{Binding HasFailures}" Kind="zap" />
          <TextBlock Grid.Row="1" Classes="tileValue" Text="{Binding RunsToday}" />
          <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Classes="muted" Text="{Binding RunsDetail}" TextTrimming="CharacterEllipsis" />
        </Grid>
      </Border>
      <Border Classes="card" Margin="0,0,12,0">
        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto">
          <TextBlock Classes="label" TextTrimming="CharacterEllipsis" Text="EVENTS TODAY" />
          <c:Icon Grid.Column="1" Classes="tileIcon" Kind="radio" />
          <TextBlock Grid.Row="1" Classes="tileValue" Text="{Binding EventsToday}" />
          <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Classes="muted" Text="{Binding EventsDetail}" TextTrimming="CharacterEllipsis" />
        </Grid>
      </Border>
      <Border Classes="card" Margin="0">
        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto">
          <TextBlock Classes="label" TextTrimming="CharacterEllipsis" Text="PROBLEMS" />
          <c:Icon Grid.Column="1" Classes="tileIcon" Classes.bad="{Binding HasErrors}" Kind="triangle-alert" />
          <TextBlock Grid.Row="1" Classes="tileValue" Text="{Binding ProblemCount}" />
          <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Classes="muted" Text="{Binding ProblemsDetail}" TextTrimming="CharacterEllipsis" />
        </Grid>
      </Border>
    </UniformGrid>

    <Grid Grid.Row="1" ColumnDefinitions="3*,12,2*">
      <!-- ===== Activity: events and the log ===== -->
      <Border Classes="card" Margin="0" Padding="12,8,12,12">
        <TabControl x:Name="Activity">
          <TabItem Header="Events">
            <Panel>
              <ListBox x:Name="EventFeed" ItemsSource="{Binding Events}" Background="Transparent">
                <ListBox.ItemTemplate>
                  <DataTemplate DataType="hvm:TriggerEventRow">
                    <Grid ColumnDefinitions="Auto,*" Margin="0,2">
                      <TextBlock Classes="muted" Text="{Binding Time}" FontSize="11.5" Width="86" VerticalAlignment="Top" Margin="0,2,0,0" />
                      <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Classes="muted" Text="{Binding Preview}" FontSize="12" TextTrimming="CharacterEllipsis" />
                      </StackPanel>
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              <StackPanel IsVisible="{Binding !HasEvents}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6">
                <c:Icon Kind="radio" Width="28" Height="28" Foreground="{DynamicResource CuebotMuted}" HorizontalAlignment="Center" />
                <TextBlock Classes="muted" Text="Events show up here as they happen: chat, follows, scenes, hotkeys…" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="320" />
              </StackPanel>
            </Panel>
          </TabItem>
          <TabItem Header="Log">
            <DockPanel>
              <Button DockPanel.Dock="Top" HorizontalAlignment="Right" Content="Clear" Command="{Binding ClearLogCommand}" Margin="0,0,0,6" />
              <ListBox ItemsSource="{Binding Log}" Background="Transparent" AutoScrollToSelectedItem="False">
                <ListBox.ItemTemplate>
                  <DataTemplate DataType="log:LogEntry">
                    <TextBlock Text="{Binding}" FontFamily="Cascadia Mono,Consolas,DejaVu Sans Mono,monospace" FontSize="12" TextWrapping="Wrap" />
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </DockPanel>
          </TabItem>
        </TabControl>
      </Border>

      <Grid Grid.Column="2" RowDefinitions="Auto,12,*">
        <!-- ===== Quick actions ===== -->
        <Border Classes="card" Margin="0">
          <StackPanel Spacing="8">
            <TextBlock Classes="h2" Text="Quick actions" Margin="0" />
            <TextBlock Classes="muted" Text="Actions you run show up here, to run again with one click." TextWrapping="Wrap"
                       IsVisible="{Binding !HasQuickActions}" />
            <ItemsControl x:Name="QuickActionList" ItemsSource="{Binding QuickActions}">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="vm:QuickActionViewModel">
                  <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,2">
                    <Ellipse Classes="status" Classes.good="{Binding Succeeded}" Classes.bad="{Binding !Succeeded}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <StackPanel Grid.Column="1">
                      <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                      <TextBlock Classes="muted" Text="{Binding LastRun}" FontSize="11.5" />
                    </StackPanel>
                    <Button Grid.Column="2" Command="{Binding RunCommand}" ToolTip.Tip="Run again" Padding="8,4"
                            AutomationProperties.Name="{Binding Name, StringFormat='Run {0} again'}">
                      <StackPanel Orientation="Horizontal" Spacing="4">
                        <c:Icon Kind="play" Width="13" Height="13" />
                        <TextBlock Text="Run" />
                      </StackPanel>
                    </Button>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

        <!-- ===== What ran, and every connection (the top bar shows only the ones in use) ===== -->
        <Border Grid.Row="2" Classes="card" Margin="0" Padding="12,8,12,12">
          <TabControl x:Name="SideTabs">
            <TabItem Header="Runs">
              <Panel>
                <ListBox ItemsSource="{Binding Runs}" Background="Transparent">
                  <ListBox.ItemTemplate>
                    <DataTemplate DataType="actions:ActionRunRecord">
                      <StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                          <Ellipse Classes="status" Classes.good="{Binding Success}" Classes.bad="{Binding !Success}" Width="8" Height="8" />
                          <TextBlock Text="{Binding ActionName}" FontWeight="SemiBold" />
                        </StackPanel>
                        <TextBlock Classes="muted" Text="{Binding Source}" />
                        <TextBlock Classes="error" Text="{Binding Error}" IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}" FontSize="12" />
                      </StackPanel>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock Classes="muted" Text="No actions have run yet." IsVisible="{Binding !HasRuns}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Panel>
            </TabItem>
            <TabItem Header="Connections">
              <ScrollViewer>
                <ItemsControl x:Name="ConnectionList" ItemsSource="{Binding Connections}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="vm:ConnectionStatusViewModel">
                      <Border Width="170" Margin="0,0,8,8" Padding="8,5" CornerRadius="6"
                              Background="{DynamicResource CuebotRaised}" ToolTip.Tip="{Binding Message}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <Ellipse Classes="status" Classes.good="{Binding IsConnected}" Classes.bad="{Binding IsError}" VerticalAlignment="Center" />
                          <StackPanel>
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12.5" TextTrimming="CharacterEllipsis" MaxWidth="130" />
                            <TextBlock Text="{Binding State}" Classes="muted" FontSize="11" />
                          </StackPanel>
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </TabItem>
          </TabControl>
        </Border>
      </Grid>
    </Grid>
  </Grid>
</UserControl>

    <ProjectReference Include="..\Cuebot.StreamApps\Cuebot.StreamApps.csproj" />
    <ProjectReference Include="..\Cuebot.Elgato\Cuebot.Elgato.csproj" />
    <ProjectReference Include="..\Cuebot.StreamDeck\Cuebot.StreamDeck.csproj" />

    <ProjectReference Include="..\Cuebot.YouTube\Cuebot.YouTube.csproj" />
    <ProjectReference Include="..\Cuebot.Kick\Cuebot.Kick.csproj" />
    <ProjectReference Include="..\Cuebot.Donations\Cuebot.Donations.csproj" />

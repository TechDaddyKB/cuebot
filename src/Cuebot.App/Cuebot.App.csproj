<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>Cuebot</AssemblyName>
    <RootNamespace>Cuebot.App</RootNamespace>
    <ApplicationIcon>Assets\cuebot.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>
  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Wayland" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="Avalonia.AvaloniaEdit" />
    <PackageReference Include="AvaloniaEdit.TextMate" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Cuebot.Core\Cuebot.Core.csproj" />
    <ProjectReference Include="..\Cuebot.Twitch\Cuebot.Twitch.csproj" />
    <ProjectReference Include="..\Cuebot.Obs\Cuebot.Obs.csproj" />
    <ProjectReference Include="..\Cuebot.Speech\Cuebot.Speech.csproj" />
    <ProjectReference Include="..\Cuebot.Scripting\Cuebot.Scripting.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Cuebot.UiTests" />
  </ItemGroup>
</Project>

  "header": {
    "name": "RahiTuber examples",
    "author": "Cuebot",
    "description": "Three RahiTuber actions: the Twitch reward \"Surprise\" presses the state Surprised; a new sub holds the \"while held\" state Hat for 30 seconds; the chat command !outfit (30 s cooldown) presses the states Jacket and Scarf one after the other. Change the reward, command and state names to your own.",
    "bundleVersion": "1",
    "createdAt": "2026-11-11T00:00:00+00:00",
    "generator": "Cuebot"
  },
  "actions": [
    {

      "name": "RahiTuber: surprised face on redeem",
      "group": "RahiTuber",
      "enabled": true,
      "triggers": [
        {
          "id": "7c3e2a41-9b0d-4c6e-8f1a-2d5b6e7f8a02",
          "type": "twitch.rewardRedemption",
          "enabled": true,
          "settings": { "rewardTitle": "Surprise" }
        }
      ],
      "subActions": [
        {
          "id": "7c3e2a41-9b0d-4c6e-8f1a-2d5b6e7f8a03",
          "type": "rahituber.state",
          "enabled": true,
          "parameters": { "state": "Surprised", "how": "Press" }
        }
      ]
    },
    {
      "id": "7c3e2a41-9b0d-4c6e-8f1a-2d5b6e7f8a04",

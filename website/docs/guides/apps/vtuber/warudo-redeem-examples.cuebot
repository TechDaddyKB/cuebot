  "header": {
    "name": "Warudo redeems",
    "author": "Cuebot",
    "description": "Two Twitch channel point rewards for Warudo. \"Throw\" sends the viewer's name to the On Stream Deck Message node with Receiver Name Throw; \"Water\" starts the On Stream Deck Trigger node with Receiver Name Water. Change the reward titles to match your rewards.",
    "bundleVersion": "1",

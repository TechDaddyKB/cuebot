<Project>
  <!--
    Whisper.net's runtime packages copy whisper.cpp for every platform into runtimes/<platform>/ (and runtimes/noavx/...).
    A RID-specific publish only needs its own, so the other platforms' folders are removed (about 20 MB). Only folders
    holding a whisper.cpp (ggml-whisper) library are touched; other packages' runtimes/ folders are left alone.
  -->
  <Target Name="CuebotPruneForeignWhisperRuntimes" AfterTargets="Publish"
          Condition="'$(RuntimeIdentifier)' != '' and Exists('$(PublishDir)runtimes')">
    <ItemGroup>
      <_CuebotRuntimeDir Include="$([System.IO.Directory]::GetDirectories('$(PublishDir)runtimes'))" />
      <_CuebotRuntimeDir Include="$([System.IO.Directory]::GetDirectories('$(PublishDir)runtimes/noavx'))"
                         Condition="Exists('$(PublishDir)runtimes/noavx')" />
      <_CuebotForeignWhisperDir Include="@(_CuebotRuntimeDir)"
                                Condition="'%(Filename)%(Extension)' != '$(RuntimeIdentifier)' and (Exists('%(Identity)/ggml-whisper.dll') or Exists('%(Identity)/libggml-whisper.so') or Exists('%(Identity)/libggml-whisper.dylib'))" />
    </ItemGroup>
    <RemoveDir Directories="@(_CuebotForeignWhisperDir)" />
    <Delete Files="$(PublishDir)ggml-metal.metal" Condition="!$(RuntimeIdentifier.StartsWith('osx'))" />
  </Target>
  <!--
    A build without a RuntimeIdentifier copies every package's native libraries for every platform into
    bin/.../runtimes/ (Linux, Android, iOS frameworks and more). On Windows those deep folders push paths over the
    260-character limit when the clone itself sits in a long folder, and Windows can only load its own anyway, so a
    Windows build keeps runtimes/win* only. CuebotLocalRuntimeFamily picks the family kept (empty keeps everything).
  -->
  <PropertyGroup>
    <CuebotLocalRuntimeFamily Condition="'$(CuebotLocalRuntimeFamily)' == '' and '$(OS)' == 'Windows_NT'">win</CuebotLocalRuntimeFamily>
  </PropertyGroup>
  <Target Name="CuebotDropForeignRuntimes" AfterTargets="ResolvePackageAssets"
          Condition="'$(RuntimeIdentifier)' == '' and '$(CuebotLocalRuntimeFamily)' != ''">
    <ItemGroup>
      <_CuebotForeignRuntime Include="@(RuntimeTargetsCopyLocalItems)"
                             Condition="$([System.String]::Copy('%(DestinationSubDirectory)').Replace('\','/').StartsWith('runtimes/')) and !$([System.String]::Copy('%(DestinationSubDirectory)').Replace('\','/').StartsWith('runtimes/$(CuebotLocalRuntimeFamily)'))" />
      <RuntimeTargetsCopyLocalItems Remove="@(_CuebotForeignRuntime)" />
    </ItemGroup>
  </Target>
</Project>

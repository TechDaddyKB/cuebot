{
  "name": "cuebot-relay",
  "version": "0.1.0",
  "private": true,
  "description": "Cuebot webhook relay: a Cloudflare Worker that forwards webhooks to Cuebot over an outbound WebSocket.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "deploy": "wrangler deploy",
    "dev": "wrangler dev",
    "test": "tsc --noEmit && vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.4.9",
    "@cloudflare/workers-types": "^5.20261027.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.12",
    "wrangler": "4.154.0"
  },
  "allowScripts": {
    "workerd@1.20261023.1": true,
    "esbuild@0.28.2": true
  }
}
